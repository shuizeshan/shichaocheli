<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>尸潮撤离 · DEAD EXTRACTION</title>
<style>
*{box-sizing:border-box;margin:0;padding:0}
html,body{width:100%;height:100%;overflow:hidden;background:#080a07;color:#e4e8dd;
  font-family:"Microsoft YaHei","Segoe UI",sans-serif;user-select:none}
canvas#cv{position:absolute;inset:0;width:100%;height:100%;display:block;cursor:crosshair}
.hide{display:none!important}
#hud{position:absolute;inset:0;pointer-events:none;font-size:13px;text-shadow:0 1px 3px #000}
#hudStats{position:absolute;left:18px;top:16px;width:216px;display:flex;flex-direction:column;gap:6px}
.stat{display:flex;align-items:center;gap:7px}
.stat b{width:32px;font-weight:400;color:#9fae96;font-size:11px}
.track{flex:1;height:9px;background:#171c15;border:1px solid #2c3328;border-radius:2px;overflow:hidden}
.track i{display:block;height:100%;width:100%;transition:width .1s linear}
#vHp{background:linear-gradient(90deg,#8b2f2f,#d94a4a)}
#vStam{background:linear-gradient(90deg,#6a6a20,#c9c94a)}
#vHun{background:linear-gradient(90deg,#6b4a1e,#d9a04a)}
#vThi{background:linear-gradient(90deg,#1e4a6b,#4aa0d9)}
#vInf{background:linear-gradient(90deg,#3f6b1e,#8bd94a)}
.stat span{width:34px;text-align:right;font-size:11px;color:#8d9a84}
#hudTop{position:absolute;right:18px;top:206px;text-align:right;font-size:12px;color:#b9c6ac;line-height:1.7}
#hudObjective{color:#dfe8cd;border-right:2px solid #7a9a4a;padding-right:8px;max-width:min(520px,42vw);line-height:1.6}
#hudLog{position:absolute;left:18px;bottom:158px;width:330px;max-height:216px;overflow:hidden;display:flex;flex-direction:column;gap:3px;
  font-size:12px;color:#a9b7a0}
#hudLog div{opacity:.9}
#hudBottom{position:absolute;right:18px;bottom:18px;text-align:right}
#hudWeapon{font-size:13px;color:#c8d4bb;letter-spacing:1px}
#hudAmmo{font-size:26px;color:#f0e2b8;letter-spacing:2px;margin-top:2px}
#hudAmmo small{font-size:13px;color:#8d9a84}
#hudBag{display:inline-flex;align-items:center;gap:7px;margin-top:9px;padding:7px 11px;font-family:inherit;
  font-size:12px;letter-spacing:1px;color:#dfe8cd;background:#141a12e6;border:1px solid #46543a;border-radius:4px;cursor:pointer}
#hudBag:hover{background:#212b1c;border-color:#7a9a4a;color:#fff}
#hudBag b{font-weight:600;color:#f0e2b8}
#hudBag em{font-style:normal;font-size:10px;color:#8ea07c;border:1px solid #46543a;border-radius:3px;padding:0 4px}
#hudBag.warn{border-color:#a8763c;color:#e8c48a}
#hudBag.full{border-color:#a8563c;color:#e89a8a}
#hudBag .met{color:#9fb08f}
#hudSlots{position:absolute;left:50%;bottom:16px;transform:translateX(-50%);display:flex;gap:8px}
.slot{width:58px;height:52px;background:#12160fcc;border:1px solid #2f382a;border-radius:3px;
  display:flex;flex-direction:column;align-items:center;justify-content:center;font-size:10px;color:#93a18a}
.slot b{font-size:15px;color:#e2d9b4;font-weight:500}
.slot .k{font-size:9px;color:#6d7a64}
#hudTip{max-width:min(620px,72vw);text-align:center;line-height:1.55;position:absolute;left:50%;bottom:88px;transform:translateX(-50%);font-size:13px;color:#e7f0d6;
  background:#0d1109cc;border:1px solid #3c4a32;border-radius:3px;padding:6px 14px;opacity:0;transition:opacity .15s}
#hudTip.on{opacity:1}
#screen{position:absolute;inset:0;z-index:30;display:flex;align-items:center;justify-content:center;
  background:radial-gradient(circle at 50% 35%,#151a10 0%,#060805 72%);overflow:auto;padding:20px}
.panel{width:min(1120px,96vw);max-height:94vh;overflow:auto;background:linear-gradient(180deg,rgba(23,27,21,.97),rgba(11,14,10,.99));
  border:1px solid #33402f;border-radius:6px;padding:22px 26px;box-shadow:0 24px 70px #000b}
h1.title{font-size:29px;letter-spacing:8px;font-weight:600;color:#dfe6d2}
.sub{color:#7f8c72;font-size:11px;letter-spacing:4px;margin-top:6px;text-transform:uppercase}
.row{display:flex;gap:10px;flex-wrap:wrap;align-items:center}
.btn{pointer-events:auto;cursor:pointer;background:#1b221a;border:1px solid #3a4635;color:#cdd6c2;
  padding:9px 16px;border-radius:3px;font-size:13px;font-family:inherit;transition:.15s;letter-spacing:1px}
.btn:hover{background:#28331f;border-color:#7a9a4a;color:#eaf2de}
.btn:disabled{opacity:.32;cursor:not-allowed}
.btn.primary{background:#3d5721;border-color:#7a9a4a;color:#eaf3d8}
.btn.danger{background:#3a1a1a;border-color:#7a3a3a;color:#f0d0d0}
.grid{display:grid;gap:10px}
.g3{grid-template-columns:repeat(3,1fr)}
.g2{grid-template-columns:repeat(2,1fr)}
.card{background:#12160f;border:1px solid #2b3428;border-radius:4px;padding:12px 14px}
.card h3{font-size:13px;margin-bottom:7px;color:#cfe0bb;font-weight:500;letter-spacing:1px}
.muted{color:#7c8a72;font-size:12px;line-height:1.7}
.tag{display:inline-block;background:#20281c;border:1px solid #38452f;color:#9fb58c;font-size:11px;
  padding:1px 6px;border-radius:2px;margin:0 5px 4px 0}
hr.sep{border:0;border-top:1px solid #242c1f;margin:14px 0}
table{width:100%;border-collapse:collapse;font-size:12px}
td,th{padding:5px 6px;border-bottom:1px solid #20261a;text-align:left;vertical-align:middle}
th{color:#8b9a7f;font-weight:400;font-size:11px}
.center{text-align:center}
#minimap{position:absolute;right:18px;top:16px;width:176px;height:176px;image-rendering:pixelated;
  border:1px solid #2f3a2c;border-radius:4px;background:#080b07cc;box-shadow:0 6px 20px #0009}
#minimap.enter{border-color:#7a9a4a;box-shadow:0 0 0 1px #7a9a4a55,0 6px 20px #0009}
</style>
</head>
<body>
<canvas id="cv"></canvas>

<div id="hud" class="hide">
  <div id="hudStats">
    <div class="stat"><b>生命</b><div class="track"><i id="vHp"></i></div><span id="tHp">100</span></div>
    <div class="stat"><b>体力</b><div class="track"><i id="vStam"></i></div><span id="tStam">100</span></div>
    <div class="stat"><b>饥饿</b><div class="track"><i id="vHun"></i></div><span id="tHun">100</span></div>
    <div class="stat"><b>口渴</b><div class="track"><i id="vThi"></i></div><span id="tThi">100</span></div>
    <div class="stat"><b>感染</b><div class="track"><i id="vInf"></i></div><span id="tInf">0</span></div>
  </div>
  <div id="hudTop">
    <div id="hudObjective">目标</div>
    <div id="hudTime"></div>
  </div>
  <div id="hudLog"></div>
  <div id="hudBottom">
    <div id="hudWeapon">—</div>
    <div id="hudAmmo">0<small>/0</small></div>
    <button id="hudBag" data-act="bag" title="查看背包 (B)">背包 <em>B</em> <span class="met" id="hudBagMet">负重 0.0/32 · 空余 12 格</span></button>
  </div>
  <canvas id="minimap" width="176" height="176"></canvas>
  <div id="hudSlots"></div>
  <div id="hudTip"></div>
</div>

<div id="screen"></div>

<script>
(function () {
'use strict';
/* =========================================================
   PART 1 —— 数据层：常量 / 物品 / 武器 / 丧尸 / 地图 / 配方
   ========================================================= */

var TILE = 40, MAPW = 100, MAPH = 100;

function rnd(a, b) { return a + Math.random() * (b - a); }
function rndInt(a, b) { return Math.floor(a + Math.random() * (b - a + 1)); }
function pick(a) { return a[Math.floor(Math.random() * a.length)]; }
function clamp(v, a, b) { return v < a ? a : (v > b ? b : v); }
function dist2(ax, ay, bx, by) { var dx = ax - bx, dy = ay - by; return dx * dx + dy * dy; }
function dist(ax, ay, bx, by) { return Math.sqrt(dist2(ax, ay, bx, by)); }
function lerp(a, b, t) { return a + (b - a) * t; }
function angDiff(a, b) { var d = (a - b) % (Math.PI * 2); if (d > Math.PI) d -= Math.PI * 2; if (d < -Math.PI) d += Math.PI * 2; return d; }
function fmt(n) { return (Math.round(n * 10) / 10).toString(); }

/* ---------- 物品表 ---------- */
var ITEMS = {
  scrap:  { n: '废金属',   w: 0.6, t: 'mat', c: '#9aa4ad', d: '通用建材，营地升级的主力' },
  wood:   { n: '木材',     w: 0.8, t: 'mat', c: '#a1743f', d: '拆家具得来的木料' },
  cloth:  { n: '布料',     w: 0.2, t: 'mat', c: '#cfc3a8', d: '绷带与护具的原料' },
  chem:   { n: '化学品',   w: 0.4, t: 'mat', c: '#7fd3a1', d: '火药与药剂的基础' },
  elec:   { n: '电子元件', w: 0.3, t: 'mat', c: '#7fb6ff', d: '营地电力的关键零件' },
  fuel:   { n: '燃料',     w: 1.2, t: 'mat', c: '#e0a34a', d: '发电机与燃烧瓶使用' },
  tool:   { n: '工具包',   w: 1.5, t: 'mat', c: '#b0b0b0', d: '高级制作的必需工具' },
  bandage:{ n: '绷带',     w: 0.2, t: 'med', c: '#f0f0f0', heal: 18,  d: '止血，回复 18 生命' },
  medkit: { n: '急救包',   w: 0.7, t: 'med', c: '#ff6b6b', heal: 55,  d: '回复 55 生命' },
  anti:   { n: '抗生素',   w: 0.2, t: 'med', c: '#8be38b', inf: -35,  d: '降低 35 点感染' },
  serum:  { n: '抗病毒血清', w: 0.3, t: 'med', c: '#66e0ff', inf: -100, d: '清除全部感染' },
  food:   { n: '压缩饼干', w: 0.4, t: 'food', c: '#e8c46a', hunger: 35, d: '回复 35 饥饿' },
  water:  { n: '净水',     w: 0.6, t: 'food', c: '#79c8ff', thirst: 45, d: '回复 45 口渴' },
  ammo9:  { n: '9mm 弹药', w: 0.1, t: 'ammo', c: '#ffd76a', d: '手枪弹' },
  ammo12: { n: '12号霰弹', w: 0.14, t: 'ammo', c: '#ff9a5c', d: '霰弹枪弹' },
  ammo762:{ n: '7.62 弹药', w: 0.14, t: 'ammo', c: '#ff7a7a', d: '步枪弹' },
  crowbar:{ n: '撬棍',     w: 1.5, t: 'weapon', c: '#c9c9c9', wk: 'crowbar', d: '可靠的近战武器，也能撬门' },
  axe:    { n: '消防斧',   w: 2.0, t: 'weapon', c: '#e6a35c', wk: 'axe',     d: '劈砍伤害极高，体力消耗大' },
  pistol: { n: 'M1911 手枪', w: 1.0, t: 'weapon', c: '#d8d8d8', wk: 'pistol', d: '精度好、噪音中等' },
  shotgun:{ n: '双管霰弹枪', w: 2.6, t: 'weapon', c: '#c4a06a', wk: 'shotgun', d: '近距离清场，噪音极大' },
  rifle:  { n: 'AKM 步枪',  w: 3.2, t: 'weapon', c: '#b98a5a', wk: 'rifle',   d: '火力压制，弹药稀缺' },
  vest:   { n: '防弹背心', w: 3.0, t: 'armor', c: '#5f7d5f', armor: 35, d: '减伤 35%，受击损耗' },
  helmet: { n: '防暴头盔', w: 1.5, t: 'armor', c: '#6a7a8a', armor: 15, d: '减伤 15%' },
  note1:  { n: '幸存者日志·一', w: 0.1, t: 'note', c: '#c9b27a', d: '一份被血浸透的记录' },
  note2:  { n: '幸存者日志·二', w: 0.1, t: 'note', c: '#c9b27a', d: '字迹潦草' },
  note3:  { n: '幸存者日志·三', w: 0.1, t: 'note', c: '#c9b27a', d: '夹在病历中' },
  note4:  { n: '军方电文·四',   w: 0.1, t: 'note', c: '#c9b27a', d: '带加密编号' },
  note5:  { n: '军方电文·五',   w: 0.1, t: 'note', c: '#c9b27a', d: '纸张发黄' },
  note6:  { n: '撤离指令·六',   w: 0.1, t: 'note', c: '#c9b27a', d: '封蜡印记完整' },
  keycard:{ n: '军事基地门卡', w: 0.1, t: 'key',  c: '#ff8a3d', d: '进入军事基地的凭证' }
};

var NOTES = {
  note1: { title: '日志·一：第三天', body: '第三天。广播说这是“狂犬病变异株”，说军队已经在城外建立隔离线。\n我数了下楼下的尸体，十一个。它们夜里不动，白天成群。\n我把门窗全部钉死，学会了一件事：不要开枪。声音会把整条街的它们引过来。' },
  note2: { title: '日志·二：第十九天', body: '第十九天。邻居家的人全变成了它们，只剩小女孩还在窗边。\n我试着用撬棍，比枪好使——安静，而且不会打光弹药。\n他们说城北有撤离点，绿色信号灯。我打算去试试。' },
  note3: { title: '日志·三：医院', body: '医院早就完了。药房被抢空，只剩几箱抗生素。\n我在这里被咬了。伤口边缘发黑，但还没蔓延。医生留下的笔记写着：\n“感染不是立刻的，体温先升高，然后是听觉敏感。血清只能延缓，无法逆转。”' },
  note4: { title: '军方电文·四', body: '第 7 号隔离区失守。重复，第 7 号隔离区失守。\n所有平民撤离通道关闭，仅保留军事基地东侧跑道。\n任何未持门卡者禁止进入。必要时可执行净化程序。' },
  note5: { title: '军方电文·五', body: '代号“灰烬”。样本并非自然变异，第 3 实验室泄露记录被销毁。\n基地内部出现二次感染，指挥链中断。\n如有人读到此处：跑道仍在，油料足够，但基地里已经没有活人了。' },
  note6: { title: '撤离指令·六', body: '最后一架运输机将于黎明起飞。\n携带完整实验记录者可获得登机资格——这是交换，不是救援。\n如果你能走到这里，说明你已经比我们所有人都强。别回头。' }
};

/* ---------- 物品估值（结算与战报用） ---------- */
var ITEM_VALUE = {
  ammo: 6, mat: 14, med: 34, food: 12, weapon: 260, armor: 190, note: 0, key: 0
};
function itemValue(id) {
  var it = ITEMS[id];
  if (!it) return 0;
  var v = ITEM_VALUE[it.t];
  if (v === undefined) v = 10;
  if (it.t === 'weapon' && it.wk === 'crowbar') v = 60;
  if (it.t === 'weapon' && it.wk === 'pistol') v = 220;
  if (it.t === 'med') v = it.heal ? 20 + it.heal : 34;
  return v;
}

/* ---------- 武器表 ---------- */
var WEAPONS = {
  crowbar: { n: '撬棍', melee: true, dmg: 26, rate: 0.45, range: 54, arc: 1.5, stam: 6, noise: 60, kb: 60 },
  axe:     { n: '消防斧', melee: true, dmg: 52, rate: 0.78, range: 60, arc: 1.55, stam: 13, noise: 70, kb: 110 },
  pistol:  { n: 'M1911', dmg: 29, rate: 0.2, mag: 8, spread: 0.045, ammo: 'ammo9', reload: 1.5, noise: 300, speed: 1500, pellets: 1, stam: 0, recoil: 0.035 },
  shotgun: { n: '双管霰弹枪', dmg: 15, rate: 0.72, mag: 2, spread: 0.13, ammo: 'ammo12', reload: 2.2, noise: 400, speed: 1250, pellets: 8, stam: 0, recoil: 0.09 },
  rifle:   { n: 'AKM', dmg: 37, rate: 0.115, mag: 30, spread: 0.072, ammo: 'ammo762', reload: 2.6, noise: 420, speed: 1750, pellets: 1, stam: 0, recoil: 0.05 }
};

/* ---------- 丧尸表 ---------- */
var ZT = {
  walker: { n: '行尸',   hp: 72,  spd: 52, dmg: 10, atk: 0.95, vision: 360, hear: 360, r: 13, c: '#6d8a5e', xp: 5,  armor: 0 },
  brute:  { n: '暴君',   hp: 240, spd: 58, dmg: 27, atk: 1.35, vision: 400, hear: 360, r: 19, c: '#8a4a4a', xp: 28, armor: 0.35 },
  /* 新增四类：爬行 / 犬型 / 缓慢 / 疾跑 —— 血量、伤害、速度各异 */
  runner: { n: '跑步丧尸', hp: 50,  spd: 122, dmg: 11, atk: 0.68, vision: 440, hear: 420, r: 12, c: '#a0633f', xp: 9,  armor: 0 },
  crawler:{ n: '爬行丧尸', hp: 40,  spd: 34,  dmg: 7,  atk: 1.05, vision: 250, hear: 300, r: 10, c: '#8a7a4e', xp: 4,  armor: 0 },
  dog:    { n: '僵尸犬',   hp: 34,  spd: 172, dmg: 9,  atk: 0.52, vision: 470, hear: 470, r: 10, c: '#9a6a34', xp: 11, armor: 0 },
  slow:   { n: '缓慢丧尸', hp: 152, spd: 26,  dmg: 18, atk: 1.45, vision: 300, hear: 320, r: 15, c: '#556a52', xp: 12, armor: 0.15 }
};

/* ---------- 地图配置 ---------- */
var MAPS = {
  suburb: {
    id: 'suburb', n: '郊区住宅', d: '低风险区域。丧尸稀疏，民用物资为主。',
    zmin: 16, zmax: 22, runner: 0.14, brute: 0.02, loot: 1, exits: 2, risk: '低',
    containers: 26, noteMax: 2, timeLimit: 300,
    ztype: { walker: 0.44, runner: 0.14, crawler: 0.20, dog: 0.09, slow: 0.10, brute: 0.03 },
    btype: { home: 0.55, store: 0.25, school: 0.08, fire: 0.06, police: 0.04, hospital: 0.02 }
  },
  city: {
    id: 'city', n: '商业区', d: '丧尸密度中等。货架与仓储物资丰富，噪音会引来成群的它们。',
    zmin: 22, zmax: 30, runner: 0.26, brute: 0.06, loot: 1.35, exits: 2, risk: '中',
    containers: 34, noteMax: 3, timeLimit: 360,
    ztype: { walker: 0.30, runner: 0.24, crawler: 0.16, dog: 0.14, slow: 0.10, brute: 0.06 },
    btype: { store: 0.34, home: 0.28, hospital: 0.10, police: 0.10, fire: 0.08, school: 0.10 }
  },
  hospital: {
    id: 'hospital', n: '市立医院', d: '药品充足，但走廊狭窄。疾行者比例极高。',
    zmin: 26, zmax: 34, runner: 0.42, brute: 0.08, loot: 1.5, exits: 2, risk: '高',
    containers: 32, noteMax: 3, medBonus: true, timeLimit: 390,
    ztype: { walker: 0.24, runner: 0.30, crawler: 0.16, dog: 0.12, slow: 0.10, brute: 0.08 },
    btype: { hospital: 0.50, home: 0.18, store: 0.16, police: 0.06, fire: 0.06, school: 0.04 }
  },
  military: {
    id: 'military', n: '军事基地', d: '只有一条撤离通道。暴君成群，军械与血清在此。',
    zmin: 30, zmax: 40, runner: 0.32, brute: 0.24, loot: 2.0, exits: 1, risk: '极高',
    containers: 34, noteMax: 2, timeLimit: 420,
    ztype: { walker: 0.22, runner: 0.28, crawler: 0.10, dog: 0.12, slow: 0.04, brute: 0.24 },
    btype: { store: 0.32, police: 0.22, fire: 0.16, hospital: 0.14, school: 0.08, home: 0.08 }
  }
};

/* ---------- 制作配方 ---------- */
var RECIPES = [
  { out: 'bandage', qty: 2, cost: { cloth: 2 }, bench: 1, n: '绷带 x2' },
  { out: 'water',   qty: 2, cost: { fuel: 1 },  bench: 1, n: '净水 x2' },
  { out: 'medkit',  qty: 1, cost: { cloth: 3, chem: 2 }, bench: 2, n: '急救包 x1' },
  { out: 'anti',    qty: 1, cost: { chem: 3 },      bench: 2, n: '抗生素 x1' },
  { out: 'ammo9',   qty: 12, cost: { scrap: 2, chem: 1 }, bench: 1, n: '9mm x12' },
  { out: 'ammo12',  qty: 6,  cost: { scrap: 2, chem: 2 }, bench: 2, n: '12号霰弹 x6' },
  { out: 'vest',    qty: 1,  cost: { cloth: 6, scrap: 4 }, bench: 2, n: '防弹背心 x1' },
  { out: 'ammo762', qty: 10, cost: { scrap: 3, chem: 2 }, bench: 3, n: '7.62 x10' },
  { out: 'serum',   qty: 1,  cost: { chem: 4, elec: 2 }, bench: 3, n: '抗病毒血清 x1' },
  { out: 'rifle',   qty: 1,  cost: { scrap: 12, wood: 6, tool: 1 }, bench: 3, n: 'AKM x1' }
];

