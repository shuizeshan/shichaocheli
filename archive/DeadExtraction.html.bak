];

/* ---------- 战利品池 ---------- */
var LOOT_COMMON = ['scrap', 'cloth', 'wood', 'food', 'ammo9', 'bandage'];
var LOOT_UNCOMMON = ['chem', 'elec', 'medkit', 'ammo12', 'water', 'tool'];
var LOOT_RARE = ['rifle', 'vest', 'serum', 'anti', 'helmet', 'ammo762'];

function stashWeight(b) {
  b = b || G.base;
  var src = (b && b.stash) ? b.stash : (b || {});
  var w = 0;
  for (var k in src) {
    var it = ITEMS[k];
    if (it && src[k] > 0) w += (typeof it.w === 'number' ? it.w : 1) * src[k];
  }
  return w;
}

/* =========================================================
   PART 2 —— 状态 / 背包 / 地图生成 / 流场寻路 / 视线
   ========================================================= */

var G = { base: null, raid: null, screen: 'menu', tick: 0 };

function newBase() {
  return {
    day: 1, version: 1,
    bench: 1, defense: 0, purifier: false, medbay: false,
    stash: { crowbar: 1, pistol: 1, ammo9: 24, bandage: 4, food: 2, water: 2, scrap: 10, wood: 8, cloth: 6 },
    loadout: { gun: 'pistol', melee: 'crowbar', armor: null },
    skills: { vitality: 0, aim: 0, survival: 0, medic: 0, melee: 0 },
    sp: 0, xp: 0, totalKills: 0, raids: 0, extracts: 0, deaths: 0,
    notes: [], keycard: false, militaryUnlocked: false, ending: false,
    /* —— v1.1 扩展 —— */
    ver: 3, settings: null, safehouse: {}, damaged: {}, best: 0,
    lastReport: '', tutorial: {}, bloodPending: 0, slot: 0
  };
}

function skillBonus(k) { return G.base ? (G.base.skills[k] || 0) : 0; }

/* ---------- 背包 ---------- */
var BAG_MAXW = 32;   /* 背包负重硬上限 */
function bagWeight(bag) {
  var w = 0;
  for (var i = 0; i < bag.slots.length; i++) {
    var s = bag.slots[i]; if (s && ITEMS[s.id]) w += ITEMS[s.id].w * s.qty;
  }
  return w;
}
function bagAdd(bag, id, qty) {
  if (!ITEMS[id] || qty <= 0) return 0;
  var uw = ITEMS[id].w || 0, curW = bagWeight(bag);
  if (uw > 0 && curW >= BAG_MAXW) return 0;   /* 负重硬上限：塞不下更多 */
  var want = qty;
  if (uw > 0) {
    /* 逐件校验：一批物资也不能把负重撞过上限 */
    var room = Math.floor((BAG_MAXW - curW) / uw + 1e-9);
    if (room < 0) room = 0;
    if (want > room) want = room;
  }
  if (want <= 0) return 0;
  var left = want, maxStack = ITEMS[id].t === 'ammo' ? 90 : (ITEMS[id].t === 'mat' ? 20 : 8);
  for (var i = 0; i < bag.slots.length && left > 0; i++) {
    var s = bag.slots[i];
    if (s && s.id === id && s.qty < maxStack) {
      var add = Math.min(maxStack - s.qty, left);
      s.qty += add; left -= add;
    }
  }
  for (var j = 0; j < bag.slots.length && left > 0; j++) {
    if (!bag.slots[j]) {
      var add2 = Math.min(maxStack, left);
      bag.slots[j] = { id: id, qty: add2 }; left -= add2;
    }
  }
  return want - left;
}
function bagCount(bag, id) {
  var n = 0;
  for (var i = 0; i < bag.slots.length; i++) { var s = bag.slots[i]; if (s && s.id === id) n += s.qty; }
  return n;
}
function bagRemove(bag, id, qty) {
  var left = qty;
  for (var i = 0; i < bag.slots.length && left > 0; i++) {
    var s = bag.slots[i];
    if (s && s.id === id) {
      var take = Math.min(s.qty, left);
      s.qty -= take; left -= take;
      if (s.qty <= 0) bag.slots[i] = null;
    }
  }
  return qty - left;
}
function bagFree(bag) { var n = 0; for (var i = 0; i < bag.slots.length; i++) if (!bag.slots[i]) n++; return n; }

/* ---------- 地图工具 ---------- */
function inMap(x, y) { return x >= 0 && y >= 0 && x < MAPW && y < MAPH; }
function reachMap(m, sx, sy) {
  var vis = new Uint8Array(MAPW * MAPH);
  if (tget(m, sx, sy) !== 1) return vis;
  var q = [sx + sy * MAPW], head = 0;
  vis[q[0]] = 1;
  while (head < q.length) {
    var id = q[head++], x = id % MAPW, y = (id - x) / MAPW;
    for (var k = 0; k < 4; k++) {
      var nx = x + (k === 0 ? 1 : k === 1 ? -1 : 0), ny = y + (k === 2 ? 1 : k === 3 ? -1 : 0);
      if (nx < 0 || ny < 0 || nx >= MAPW || ny >= MAPH) continue;
      var nid = nx + ny * MAPW;
      if (vis[nid] || tget(m, nx, ny) !== 1) continue;
      vis[nid] = 1; q.push(nid);
    }
  }
  return vis;
}
function tget(m, x, y) { if (x < 0 || y < 0 || x >= MAPW || y >= MAPH) return 2; return m.tiles[y * MAPW + x]; }
function tset(m, x, y, v) { if (x >= 0 && y >= 0 && x < MAPW && y < MAPH) m.tiles[y * MAPW + x] = v; }
function isWallTile(m, tx, ty) { return tget(m, tx, ty) === 2; }
function isWallAt(m, x, y) { return isWallTile(m, Math.floor(x / TILE), Math.floor(y / TILE)); }
function blockCircle(m, x, y, r) {
  var x0 = Math.floor((x - r) / TILE), x1 = Math.floor((x + r) / TILE);
  var y0 = Math.floor((y - r) / TILE), y1 = Math.floor((y + r) / TILE);
  for (var ty = y0; ty <= y1; ty++) for (var tx = x0; tx <= x1; tx++) {
    if (!isWallTile(m, tx, ty)) continue;
    var cx = clamp(x, tx * TILE, tx * TILE + TILE), cy = clamp(y, ty * TILE, ty * TILE + TILE);
    if (dist2(x, y, cx, cy) < r * r) return true;
  }
  return false;
}
function moveEnt(m, e, dx, dy) {
  if (dx) { var nx = e.x + dx; if (!blockCircle(m, nx, e.y, e.r)) e.x = nx; else e.x = e.x; }
  if (dy) { var ny = e.y + dy; if (!blockCircle(m, e.x, ny, e.r)) e.y = ny; }
  e.x = clamp(e.x, e.r, MAPW * TILE - e.r);
  e.y = clamp(e.y, e.r, MAPH * TILE - e.r);
}
function losClear(m, x1, y1, x2, y2) {
  var d = dist(x1, y1, x2, y2);
  if (d < 1) return true;
  var steps = Math.ceil(d / 18);
  for (var i = 1; i < steps; i++) {
    var t = i / steps;
    if (isWallAt(m, lerp(x1, x2, t), lerp(y1, y2, t))) return false;
  }
  return true;
}

/* ---------- 地图生成 ---------- */
/* ---------- 建筑类型表：不同建筑 = 不同标志 + 不同内部格局 ---------- */
var BLD = {
  hospital: { n: '市立医院', c: '#79b6c4', ic: 'cross',  tag: '医', box: ['medbox', 'medbox', 'cabinet', 'crate'] },
  police:   { n: '警察局',   c: '#5f7fc4', ic: 'shield', tag: '警', box: ['cabinet', 'cabinet', 'toolbox', 'crate'] },
  fire:     { n: '消防局',   c: '#c45a44', ic: 'flame',  tag: '消', box: ['toolbox', 'crate', 'cabinet', 'fridge'] },
  home:     { n: '居民楼',   c: '#5f9450', ic: 'window', tag: '居', box: ['cabinet', 'fridge', 'crate', 'cabinet'] },
  school:   { n: '校园',     c: '#c2a83c', ic: 'book',   tag: '学', box: ['cabinet', 'crate', 'toolbox', 'cabinet'] },
  store:    { n: '仓储',     c: '#8f8855', ic: 'crate',  tag: '仓', box: ['crate', 'cabinet', 'toolbox', 'fridge', 'cabinet'] }
};

/* 画围合房间：矩形边界为墙，内部保持地板，door 为靠走廊一侧的门 */
function bWall(m, x1, y1, x2, y2) {
  var x, y;
  if (x2 - x1 < 2 || y2 - y1 < 2) return false;
  for (x = x1; x <= x2; x++) { tset(m, x, y1, 2); tset(m, x, y2, 2); }
  for (y = y1; y <= y2; y++) { tset(m, x1, y, 2); tset(m, x2, y, 2); }
  return true;
}

function bDoor(m, x, y) {
  if (x < 0 || y < 0 || x >= MAPW || y >= MAPH) return;
  tset(m, x, y, 3);
}

/* 返回可开在外墙上的门位置（走廊端点），供 addBuilding 打通出入口 */
function layoutBuilding(m, tp, x, y, w, h) {
  var x1 = x + 1, y1 = y + 1, x2 = x + w - 2, y2 = y + h - 2;
  var iw = w - 2, ih = h - 2, doors = [], i, cx, cy, mid;

  if (iw < 5 || ih < 5) return doors;

  if (tp === 'hospital') {
    /* 十字走廊 + 四角病房 */
    cx = x1 + Math.floor(iw / 2); cy = y1 + Math.floor(ih / 2);
    var qs = [
      [x1, y1, cx - 1, cy - 1, 'r'], [cx + 1, y1, x2, cy - 1, 'l'],
      [x1, cy + 1, cx - 1, y2, 'r'], [cx + 1, cy + 1, x2, y2, 'l']
    ];
    for (i = 0; i < qs.length; i++) {
      var a = qs[i];
      if (!bWall(m, a[0], a[1], a[2], a[3])) continue;
      mid = a[1] + Math.floor((a[3] - a[1]) / 2);
      bDoor(m, a[4] === 'r' ? a[2] : a[0], mid);
    }
    doors.push({ x: cx, y: y }, { x: cx, y: y + h - 1 }, { x: x, y: cy }, { x: x + w - 1, y: cy });

  } else if (tp === 'police') {
    /* 办公前厅 + 后方拘留室（3 间铁栅小间） */
    cx = x1 + Math.floor(iw * 0.42);
    var jy = y1, guard = 0;
    while (jy + 2 <= y2 && guard++ < 8) {
      var jy2 = Math.min(jy + 2, y2);
      if (!bWall(m, cx + 1, jy, x2, jy2)) break;
      bDoor(m, cx + 1, jy + Math.floor((jy2 - jy) / 2));
      if (jy2 >= y2) break;
      jy = jy2;
    }
    /* 左侧前厅分两间 */
    if (cx - 1 - x1 >= 3) {
      mid = y1 + Math.floor(ih / 2);
      if (bWall(m, x1, y1, cx - 1, mid - 1)) bDoor(m, cx - 1, y1 + Math.floor((mid - 1 - y1) / 2));
      if (bWall(m, x1, mid + 1, cx - 1, y2)) bDoor(m, cx - 1, mid + 1 + Math.floor((y2 - mid - 1) / 2));
    }
    doors.push({ x: cx, y: y }, { x: cx, y: y + h - 1 });

  } else if (tp === 'fire') {
    /* 大车库：开阔空间 + 承重柱 + 后部器材间 */
    if (iw >= 7) { tset(m, x1 + Math.floor(iw / 3), y1 + Math.floor(ih / 3), 2); tset(m, x1 + Math.floor(iw * 2 / 3), y1 + Math.floor(ih / 3), 2); }
    if (ih >= 8) {
      var sy2 = y1 + 2;
      if (bWall(m, x1, y1, x2, sy2)) {
        mid = x1 + Math.floor(iw / 2);
        bDoor(m, mid, sy2);
        bDoor(m, Math.min(mid + 2, x2 - 1), sy2);
      }
    }
    doors.push({ x: x1 + Math.floor(iw / 3), y: y + h - 1 }, { x: x1 + Math.floor(iw * 2 / 3), y: y + h - 1 });

  } else if (tp === 'home') {
    /* 中央走廊 + 4 户公寓 */
    cx = x1 + Math.floor(iw / 2); cy = y1 + Math.floor(ih / 2);
    var hs = [
      [x1, y1, cx - 1, cy - 1, 'r'], [cx + 1, y1, x2, cy - 1, 'l'],
      [x1, cy + 1, cx - 1, y2, 'r'], [cx + 1, cy + 1, x2, y2, 'l']
    ];
    for (i = 0; i < hs.length; i++) {
      var b = hs[i];
      if (!bWall(m, b[0], b[1], b[2], b[3])) continue;
      mid = b[1] + Math.floor((b[3] - b[1]) / 2);
      bDoor(m, b[4] === 'r' ? b[2] : b[0], mid);
    }
    doors.push({ x: cx, y: y }, { x: cx, y: y + h - 1 });

  } else if (tp === 'school') {
    /* 长走廊 + 上下各两间教室 */
    cy = y1 + Math.floor(ih / 2); cx = x1 + Math.floor(iw / 2);
    var cs = [
      [x1, y1, cx - 1, cy - 1, 'b'], [cx + 1, y1, x2, cy - 1, 'b'],
      [x1, cy + 1, cx - 1, y2, 't'], [cx + 1, cy + 1, x2, y2, 't']
    ];
    for (i = 0; i < cs.length; i++) {
      var c = cs[i];
      if (!bWall(m, c[0], c[1], c[2], c[3])) continue;
      mid = c[0] + Math.floor((c[2] - c[0]) / 2);
      bDoor(m, mid, c[4] === 'b' ? c[3] : c[1]);
    }
    doors.push({ x: x, y: cy }, { x: x + w - 1, y: cy });

  } else {
    /* 仓储：保留随机隔断的建筑感 */
    if (iw >= 7 && ih >= 7 && Math.random() < 0.7) {
      var cutY = y1 + rndInt(2, ih - 3);
      var gapX = x1 + rndInt(1, iw - 2);
      for (i = x1; i <= x2; i++) { if (Math.abs(i - gapX) <= 1) continue; tset(m, i, cutY, 2); }
      if (Math.random() < 0.5 && iw >= 9 && ih >= 9) {
        var cutX = x1 + rndInt(2, iw - 3);
        var gapY = y1 + rndInt(1, ih - 2);
        var j;
        for (j = y1; j <= y2; j++) { if (Math.abs(j - gapY) <= 1) continue; tset(m, cutX, j, 2); }
      }
    }
    doors.push({ x: x + rndInt(1, w - 2), y: y + h - 1 }, { x: x + w - 1, y: y + rndInt(1, h - 2) });
  }
  return doors;
}

/* 在建筑外墙上开门，并向内打通 2 格，保证从门外能走进内部 */
function cutDoor(m, dr, x, y, w, h) {
  if (dr.x < 0 || dr.y < 0 || dr.x >= MAPW || dr.y >= MAPH) return;
  tset(m, dr.x, dr.y, 3);
  var k, nx, ny;
  var dirx = 0, diry = 0;
  if (dr.y <= y) diry = 1;
  else if (dr.y >= y + h - 1) diry = -1;
  if (dr.x <= x) dirx = 1;
  else if (dr.x >= x + w - 1) dirx = -1;
  if (!dirx && !diry) diry = 1;
  /* 角落门只沿一个轴打通，避免斜穿墙体打出缺口 */
  if (dirx !== 0 && diry !== 0) { if (w >= h) diry = 0; else dirx = 0; }

  /* 门洞加宽为 2 格：单格 40px 对圆形碰撞体容错仅 ±8px，玩家极易卡在门柱上进不去 */
  var ex = dr.x, ey = dr.y;
  if (diry !== 0) {
    var ax = dr.x + 1;
    if (ax > x + w - 2) ax = dr.x - 1;
    if (ax >= x + 1 && ax <= x + w - 2 && tget(m, ax, dr.y) === 2) { tset(m, ax, dr.y, 3); ex = ax; }
  } else {
    var ay = dr.y + 1;
    if (ay > y + h - 2) ay = dr.y - 1;
    if (ay >= y + 1 && ay <= y + h - 2 && tget(m, dr.x, ay) === 2) { tset(m, dr.x, ay, 3); ey = ay; }
  }
  dr.dir = { x: dirx, y: diry };
  dr.span = (diry !== 0)
    ? { x1: Math.min(dr.x, ex), x2: Math.max(dr.x, ex), y1: dr.y, y2: dr.y }
    : { x1: dr.x, x2: dr.x, y1: Math.min(dr.y, ey), y2: Math.max(dr.y, ey) };

  var cells = [[dr.x, dr.y], [ex, ey]];
  for (var ci = 0; ci < 2; ci++) {
    for (k = 1; k <= 6; k++) {
      nx = cells[ci][0] + (dirx ? dirx * k : 0);
      ny = cells[ci][1] + (diry ? diry * k : 0);
      if (nx < 0 || ny < 0 || nx >= MAPW || ny >= MAPH) break;
      var tv = tget(m, nx, ny);
      if (tv === 2) { tset(m, nx, ny, 4); continue; }   /* 外墙与内部隔墙都打通，保证门后必达 */
      if (k >= 2) break;                                /* 已到地板/门格，停止 */
    }
  }
  /* 兜底：门后若被内部隔墙挡成死路，按最短路径拆墙，保证门一定能走到建筑内部 */
  if (!doorPathOk(m, dr, x, y, w, h)) carveToCenter(m, dr, x, y, w, h);
  return dr;
}

/* 圆角矩形路径：屋顶用圆角弱化“纯方框”观感 */
function roundPath(ctx, x, y, w, h, r) {
  r = Math.min(r, w / 2, h / 2);
  ctx.moveTo(x + r, y);
  ctx.lineTo(x + w - r, y); ctx.quadraticCurveTo(x + w, y, x + w, y + r);
  ctx.lineTo(x + w, y + h - r); ctx.quadraticCurveTo(x + w, y + h, x + w - r, y + h);
  ctx.lineTo(x + r, y + h); ctx.quadraticCurveTo(x, y + h, x, y + h - r);
  ctx.lineTo(x, y + r); ctx.quadraticCurveTo(x, y, x + r, y);
  ctx.closePath();
}

/* 从门格到建筑中心找最短路径（允许拆墙），把路径上的墙打通 */
function carveToCenter(m, dr, x, y, w, h) {
  var gx = x + (w >> 1), gy = y + (h >> 1);
  var prev = {}, q = [[dr.x, dr.y]], dxs = [1, -1, 0, 0], dys = [0, 0, 1, -1];
  prev[dr.y * MAPW + dr.x] = -1;
  while (q.length) {
    var cur = q.shift();
    if (cur[0] === gx && cur[1] === gy) {
      var k2 = gy * MAPW + gx;
      while (k2 !== -1 && k2 !== undefined) {
        var px2 = k2 % MAPW, py2 = (k2 - px2) / MAPW;
        if (tget(m, px2, py2) === 2) tset(m, px2, py2, 4);
        k2 = prev[k2];
      }
      return true;
    }
    for (var d4 = 0; d4 < 4; d4++) {
      var nx = cur[0] + dxs[d4], ny = cur[1] + dys[d4];
      if (nx < x || nx > x + w - 1 || ny < y || ny > y + h - 1) continue;
      var key = ny * MAPW + nx;
      if (key in prev) continue;
      prev[key] = cur[1] * MAPW + cur[0];
      q.push([nx, ny]);
    }
  }
  return false;
}

/* 门格能否走到建筑内部中心（只在建筑矩形内 BFS，成本极低） */
function doorPathOk(m, dr, x, y, w, h) {
  var gx = x + (w >> 1), gy = y + (h >> 1);
  if (gx === dr.x && gy === dr.y) return true;
  var seen = {}, q = [[dr.x, dr.y]], dxs = [1, -1, 0, 0], dys = [0, 0, 1, -1];
  seen[dr.y * MAPW + dr.x] = 1;
  while (q.length) {
    var cur = q.shift();
    for (var d4 = 0; d4 < 4; d4++) {
      var nx = cur[0] + dxs[d4], ny = cur[1] + dys[d4];
      if (nx < x || nx > x + w - 1 || ny < y || ny > y + h - 1) continue;
      var key = ny * MAPW + nx;
      if (seen[key]) continue;
      if (tget(m, nx, ny) === 2) continue;
      if (nx === gx && ny === gy) return true;
      seen[key] = 1;
      q.push([nx, ny]);
    }
  }
  return false;
}

/* 门口吸附：玩家靠近门洞时沿墙方向微调对准，彻底避免卡在门柱上 */
function doorAssist(dt) {
  var raid = G.raid, p = raid && raid.p, m = raid && raid.map;
  if (!p || !m || !m.buildings) return;
  var best = null, bestD = 1e9, bestCx = 0, bestCy = 0, bestHoriz = true;
  for (var i = 0; i < m.buildings.length; i++) {
    var b = m.buildings[i];
    if (!b.doors) continue;
    for (var d = 0; d < b.doors.length; d++) {
      var dr = b.doors[d];
      if (tget(m, dr.x, dr.y) !== 3) continue;
      var sp = dr.span || { x1: dr.x, x2: dr.x, y1: dr.y, y2: dr.y };
      var cx = (sp.x1 + sp.x2 + 1) / 2 * TILE, cy = (sp.y1 + sp.y2 + 1) / 2 * TILE;
      var dd = Math.hypot(p.x - cx, p.y - cy);
      /* 门在上下墙 → 门洞横向展开，只需横向对准；在左右墙 → 纵向对准 */
      var horiz = dr.dir ? (dr.dir.y !== 0) : (sp.x1 !== sp.x2);
      if (dd < bestD) { bestD = dd; best = dr; bestCx = cx; bestCy = cy; bestHoriz = horiz; }
    }
  }
  if (!best || bestD > 52) return;
  var pull = Math.min(1, dt * 9);
  if (bestHoriz) p.x += (bestCx - p.x) * pull;
  else p.y += (bestCy - p.y) * pull;
}

function addBuilding(m, x, y, w, h, cfg, btype) {
  if (w < 5 || h < 5) return null;
  if (x < 1 || y < 1 || x + w >= MAPW - 1 || y + h >= MAPH - 1) return null;
  /* 与已有建筑保持 1 格间距，避免互相覆盖墙体堵死门与内部通路 */
  var ocu_i, ocu_j, ocu_t;
  for (ocu_j = y - 1; ocu_j <= y + h; ocu_j++) {
    for (ocu_i = x - 1; ocu_i <= x + w; ocu_i++) {
      ocu_t = tget(m, ocu_i, ocu_j);
      if (ocu_t === 2 || ocu_t === 3 || ocu_t === 4) return null;
    }
  }

  if (w < 5 || h < 5) return null;
  if (x + w >= MAPW - 1 || y + h >= MAPH - 1) return null;
  var i, j;
  for (i = 0; i < w; i++) { tset(m, x + i, y, 2); tset(m, x + i, y + h - 1, 2); }
  for (j = 0; j < h; j++) { tset(m, x, y + j, 2); tset(m, x + w - 1, y + j, 2); }
  for (j = 1; j < h - 1; j++) for (i = 1; i < w - 1; i++) tset(m, x + i, y + j, 4);

  var tp = BLD[btype] ? btype : 'store';
  var doors = layoutBuilding(m, tp, x, y, w, h);
  if (!doors.length) {
    /* 兜底：随机外墙开门，保证能进 */
    var side = rndInt(0, 3), dx, dy;
    if (side === 0) { dx = x + rndInt(1, w - 2); dy = y; }
    else if (side === 1) { dx = x + rndInt(1, w - 2); dy = y + h - 1; }
    else if (side === 2) { dx = x; dy = y + rndInt(1, h - 2); }
    else { dx = x + w - 1; dy = y + rndInt(1, h - 2); }
    doors = [{ x: dx, y: dy }];
  }
  var openN = Math.min(doors.length, (w >= 11 && Math.random() < 0.4) ? 2 : 1);
  for (var d = 0; d < openN; d++) {
    cutDoor(m, doors[d], x, y, w, h);
  }

  var room = { x: x, y: y, w: w, h: h, type: tp, name: BLD[tp].n, visited: false, doors: doors.slice(0, openN) };
  m.rooms.push(room);
  if (!m.buildings) m.buildings = [];
  m.buildings.push(room);

  /* 容器：按建筑类型的战利品配比 */
  var pool = BLD[tp].box;
  var cnum = rndInt(2, 3);
  for (var c = 0; c < cnum; c++) {
    var cx = x + rndInt(1, w - 2), cy = y + rndInt(1, h - 2);
    if (tget(m, cx, cy) !== 4) continue;
    var okPos = true;
    for (var k = 0; k < m.containers.length; k++) {
      if (m.containers[k].tx === cx && m.containers[k].ty === cy) { okPos = false; break; }
    }
    if (!okPos) continue;
    var type = (cfg.medBonus && tp === 'hospital' && Math.random() < 0.45) ? 'medbox' : pick(pool);
    m.containers.push({
      tx: cx, ty: cy, x: cx * TILE + TILE / 2, y: cy * TILE + TILE / 2,
      type: type, searched: false, prog: 0,
      loot: rollLoot(type, cfg)
    });
  }
  return room;
}

function rollLoot(type, cfg) {
  var out = [], n = rndInt(1, 3);
  var mul = cfg.loot || 1;
  for (var i = 0; i < n; i++) {
    var r = Math.random();
    var id;
    if (type === 'medbox') id = r < 0.5 ? pick(['bandage', 'medkit', 'anti']) : (r < 0.85 ? 'chem' : 'serum');
    else if (type === 'toolbox') id = r < 0.45 ? pick(['scrap', 'scrap', 'tool']) : (r < 0.8 ? pick(['elec', 'wood']) : 'ammo12');
    else if (type === 'fridge') id = r < 0.55 ? 'food' : (r < 0.85 ? 'water' : 'chem');
    else if (type === 'crate') id = r < 0.38 ? pick(['ammo9', 'ammo12', 'ammo762']) : (r < 0.72 ? pick(['scrap', 'cloth', 'wood']) : (r < 0.86 ? 'fuel' : 'bandage'));
    else id = r < 0.44 ? pick(['scrap', 'cloth']) : (r < 0.72 ? 'food' : (r < 0.88 ? 'ammo9' : pick(['bandage', 'medkit'])));

    var qty = 1;
    var it = ITEMS[id];
    if (it && it.t === 'ammo') qty = Math.round(rndInt(4, 15) * mul);
    else if (it && it.t === 'mat') qty = Math.round(rndInt(1, 3) * mul);
    else if (it && (it.t === 'med' || it.t === 'food')) qty = Math.random() < 0.45 ? 2 : 1;
    if (it && it.t === 'weapon' && Math.random() > 0.35 * (cfg.loot / 2)) { qty = 0; }
    if (qty > 0) out.push({ id: id, qty: qty });
  }
  return out;
}

/* ---------- 关键物品定向注入 ----------
   门卡与六份档案必须可在正常流程中获得，否则军事基地 / 结局永不可达 */
var NOTE_BY_MAP = {
  suburb: ['note1', 'note2'],
  city: ['note3', 'note4'],
  hospital: ['note4'],
  military: ['note5', 'note6']
};
function injectKeyItems(m, cfg) {
  var b = G.base || {};
  var cs = m.containers;
  if (!cs || !cs.length) return 0;

  /* ① 每张图至少 2 个医疗箱，保证基础医疗产出 */
  var meds = 0, i;
  for (i = 0; i < cs.length; i++) if (cs[i].type === 'medbox') meds++;
  for (i = 0; i < cs.length && meds < 2; i++) {
    if (cs[i].type !== 'medbox') {
      cs[i].type = 'medbox';
      cs[i].loot = rollLoot('medbox', cfg);
      meds++;
    }
  }

  /* ② 待注入的剧情物品 */
  var need = [];
  var pool = NOTE_BY_MAP[cfg.id] || [];
  for (i = 0; i < pool.length; i++) {
    if (!b.notes || b.notes.indexOf(pool[i]) < 0) need.push(pool[i]);
  }
  if (!b.militaryUnlocked && cfg.id === 'hospital') need.push('keycard');
  if (!need.length) return 0;

  /* ③ 打进未被占用的容器，避免全部挤在同一个箱子 */
  var used = {}, placed = 0;
  for (i = 0; i < need.length; i++) {
    var ok = false;
    for (var tryN = 0; tryN < 60 && !ok; tryN++) {
      var idx = rndInt(0, cs.length - 1);
      if (used[idx]) continue;
      used[idx] = true;
      cs[idx].loot = cs[idx].loot || [];
      cs[idx].loot.push({ id: need[i], qty: 1 });
      if (need[i] === 'keycard') cs[idx].type = 'cabinet';
      ok = true; placed++;
    }
  }
  return placed;
}

function genMap(cfg) {
  var m = { cfg: cfg, tiles: new Uint8Array(MAPW * MAPH), containers: [], exits: [], rooms: [], buildings: [], seen: new Uint8Array(MAPW * MAPH), spawn: { x: 0, y: 0 }, zones: [] };
  var x, y, i, j;
  m.tiles.fill(2);
  for (y = 1; y < MAPH - 1; y++) for (x = 1; x < MAPW - 1; x++) m.tiles[y * MAPW + x] = 0;

  var B = 17, RD = 3;
  for (var gy = 0; gy * B < MAPH; gy++) {
    var ry = gy * B;
    for (y = ry; y < ry + RD && y < MAPH - 1; y++) for (x = 1; x < MAPW - 1; x++) tset(m, x, y, 1);
  }
  for (var gx = 0; gx * B < MAPW; gx++) {
    var rx = gx * B;
    for (x = rx; x < rx + RD && x < MAPW - 1; x++) for (y = 1; y < MAPH - 1; y++) tset(m, x, y, 1);
  }

  for (var by = 0; by * B < MAPH; by++) {
    for (var bx = 0; bx * B < MAPW; bx++) {
      var x0 = bx * B + RD, y0 = by * B + RD;
      var w = Math.min(B - RD - 1, MAPW - 1 - x0), h = Math.min(B - RD - 1, MAPH - 1 - y0);
      if (w < 6 || h < 6) continue;
      if (Math.random() < 0.14) continue;
      if (w >= 12 && h >= 8 && Math.random() < 0.55) {
        addBuilding(m, x0 + rndInt(0, 1), y0 + rndInt(0, 1), rndInt(6, 7), rndInt(6, 7), cfg, pickBType(cfg));
        addBuilding(m, x0 + w - rndInt(6, 8), y0 + rndInt(0, 2), rndInt(6, 8), rndInt(6, 8), cfg, pickBType(cfg));
      } else {
        addBuilding(m, x0 + rndInt(0, 1), y0 + rndInt(0, 1), Math.min(w - 1, rndInt(6, 9)), Math.min(h - 1, rndInt(6, 9)), cfg, pickBType(cfg));
      }
    }
  }

  /* 补充容器到目标数量 */
  var guard = 0;
  while (m.containers.length < cfg.containers && guard++ < 900) {
    if (!m.rooms.length) break;
    var rm = pick(m.rooms);
    var cx = rm.x + rndInt(1, rm.w - 2), cy = rm.y + rndInt(1, rm.h - 2);
    if (tget(m, cx, cy) !== 4) continue;
    var dup = false;
    for (var k = 0; k < m.containers.length; k++) if (m.containers[k].tx === cx && m.containers[k].ty === cy) dup = true;
    if (dup) continue;
    var tp = pick(['cabinet', 'crate', 'toolbox', 'fridge', 'medbox']);
    m.containers.push({
      tx: cx, ty: cy, x: cx * TILE + TILE / 2, y: cy * TILE + TILE / 2,
      type: tp, searched: false, prog: 0, loot: rollLoot(tp, cfg)
    });
  }

  /* 出生点：道路上、尽量远离边角 */
  for (i = 0; i < 800; i++) {
    var sx = rndInt(4, MAPW - 5), sy = rndInt(4, MAPH - 5);
    if (tget(m, sx, sy) === 1) { m.spawn = { x: sx * TILE + TILE / 2, y: sy * TILE + TILE / 2 }; break; }
  }
  if (!m.spawn.x) m.spawn = { x: Math.floor(MAPW / 2) * TILE, y: Math.floor(MAPH / 2) * TILE };

  /* 可达性校验：清理落在墙内或封闭区域的容器，并在可达室内补足 */
  var reach = new Uint8Array(MAPW * MAPH);
  var sTx = clamp(Math.floor(m.spawn.x / TILE), 0, MAPW - 1), sTy = clamp(Math.floor(m.spawn.y / TILE), 0, MAPH - 1);
  var rr = [sTy * MAPW + sTx];
  reach[rr[0]] = 1;
  for (var hd = 0; hd < rr.length; hd++) {
    var idx0 = rr[hd], cx0 = idx0 % MAPW, cy0 = (idx0 - cx0) / MAPW;
    for (var k4 = 0; k4 < 4; k4++) {
      var nx4 = cx0 + (k4 === 0 ? 1 : k4 === 1 ? -1 : 0);
      var ny4 = cy0 + (k4 === 2 ? 1 : k4 === 3 ? -1 : 0);
      if (nx4 < 0 || ny4 < 0 || nx4 >= MAPW || ny4 >= MAPH) continue;
      var nidx4 = ny4 * MAPW + nx4;
      if (reach[nidx4]) continue;
      if (m.tiles[nidx4] === 2) continue;
      reach[nidx4] = 1; rr.push(nidx4);
    }
  }
  var kept = [];
  for (i = 0; i < m.containers.length; i++) {
    var ct = m.containers[i];
    if (tget(m, ct.tx, ct.ty) !== 4) continue;
    if (!reach[ct.ty * MAPW + ct.tx]) continue;
    kept.push(ct);
  }
  m.containers = kept;
  var guard2 = 0;
  while (m.containers.length < cfg.containers && guard2++ < 6000) {
    var px2 = rndInt(1, MAPW - 2), py2 = rndInt(1, MAPH - 2);
    if (tget(m, px2, py2) !== 4) continue;
    if (!reach[py2 * MAPW + px2]) continue;
    var dup2 = false;
    for (var q2 = 0; q2 < m.containers.length; q2++) if (m.containers[q2].tx === px2 && m.containers[q2].ty === py2) { dup2 = true; break; }
    if (dup2) continue;
    var tp2;
    if (cfg.medBonus && Math.random() < 0.4) tp2 = 'medbox';
    else tp2 = pick(['cabinet', 'crate', 'toolbox', 'fridge', 'cabinet']);
    m.containers.push({
      tx: px2, ty: py2, x: px2 * TILE + TILE / 2, y: py2 * TILE + TILE / 2,
      type: tp2, searched: false, prog: 0, loot: rollLoot(tp2, cfg)
    });
  }

  /* 撤离点 */
  var reach = reachMap(m, Math.floor(m.spawn.x / TILE), Math.floor(m.spawn.y / TILE));
  var tries = 0;
  while (m.exits.length < cfg.exits && tries++ < 3000) {
    var ex = rndInt(4, MAPW - 5), ey = rndInt(4, MAPH - 5);
    if (tget(m, ex, ey) !== 1) continue;
    if (!reach[ex + ey * MAPW]) continue;
    var px = ex * TILE + TILE / 2, py = ey * TILE + TILE / 2;
    if (dist(px, py, m.spawn.x, m.spawn.y) < 1100) continue;
    var tooClose = false;
    for (i = 0; i < m.exits.length; i++) if (dist(px, py, m.exits[i].x, m.exits[i].y) < 900) tooClose = true;
    if (tooClose) continue;
    m.exits.push({ x: px, y: py, tx: ex, ty: ey, state: 'idle', prog: 0, timer: 0, pulse: 0 });
  }
  /* 收尾：统一复核所有建筑的门是否仍可通行，被覆盖则重开 */
  var ed_i, ed_j, ed_b;
  for (ed_i = 0; ed_i < m.buildings.length; ed_i++) {
    ed_b = m.buildings[ed_i];
    for (ed_j = 0; ed_j < ed_b.doors.length; ed_j++) {
      if (tget(m, ed_b.doors[ed_j].x, ed_b.doors[ed_j].y) !== 3) {
        cutDoor(m, ed_b.doors[ed_j], ed_b.x, ed_b.y, ed_b.w, ed_b.h);
      }
    }
  }
  return m;
}

/* ---------- 流场寻路 ---------- */
var flow = null;
function buildFlow(m, tx, ty) {
  if (!inMap(tx, ty)) return;
  var d = new Int32Array(MAPW * MAPH); d.fill(-1);
  var q = new Int32Array(MAPW * MAPH), qh = 0, qt = 0;
  var start = ty * MAPW + tx;
  d[start] = 0; q[qt++] = start;
  var dirs = [[1, 0], [-1, 0], [0, 1], [0, -1]];
  while (qh < qt) {
    var idx = q[qh++];
    var cx = idx % MAPW, cy = (idx - cx) / MAPW, cd = d[idx];
    for (var k = 0; k < 4; k++) {
      var nx = cx + dirs[k][0], ny = cy + dirs[k][1];
      if (nx < 0 || ny < 0 || nx >= MAPW || ny >= MAPH) continue;
      var nidx = ny * MAPW + nx;
      if (d[nidx] !== -1) continue;
      if (m.tiles[nidx] === 2) continue;
      d[nidx] = cd + 1; q[qt++] = nidx;
    }
  }
  flow = { d: d, tx: tx, ty: ty };
}
function flowDir(m, x, y) {
  if (!flow) return null;
  var tx = clamp(Math.floor(x / TILE), 0, MAPW - 1), ty = clamp(Math.floor(y / TILE), 0, MAPH - 1);
  var cd = flow.d[ty * MAPW + tx];
  if (cd < 0) return null;
  var best = null, bv = cd;
  var dirs = [[1, 0], [-1, 0], [0, 1], [0, -1]];
  for (var k = 0; k < 4; k++) {
    var nx = tx + dirs[k][0], ny = ty + dirs[k][1];
    if (nx < 0 || ny < 0 || nx >= MAPW || ny >= MAPH) continue;
    var v = flow.d[ny * MAPW + nx];
    if (v >= 0 && v < bv) { bv = v; best = dirs[k]; }
  }
  return best;
}

/* =========================================================
   PART 3 —— 突袭逻辑：玩家 / 丧尸 AI / 战斗 / 搜刮 / 撤离
   ========================================================= */

var keys = {}, mouse = { x: 0, y: 0, down: false }, cam = { x: 0, y: 0, shake: 0 };

function addLog(t) {
  if (!G.raid) return;
  G.raid.log.unshift(t);
  if (G.raid.log.length > 6) G.raid.log.pop();
}
function floater(x, y, txt, c) {
  if (!G.raid) return;
  G.raid.floaters.push({ x: x, y: y, t: 0, txt: txt, c: c || '#fff' });
}
function burst(x, y, n, c, spd) {
  if (!G.raid) return;
  for (var i = 0; i < n; i++) {
    var a = rnd(0, Math.PI * 2), s = rnd(spd * 0.3, spd);
    G.raid.parts.push({ x: x, y: y, vx: Math.cos(a) * s, vy: Math.sin(a) * s, t: 0, life: rnd(0.2, 0.6), c: c });
  }
}

function startRaid(mapId) {
  var b = G.base, cfg = MAPS[mapId];
  if (!cfg) return false;
  var m = genMap(cfg);
  injectKeyItems(m, cfg);

  var gun = b.loadout.gun, melee = b.loadout.melee, armor = b.loadout.armor;
  if (gun && !(b.stash[gun] > 0)) gun = null;
  if (melee && !(b.stash[melee] > 0)) melee = null;
  if (armor && !(b.stash[armor] > 0)) armor = null;
  if (!gun && !melee) melee = 'crowbar';

  var bagCap = 12;
  var bag = { slots: new Array(bagCap).fill(null), cap: bagCap };

  /* 从仓库携带弹药 */
  var guns = [gun] ;
  for (var gi = 0; gi < guns.length; gi++) {
    if (!guns[gi]) continue;
    var w = WEAPONS[ITEMS[guns[gi]].wk];
    if (w && w.ammo) {
      var take = Math.min(b.stash[w.ammo] || 0, 60);
      if (take > 0) { bagAdd(bag, w.ammo, take); b.stash[w.ammo] -= take; }
    }
  }
  /* 携带消耗品 */
  var carry = [['bandage', 3], ['medkit', 1], ['food', 1], ['water', 1]];
  if (b.purifier) carry.push(['water', 2]);
  for (var ci = 0; ci < carry.length; ci++) {
    var cid = carry[ci][0], want = carry[ci][1];
    var got = Math.min(b.stash[cid] || 0, want);
    if (got > 0) { bagAdd(bag, cid, got); b.stash[cid] -= got; }
  }

  var maxHp = 100, maxStam = 100 + skillBonus('vitality') * 12;
  var p = {
    x: m.spawn.x, y: m.spawn.y, r: 12, ang: 0,
    hp: maxHp, maxHp: maxHp, stam: maxStam, maxStam: maxStam,
    hunger: 100, thirst: 100, infection: 0,
    bag: bag, gun: gun, melee: melee, armor: armor,
    armorDur: armor ? 100 : 0,
    attackCd: 0, reloading: 0, reloadTotal: 0, mag: 0, cur: gun || melee,
    sprint: false, walkPhase: 0, hurtCd: 0, flash: 0, noise: 0
  };
  if (gun) {
    var gw = WEAPONS[ITEMS[gun].wk];
    var load = Math.min(gw.mag, bagCount(bag, gw.ammo));
    p.mag = load;
    if (load > 0) bagRemove(bag, gw.ammo, load);
  }

  /* 安全屋：若本地图已建据点，从据点出发，并可直接从据点呼叫撤离 */
  if (!b.safehouse || typeof b.safehouse !== 'object') b.safehouse = {};
  var shSaved = b.safehouse[mapId];
  if (shSaved) {
    p.x = shSaved.x; p.y = shSaved.y;
    m.exits.push({ tx: shSaved.tx, ty: shSaved.ty, x: shSaved.x, y: shSaved.y, state: 'idle', prog: 0, timer: 0, pulse: 0, home: true });
  }

  var raid = {
    mapId: mapId, cfg: cfg, map: m, p: p,
    zombies: [], bullets: [], parts: [], floaters: [],
    phase: 'explore', time: 0, kills: 0, lootValue: 0, timeLimit: cfg.timeLimit,
    log: [], flowTimer: 0, spawnTimer: 0, wave: 0, homeCd: 0, timeout: false,
    extracting: null, exitCount: 0, msg: '', shake: 0, startedAt: 0,
    searched: 0, objective: '搜索物资并寻找撤离点'
  };
  G.raid = raid;

  /* 生成丧尸 */
  var zn = rndInt(cfg.zmin, cfg.zmax);
  for (var i = 0; i < zn; i++) {
    var zx, zy, ok = false, guard = 0;
    while (!ok && guard++ < 400) {
      zx = rndInt(2, MAPW - 3) * TILE + TILE / 2;
      zy = rndInt(2, MAPH - 3) * TILE + TILE / 2;
      if (isWallAt(m, zx, zy)) continue;
      if (dist(zx, zy, p.x, p.y) < 650) continue;
      ok = true;
    }
    if (!ok) continue;
    spawnZombie(raid, zx, zy);
  }
  buildFlow(m, Math.floor(p.x / TILE), Math.floor(p.y / TILE));
  cam.x = p.x; cam.y = p.y;

  /* 新手引导：只在前几局显示分步提示 */
  if (!b.tutorial || typeof b.tutorial !== 'object') b.tutorial = {};
  raid.guide = (b.tutorial.done ? '' : '新手引导①：WASD 移动，Shift 冲刺；靠近容器长按 E 搜刮。');

  addLog('已进入 ' + cfg.n + '。' + cfg.d);
  addLog('撤离点数量：' + m.exits.length + '。靠近后按 E 呼叫撤离。');
  showScreen('raid');
  return true;
}

function pickWeight(tbl, fallback) {
  var tot = 0, k;
  for (k in tbl) if (tbl[k] > 0) tot += tbl[k];
  if (tot <= 0) return fallback;
  var r = Math.random() * tot;
  for (k in tbl) { if (tbl[k] <= 0) continue; r -= tbl[k]; if (r <= 0) return k; }
  return fallback;
}

function pickZType(cfg) {
  var w = cfg.ztype;
  if (!w) {
    w = { walker: Math.max(0, 1 - (cfg.brute || 0) - (cfg.runner || 0)), runner: cfg.runner || 0, brute: cfg.brute || 0 };
  }
  var t = pickWeight(w, 'walker');
  return ZT[t] ? t : 'walker';
}

function pickBType(cfg) {
  var t = pickWeight(cfg.btype || { store: 1 }, 'store');
  return BLD[t] ? t : 'store';
}

function spawnZombie(raid, x, y, forceType) {
  var cfg = raid.cfg;
  var type = forceType;
  if (!type) type = pickZType(cfg);
  var t = ZT[type];
  raid.zombies.push({
    x: x, y: y, r: t.r, t: t, type: type,
    hp: t.hp, maxHp: t.hp, ang: rnd(0, 6.28),
    alert: 0, atkCd: rnd(0, 1), wander: rnd(0, 6.28), wanderT: 0,
    hurt: 0, lastSeen: null, speedJit: rnd(0.85, 1.15), kbx: 0, kby: 0, dead: false, walk: 0
  });
}

function curWeapon() {
  var p = G.raid.p;
  if (!p.cur) return WEAPONS.crowbar;
  return WEAPONS[ITEMS[p.cur] ? ITEMS[p.cur].wk : 'crowbar'] || WEAPONS.crowbar;
}

function noiseEvent(x, y, radius) {
  var raid = G.raid; if (!raid) return;
  raid.p.noise = 0.4;
  for (var i = 0; i < raid.zombies.length; i++) {
    var z = raid.zombies[i];
    var d = dist(x, y, z.x, z.y);
    if (d < radius && losClear(raid.map, x, y, z.x, z.y) === false ? d < radius * 0.6 : d < radius) {
      z.alert = Math.max(z.alert, 6);
      z.lastSeen = { x: x, y: y };
    }
    if (d < radius) { z.alert = Math.max(z.alert, 5); z.lastSeen = { x: x, y: y }; }
  }
}

function tryFire() {
  if (typeof SFX !== 'undefined') SFX.ensure();
  var raid = G.raid; if (!raid || raid.phase !== 'explore' && raid.phase !== 'extracting') return;
  var p = raid.p, w = curWeapon();
  if (p.attackCd > 0 || p.reloading > 0) return;

  if (w.melee) {
    if (p.stam < w.stam) { addLog('体力不足，挥不动了。'); p.attackCd = 0.35; return; }
    p.stam -= w.stam;
    p.attackCd = w.rate;
    /* 记录一次挥击过程，交由渲染层播放动画 */
    p.swing = {
      t: 0, dur: Math.max(0.20, Math.min(0.46, w.rate * 0.66)), ang: p.ang,
      range: w.range, arc: w.arc,
      wid: (p.cur && ITEMS[p.cur] && ITEMS[p.cur].wk) ? ITEMS[p.cur].wk : 'crowbar'
    };
    if (typeof SFX !== 'undefined') SFX.melee(p.swing.wid);
    var dmgMul = 1 + skillBonus('melee') * 0.12;
    var hitAny = false;
    for (var i = 0; i < raid.zombies.length; i++) {
      var z = raid.zombies[i];
      var d = dist(p.x, p.y, z.x, z.y);
      if (d > w.range + z.r) continue;
      var a = Math.atan2(z.y - p.y, z.x - p.x);
      if (Math.abs(angDiff(a, p.ang)) > w.arc) continue;
      hurtZombie(z, w.dmg * dmgMul, p.ang, w.kb);
      hitAny = true;
    }
    if (hitAny) {
      if (typeof SFX !== 'undefined') SFX.meleeHit();
      raid.shake = Math.min(5, raid.shake + 1.6);
      burst(p.x + Math.cos(p.ang) * w.range * 0.6, p.y + Math.sin(p.ang) * w.range * 0.6, 4, '#b03a2e', 170);
    }
    noiseEvent(p.x, p.y, w.noise);
    p.attackCd = hitAny ? w.rate : w.rate * 0.7;
    return;
  }

  if (p.mag <= 0) { startReload(); return; }
  p.mag--;
  p.attackCd = w.rate;
  var spread = w.spread * (1 - skillBonus('aim') * 0.08);
  for (var k = 0; k < w.pellets; k++) {
    var a2 = p.ang + rnd(-spread, spread);
    raid.bullets.push({
      x: p.x + Math.cos(p.ang) * 16, y: p.y + Math.sin(p.ang) * 16,
      vx: Math.cos(a2) * w.speed, vy: Math.sin(a2) * w.speed,
      dmg: w.dmg, life: 0.65, trail: 0
    });
  }
  if (typeof SFX !== 'undefined') SFX.shoot(w.noise);
  p.flash = 0.06;
  p.noise = 0.4;
  raid.shake = Math.min(6, raid.shake + 2.2);
  noiseEvent(p.x, p.y, w.noise);
  burst(p.x + Math.cos(p.ang) * 18, p.y + Math.sin(p.ang) * 18, 3, '#ffd98a', 120);
}

function startReload() {
  var raid = G.raid; if (!raid) return;
  var p = raid.p, w = curWeapon();
  if (w.melee || p.reloading > 0) return;
  var have = bagCount(p.bag, w.ammo);
  if (have <= 0) { addLog('没有 ' + ITEMS[w.ammo].n + ' 了。'); return; }
  if (typeof SFX !== 'undefined') SFX.reload();
  p.reloading = w.reload; p.reloadTotal = w.reload;
}

function finishReload() {
  var raid = G.raid; if (!raid) return;
  var p = raid.p, w = curWeapon();
  if (w.melee) return;
  var need = w.mag - p.mag;
  var have = bagCount(p.bag, w.ammo);
  var take = Math.min(need, have);
  if (take > 0) { bagRemove(p.bag, w.ammo, take); p.mag += take; }
}

function hurtZombie(z, dmg, ang, kb) {
  var raid = G.raid;
  var real = dmg * (1 - (z.t.armor || 0));
  z.hp -= real;
  z.hurt = 0.12;
  z.alert = Math.max(z.alert, 5);
  z.lastSeen = { x: raid.p.x, y: raid.p.y };
  if (kb) { z.kbx += Math.cos(ang) * kb; z.kby += Math.sin(ang) * kb; }
  burst(z.x, z.y, 3, '#8b2b2b', 90);
  floater(z.x, z.y - 14, '-' + Math.round(real), '#ffb3a0');
  if (z.hp <= 0 && !z.dead) {
    z.dead = true;
    raid.kills++;
    var xp = z.t.xp;
    G.base.xp += xp;
    burst(z.x, z.y, 10, '#5c1f1f', 130);
    checkLevelUp();
  }
}

function checkLevelUp() {
  var b = G.base;
  var need = b.sp + 1;
  while (b.xp >= 100 * (b.sp + 1)) { b.xp -= 100 * (b.sp + 1); b.sp++; }
}

function hurtPlayer(dmg, srcAng) {
  if (typeof SFX !== 'undefined') SFX.hurt();
  var raid = G.raid; if (!raid) return;
  var p = raid.p;
  if (p.hurtCd > 0) return;
  p.hurtCd = 0.32;
  var red = 0;
  if (p.armor && p.armorDur > 0) {
    var ar = ITEMS[p.armor].armor || 0;
    red = ar * (p.armorDur / 100);
    p.armorDur = Math.max(0, p.armorDur - dmg * 0.55);
  }
  var real = dmg * (1 - red / 100);
  if (raid.phase === 'extracting') real *= 0.35;
  p.hp -= real;
  raid.shake = Math.min(10, raid.shake + 4);
  floater(p.x, p.y - 20, '-' + Math.round(real), '#ff8080');
  burst(p.x, p.y, 5, '#a03030', 110);
  if (srcAng !== undefined && Math.random() < 0.22) {
    p.infection = Math.min(100, p.infection + rnd(9, 17));
    addLog('伤口被污染，感染上升。');
  }
  if (p.hp <= 0) { p.hp = 0; endRaid(false); }
}

function useItem(id) {
  var raid = G.raid; if (!raid) return false;
  var p = raid.p;
  if (bagCount(p.bag, id) <= 0) {
    var missN = ITEMS[id] ? ITEMS[id].n : id;
    addLog('背包里没有 ' + missN + '。');
    floater(p.x, p.y - 30, '没有 ' + missN, '#ffb0b0');
    return false;
  }
  var it = ITEMS[id];
  var mul = 1 + skillBonus('medic') * 0.15 + (G.base.medbay ? 0.25 : 0);
  bagRemove(p.bag, id, 1);
  if (it.heal) {
    var heal = it.heal * mul;
    p.hp = Math.min(p.maxHp, p.hp + heal);
    floater(p.x, p.y - 22, '+' + Math.round(heal), '#8fe08f');
    addLog('使用 ' + it.n + '，恢复 ' + Math.round(heal) + ' 生命。');
  }
  if (it.inf) {
    p.infection = Math.max(0, p.infection + it.inf);
    addLog('使用 ' + it.n + '，感染降至 ' + Math.round(p.infection) + '。');
  }
  if (it.hunger) { p.hunger = Math.min(100, p.hunger + it.hunger); addLog('吃下 ' + it.n + '。'); }
  if (it.thirst) { p.thirst = Math.min(100, p.thirst + it.thirst); addLog('喝下 ' + it.n + '。'); }
  return true;
}

function switchWeapon() {
  var raid = G.raid; if (!raid) return;
  var p = raid.p;
  if (p.cur === p.gun && p.melee) p.cur = p.melee;
  else if (p.gun) p.cur = p.gun;
  else if (p.melee) p.cur = p.melee;
  p.reloading = 0; p.attackCd = Math.max(p.attackCd, 0.25);
  addLog('切换至 ' + ITEMS[p.cur].n);
}

function updatePlayer(dt) {
  var raid = G.raid, p = raid.p, m = raid.map;
  p.attackCd = Math.max(0, p.attackCd - dt);
  p.hurtCd = Math.max(0, p.hurtCd - dt);
  p.flash = Math.max(0, p.flash - dt);
  p.noise = Math.max(0, p.noise - dt);
  if (p.swing) { p.swing.t += dt; if (p.swing.t >= p.swing.dur) p.swing = null; }
  if (p.reloading > 0) {
    p.reloading -= dt;
    if (p.reloading <= 0) { p.reloading = 0; finishReload(); }
  }

  var ax = 0, ay = 0;
  if (keys['w'] || keys['arrowup']) ay -= 1;
  if (keys['s'] || keys['arrowdown']) ay += 1;
  if (keys['a'] || keys['arrowleft']) ax -= 1;
  if (keys['d'] || keys['arrowright']) ax += 1;
  var len = Math.hypot(ax, ay);
  var wantSprint = (keys['shift']) && len > 0 && p.stam > 1;
  p.sprint = wantSprint;

  var bagW = bagWeight(p.bag);
  p.bagW = bagW; p.overloaded = bagW >= BAG_MAXW - 0.01;
  var encum = bagW > 24 ? clamp(1 - (bagW - 24) / 45, 0.5, 1) : 1;
  var speed = (wantSprint ? 262 : 168) * encum;
  if (p.hunger < 20 || p.thirst < 20) speed *= 0.85;
  if (p.infection > 60) speed *= 0.9;

  if (len > 0) {
    ax /= len; ay /= len;
    moveEnt(m, p, ax * speed * dt, ay * speed * dt);
    doorAssist(dt);
    p.walkPhase += dt * (wantSprint ? 14 : 9);
    if (wantSprint) p.stam = Math.max(0, p.stam - 15 * dt);
  }
  if (!wantSprint) p.stam = Math.min(p.maxStam, p.stam + 9 * dt);

  /* 生存指标 */
  p.hunger = Math.max(0, p.hunger - dt * 0.4);
  p.thirst = Math.max(0, p.thirst - dt * 0.5);
  if (p.hunger <= 0 || p.thirst <= 0) p.hp -= dt * 2.4;
  if (p.infection > 60) p.hp -= dt * (0.8 + (p.infection - 60) * 0.08);
  if (p.hp <= 0) { p.hp = 0; endRaid(false); return; }
  if (p.infection >= 100) { p.infection = 100; if (p.hp > 0) { p.hp = 0; endRaid(false); } }

  /* 瞄准 */
  var wx = mouse.x + cam.x - (G.viewW || 0) / 2, wy = mouse.y + cam.y - (G.viewH || 0) / 2;
  p.ang = Math.atan2(wy - p.y, wx - p.x);

  /* 射击 */
  if (mouse.down && raid.phase !== 'dead' && raid.phase !== 'done') tryFire();

  /* 交互 */
  updateInteract(dt);
}

function nearestContainer() {
  var raid = G.raid, p = raid.p, best = null, bd = 99999;
  for (var i = 0; i < raid.map.containers.length; i++) {
    var c = raid.map.containers[i];
    if (c.searched) continue;
    var d = dist(p.x, p.y, c.x, c.y);
    if (d < 62 && d < bd) { bd = d; best = c; }
  }
  return best;
}
var EXTRACT_CALL = 3.5;   /* 呼叫撤离所需秒数 */
function nearestExit() {
  var raid = G.raid, p = raid.p, best = null, bd = 99999;
  for (var i = 0; i < raid.map.exits.length; i++) {
    var e = raid.map.exits[i];
    var d = dist(p.x, p.y, e.x, e.y);
    if (d < 78 && d < bd) { bd = d; best = e; }
  }
  return best;
}

function updateInteract(dt) {
  var raid = G.raid, p = raid.p;
  raid.tip = '';
  if (raid.phase === 'dead' || raid.phase === 'done') return;

  var c = nearestContainer();
  var e = nearestExit();
  updateSafehouseInteract(dt, !c && !e);

  if (c) {
    if (keys['e']) {
      c.prog += dt;
      raid.objective = '搜刮中… ' + Math.round(clamp(c.prog / 1.4, 0, 1) * 100) + '%';
      if (c.prog >= 1.4) { lootContainer(c); }
    } else {
      raid.tip = '按 E 搜刮 ' + containerName(c.type);
      if (c.prog > 0) c.prog = Math.max(0, c.prog - dt * 1.5);
    }
    return;
  }
  if (e) {
    if (e.state === 'idle') {
      if (keys['e']) {
        e.prog += dt;
        raid.objective = '正在启动撤离信号… ' + Math.round(clamp(e.prog / EXTRACT_CALL, 0, 1) * 100) + '%';
        raid.tip = '保持静止以完成呼叫';
        if (e.prog >= EXTRACT_CALL) {
          e.state = 'active'; e.timer = 14; e.prog = 0;
          raid.phase = 'extracting'; raid.extracting = e;
          raid.wave = 0; raid.spawnTimer = 1.0;
          if (typeof SFX !== 'undefined') SFX.alarm();
          if (G.base.tutorial && typeof G.base.tutorial === 'object' && !G.base.tutorial.done) G.base.tutorial.done = 1;
          raid.objective = '撤离倒计时';
          addLog('信号已发出！坚守 14 秒，它们正在赶来。');
          noiseEvent(e.x, e.y, 1400);
        }
      } else {
        raid.tip = '按 E 呼叫撤离（需 ' + EXTRACT_CALL + ' 秒）';
        e.prog = Math.max(0, e.prog - dt * 2);
      }
    } else if (e.state === 'active') {
      raid.tip = '撤离进行中，等待运输机降落';
    }
  }
}

/* ---------- 安全屋：建立据点 / 跨局储物 ---------- */
function bagEmptyOf(bag) {
  for (var i = 0; i < bag.slots.length; i++) if (bag.slots[i]) return false;
  return true;
}

function updateSafehouseInteract(dt, allow) {
  var raid = G.raid; if (!raid) return;
  var p = raid.p, b = G.base;
  if (!b.safehouse || typeof b.safehouse !== 'object') b.safehouse = {};
  raid.homeCd = Math.max(0, (raid.homeCd || 0) - dt);
  var sh = b.safehouse[raid.mapId];

  if (sh) {
    if (dist(p.x, p.y, sh.x, sh.y) > 82) return;
    var box = sh.box || (sh.box = new Array(12).fill(null));
    var boxN = 0;
    for (var i = 0; i < box.length; i++) if (box[i]) boxN++;
    if (allow && raid.phase === 'explore') {
      raid.tip = 'F ' + (bagEmptyOf(p.bag) ? '取回安全屋物资' : '把背包存入安全屋') + '（箱内 ' + boxN + ' 项）';
    }
    if (keys['f'] && raid.homeCd <= 0 && raid.phase === 'explore') {
      raid.homeCd = 0.6; keys['f'] = false;
      stashToHome(sh, p);
    }
    return;
  }

  if (!allow || raid.phase !== 'explore') return;
  var tx = Math.floor(p.x / TILE), ty = Math.floor(p.y / TILE);
  var tvHere = tget(raid.map, tx, ty);
  if ((tvHere !== 4 && tvHere !== 1) || isWallAt(raid.map, p.x, p.y)) return;
  var hasWood = bagCount(p.bag, 'wood') >= 3, hasScrap = bagCount(p.bag, 'scrap') >= 5;
  raid.tip = (hasWood && hasScrap) ? 'F 在此建立安全屋（木材 3 + 废金属 5）' : '建立安全屋需要木材 3 + 废金属 5';
  if (keys['f'] && raid.homeCd <= 0 && hasWood && hasScrap) {
    raid.homeCd = 0.6; keys['f'] = false;
    bagRemove(p.bag, 'wood', 3);
    bagRemove(p.bag, 'scrap', 5);
    b.safehouse[raid.mapId] = { tx: tx, ty: ty, x: tx * TILE + TILE / 2, y: ty * TILE + TILE / 2, box: new Array(12).fill(null) };
    addLog('安全屋已建立：下次可从这里出发，也能直接呼叫撤离。');
    save();
  }
}

function stashToHome(sh, p) {
  if (!sh.box) sh.box = new Array(12).fill(null);
  var moved = 0, i;
  var boxN = 0;
  for (i = 0; i < sh.box.length; i++) if (sh.box[i]) boxN++;
  if (boxN > 0 && bagEmptyOf(p.bag)) {
    for (i = 0; i < sh.box.length; i++) {
      var s = sh.box[i];
      if (!s) continue;
      var add = bagAdd(p.bag, s.id, s.qty);
      if (add > 0) { s.qty -= add; moved += add; if (s.qty <= 0) sh.box[i] = null; }
    }
    addLog(moved > 0 ? '从安全屋取回 ' + moved + ' 件物资。' : '背包已满，取不回来。');
  } else {
    var holder = { slots: sh.box };
    for (i = 0; i < p.bag.slots.length; i++) {
      var bs = p.bag.slots[i];
      if (!bs) continue;
      var add2 = bagAdd(holder, bs.id, bs.qty);
      if (add2 > 0) { bs.qty -= add2; moved += add2; if (bs.qty <= 0) p.bag.slots[i] = null; }
    }
    addLog(moved > 0 ? '存入安全屋 ' + moved + ' 件物资。' : '安全屋箱子已满。');
  }
  save();
}

/* ---------- 音效：全部用 WebAudio 实时合成，零外部资源 ---------- */
var SFX = (function () {
  var ctx = null, master = null, gSfx = null, gBgm = null, ready = false, lastAt = {};
  var BGM_ON = false, bgmNodes = null;

  function ensure() {
    if (ready) {
      /* 浏览器自动播放策略下上下文可能是 suspended，任何一次真实交互后恢复 */
      try { if (ctx && ctx.state === 'suspended' && ctx.resume) ctx.resume(); } catch (e) {}
      return true;
    }
    try {
      var AC = (typeof window !== 'undefined') && (window.AudioContext || window.webkitAudioContext);
      if (!AC) return false;
      ctx = new AC();
      master = ctx.createGain(); master.gain.value = 0.8; master.connect(ctx.destination);
      gSfx = ctx.createGain(); gSfx.gain.value = 0.8; gSfx.connect(master);
      gBgm = ctx.createGain(); gBgm.gain.value = 0.5; gBgm.connect(master);
      ready = true;
      try { sync(getSettings()); } catch (e) {}
      return true;
    } catch (e) { ready = false; return false; }
  }

  function sync(s) {
    if (!ready || !s) return;
    var m = s.mute ? 0 : 1;
    try {
      master.gain.value = 0.0001 + s.master * m;
      gSfx.gain.value = 0.0001 + s.sfx;
      gBgm.gain.value = 0.0001 + s.bgm;
    } catch (e) {}
  }

  function gate(key, ms) {
    var now = Date.now();
    if (lastAt[key] && now - lastAt[key] < ms) return false;
    lastAt[key] = now; return true;
  }

  function tone(freq, dur, type, vol, slideTo) {
    if (!ensure()) return;
    try {
      var o = ctx.createOscillator(), g = ctx.createGain();
      o.type = type || 'sine';
      o.frequency.setValueAtTime(freq, ctx.currentTime);
      if (slideTo) o.frequency.exponentialRampToValueAtTime(Math.max(20, slideTo), ctx.currentTime + dur);
      g.gain.setValueAtTime(Math.max(0.0001, vol || 0.2), ctx.currentTime);
      g.gain.exponentialRampToValueAtTime(0.0001, ctx.currentTime + dur);
      o.connect(g); g.connect(gSfx);
      o.start(); o.stop(ctx.currentTime + dur + 0.02);
    } catch (e) {}
  }

  function noise(dur, vol, hp) {
    if (!ensure()) return;
    try {
      var len = Math.floor(ctx.sampleRate * dur), buf = ctx.createBuffer(1, len, ctx.sampleRate);
      var d = buf.getChannelData(0);
      for (var i = 0; i < len; i++) d[i] = (Math.random() * 2 - 1) * (1 - i / len);
      var s2 = ctx.createBufferSource(); s2.buffer = buf;
      var f = ctx.createBiquadFilter(); f.type = 'bandpass'; f.frequency.value = hp || 900; f.Q.value = 0.8;
      var g = ctx.createGain(); g.gain.value = vol || 0.25;
      g.gain.exponentialRampToValueAtTime(0.0001, ctx.currentTime + dur);
      s2.connect(f); f.connect(g); g.connect(gSfx);
      s2.start();
    } catch (e) {}
  }

  return {
    ensure: ensure, sync: sync,
    click: function () { if (!gate('click', 40)) return; tone(520, 0.05, 'square', 0.12, 380); },
    shoot: function (noise2) {
      if (!gate('shoot', 30)) return;
      noise(0.12, Math.min(0.5, 0.16 + (noise2 || 300) / 2400), 260 + (noise2 || 0) * 0.5);
      tone(90, 0.1, 'square', 0.2, 45);
    },
    bgmState: function () { return BGM_ON; },
    melee: function (kind) {
      if (!gate('melee', 70)) return;
      /* 挥空：短促风声 */
      noise(0.13, 0.2, kind === 'axe' ? 1100 : 1700);
      tone(kind === 'axe' ? 150 : 210, 0.12, 'sawtooth', 0.1, 70);
    },
    meleeHit: function () {
      if (!gate('meleehit', 60)) return;
      noise(0.12, 0.3, 380);                 /* 钝器砸中肉体的闷响 */
      tone(85, 0.16, 'square', 0.22, 42);
      setTimeout(function () { tone(58, 0.2, 'sine', 0.16, 36); }, 30);
    },
    craft: function () {
      if (!gate('craft', 200)) return;
      var i2 = 0;
      var tick2 = function () {
        if (i2 >= 3) return;
        noise(0.06, 0.16, 2200); tone(180 + i2 * 40, 0.05, 'square', 0.1, 120);
        i2++; setTimeout(tick2, 190);
      };
      tick2();
      setTimeout(function () { tone(784, 0.16, 'triangle', 0.14); setTimeout(function () { tone(1046, 0.2, 'triangle', 0.12); }, 130); }, 640);
    },
    save: function () {
      if (!gate('save', 300)) return;
      tone(660, 0.08, 'triangle', 0.14); setTimeout(function () { tone(990, 0.12, 'triangle', 0.12); }, 90);
    },
    door: function () {
      if (!gate('door', 200)) return;
      noise(0.26, 0.16, 620); tone(120, 0.3, 'sawtooth', 0.08, 60);
    },
    reload: function () { if (!gate('reload', 120)) return; tone(320, 0.06, 'square', 0.1, 220); setTimeout(function () { tone(240, 0.07, 'square', 0.1, 300); }, 180); },
    hiss: function () { if (!gate('hiss', 260)) return; noise(0.34, 0.2, 480); tone(150, 0.3, 'sawtooth', 0.08, 90); },
    hurt: function () { if (!gate('hurt', 200)) return; tone(200, 0.18, 'sawtooth', 0.22, 80); },
    step: function () { if (!gate('step', 240)) return; noise(0.06, 0.07, 300); },
    loot: function () { if (!gate('loot', 120)) return; tone(660, 0.07, 'triangle', 0.12, 880); setTimeout(function () { tone(880, 0.08, 'triangle', 0.1, 990); }, 90); },
    alarm: function () { if (!gate('alarm', 900)) return; tone(700, 0.28, 'sawtooth', 0.16, 500); setTimeout(function () { tone(700, 0.28, 'sawtooth', 0.14, 500); }, 340); },
    win: function () { [523, 659, 784].forEach(function (f, i) { setTimeout(function () { tone(f, 0.22, 'triangle', 0.16); }, i * 130); }); },
    lose: function () { [392, 330, 262].forEach(function (f, i) { setTimeout(function () { tone(f, 0.3, 'sawtooth', 0.16); }, i * 160); }); },
    bgm: function (on) {
      if (on === undefined) on = true;
      if (!ensure()) return;
      try {
        if (on && !BGM_ON) {
          BGM_ON = true;
          var t0b = ctx.currentTime;
          var mix = ctx.createGain(); mix.gain.value = 0.9; mix.connect(gBgm);
          var nodes = { mix: mix, osc: [], timer: null };

          /* 1) 极低频三重 drone：压抑、下沉的恐怖底噪 */
          var droneSpec = [[41.2, 'sine', 0.13], [61.7, 'sine', 0.06], [27.5, 'triangle', 0.09]];
          for (var di = 0; di < droneSpec.length; di++) {
            var dO = ctx.createOscillator(), dG = ctx.createGain();
            dO.type = droneSpec[di][1]; dO.frequency.value = droneSpec[di][0];
            dG.gain.value = droneSpec[di][2];
            dO.connect(dG); dG.connect(mix); dO.start(t0b);
            nodes.osc.push(dO);
            /* 轻微失谐颤动，避免电子味的死板 */
            var dL = ctx.createOscillator(), dLG = ctx.createGain();
            dL.type = 'sine'; dL.frequency.value = 0.11 + di * 0.04;
            dLG.gain.value = droneSpec[di][0] * 0.008;
            dL.connect(dLG); dLG.connect(dO.frequency); dL.start(t0b);
            nodes.osc.push(dL);
          }

          /* 2) 呼吸感：0.05Hz 缓慢推拉总音量 */
          var brO = ctx.createOscillator(), brG = ctx.createGain();
          brO.type = 'sine'; brO.frequency.value = 0.05;
          brG.gain.value = 0.34; brO.connect(brG); brG.connect(mix.gain); brO.start(t0b);
          nodes.osc.push(brO);

          /* 3) 阴风：循环噪声经低通，营造空荡空间感 */
          try {
            var nLen = Math.floor(ctx.sampleRate * 4);
            var nBuf = ctx.createBuffer(1, nLen, ctx.sampleRate), nd = nBuf.getChannelData(0);
            for (var ni = 0; ni < nLen; ni++) nd[ni] = (Math.random() * 2 - 1) * (0.55 + 0.45 * Math.sin(ni / nLen * Math.PI * 2));
            var nSrc = ctx.createBufferSource(); nSrc.buffer = nBuf; nSrc.loop = true;
            var nLp = ctx.createBiquadFilter(); nLp.type = 'lowpass'; nLp.frequency.value = 300; nLp.Q.value = 0.7;
            var nG = ctx.createGain(); nG.gain.value = 0.05;
            nSrc.connect(nLp); nLp.connect(nG); nG.connect(mix); nSrc.start(t0b);
            nodes.osc.push(nSrc);
          } catch (e) {}

          /* 4) 不规则心跳 + 偶发不谐和二度音：恐怖张力 */
          var beat = function () {
            if (!BGM_ON) return;
            try {
              var now = ctx.currentTime;
              for (var k = 0; k < 2; k++) {
                (function (off, kk) {
                  var o2 = ctx.createOscillator(), g2 = ctx.createGain();
                  o2.type = 'sine';
                  o2.frequency.setValueAtTime(56 - kk * 7, now + off);
                  g2.gain.setValueAtTime(0.0001, now + off);
                  g2.gain.exponentialRampToValueAtTime(kk ? 0.05 : 0.08, now + off + 0.035);
                  g2.gain.exponentialRampToValueAtTime(0.0001, now + off + 0.42);
                  o2.connect(g2); g2.connect(mix);
                  o2.start(now + off); o2.stop(now + off + 0.46);
                })(k * 0.33, k);
              }
              if (Math.random() < 0.34) {
                var oo = ctx.createOscillator(), og = ctx.createGain();
                oo.type = 'triangle';
                oo.frequency.setValueAtTime(146.8 + Math.random() * 40, now + 0.1);
                og.gain.setValueAtTime(0.0001, now + 0.1);
                og.gain.exponentialRampToValueAtTime(0.035, now + 0.9);
                og.gain.exponentialRampToValueAtTime(0.0001, now + 3.4);
                oo.connect(og); og.connect(mix);
                oo.start(now + 0.1); oo.stop(now + 3.5);
              }
            } catch (e) {}
            nodes.timer = setTimeout(beat, 1500 + Math.random() * 1500);
          };
          nodes.timer = setTimeout(beat, 1000);
          bgmNodes = nodes;
        } else if (!on && BGM_ON) {
          BGM_ON = false;
          var oldB = bgmNodes; bgmNodes = null;
          if (oldB) {
            if (oldB.timer) clearTimeout(oldB.timer);
            try { for (var qb = 0; qb < oldB.osc.length; qb++) oldB.osc[qb].stop(); } catch (e) {}
            try { oldB.mix.disconnect(); } catch (e) {}
          }
        }
      } catch (e) {}
    }
  };
})();

/* ---------- 血月：可玩的营地防守小局 ---------- */
function startBloodMoon() {
  var b = G.base;
  if (b.day % 4 !== 0) { showTipMsg('今晚不是血月。'); return false; }
  if (b.bloodDay === b.day) { showTipMsg('这次血月已经过去了。'); return false; }
  G.bm = { round: 0, total: 5, wall: 100, log: [], phase: 'ready', result: null, out: 0, acts: { fire: 0, trap: 0, repair: 0 } };
  showScreen('bloodmoon');
  return true;
}

function bmThreat(bm) { return 14 + (bm.round + 1) * 6 + G.base.day * 2; }
function bmActsLeft(bm, kind) { var lim = kind === 'repair' ? 2 : 2; return lim - ((bm.acts && bm.acts[kind]) || 0); }
function bloodMoonAction(kind) {
  var b = G.base, bm = G.bm;
  if (!bm || bm.phase !== 'ready') return false;
  if (bm.round >= bm.total) return false;
  var round = bm.round + 1;
  var threat = bmThreat(bm);
  if (kind === 'next') {
    var dmg = Math.max(0, threat - (bm.out || 0));
    bm.wall = Math.max(0, bm.wall - dmg);
    bm.round = round;
    bm.log.push('第 ' + round + ' 波 · 威胁 ' + threat + ' ｜我方压制 ' + (bm.out || 0) + ' ｜围墙 -' + dmg + '（剩 ' + bm.wall + '/100）');
    bm.out = 0; bm.acts = { fire: 0, trap: 0, repair: 0 };
    bm.round = round;
  } else {
    if (bmActsLeft(bm, kind) <= 0) { showTipMsg('本波该类行动已达上限。'); return false; }
    var out = 0, msg = '';
    if (kind === 'fire') {
      if ((b.stash.ammo9 || 0) < 6) { showTipMsg('弹药不足 6 发，无法组织火力。'); return false; }
      b.stash.ammo9 -= 6;
      out = 8 + ((b.stash.rifle || 0) > 0 ? 7 : 0) + ((b.stash.shotgun || 0) > 0 ? 5 : 0) + Math.round(b.defense * 0.4);
      msg = '组织火力压制 ' + out + ' 点';
    } else if (kind === 'trap') {
      if ((b.stash.elec || 0) < 2) { showTipMsg('电量不足（需电子元件 x2）。'); return false; }
      b.stash.elec -= 2;
      out = 6 + Math.round(b.defense * 0.6);
      msg = '电网放电压制 ' + out + ' 点';
    } else if (kind === 'repair') {
      if ((b.stash.wood || 0) < 2) { showTipMsg('木材不足（需木材 x2）。'); return false; }
      b.stash.wood -= 2;
      bm.wall = Math.min(100, bm.wall + 16);
      msg = '加固围墙，耐久 +16';
    } else return false;
    bm.acts[kind] = (bm.acts[kind] || 0) + 1;
    bm.out = (bm.out || 0) + out;
    if (out) bm.log.push('第 ' + round + ' 波 · ' + msg + '（本波累计 ' + bm.out + '）');
    else bm.log.push('第 ' + round + ' 波 · ' + msg + '（剩 ' + bm.wall + '/100）');
    save();
    showScreen('bloodmoon');
    return true;
  }

  if (bm.wall <= 0) {
    bm.phase = 'over'; bm.result = false;
    var arr = Object.keys(b.stash).filter(function (k) { return ITEMS[k] && ITEMS[k].t === 'mat' && b.stash[k] > 0; });
    var loss = [];
    for (var i = 0; i < Math.min(3, arr.length); i++) {
      var k2 = arr[i], take = Math.max(1, Math.floor(b.stash[k2] * 0.4));
      b.stash[k2] -= take; loss.push(ITEMS[k2].n + ' x' + take);
    }
    b.lastBlood = '第 ' + b.day + ' 天血月：围墙被突破（第 ' + round + ' 波），损失 ' + (loss.join('，') || '部分物资') + '。';
    b.bloodDay = b.day; b.bloodPending = 0;
    if (typeof SFX !== 'undefined') SFX.lose();
  } else if (bm.round >= bm.total) {
    bm.phase = 'over'; bm.result = true;
    b.sp += 1;
    b.lastBlood = '第 ' + b.day + ' 天血月：五波全数击退（围墙剩余 ' + bm.wall + '/100），技能点 +1。';
    b.bloodDay = b.day; b.bloodPending = 0;
    if (typeof SFX !== 'undefined') SFX.win();
  }
  save();
  showScreen('bloodmoon');
  return true;
}

function containerName(t) {
  return { cabinet: '储物柜', fridge: '冰箱', toolbox: '工具箱', medbox: '医疗箱', crate: '货箱' }[t] || '容器';
}

function lootContainer(c) {
  if (typeof SFX !== 'undefined') SFX.loot();
  var raid = G.raid, p = raid.p;
  c.searched = true;
  c.prog = 0;
  raid.searched++;
  var surv = 1 + skillBonus('survival') * 0.1;
  /* 先在背包副本上预演一次，得到「这次实际能拿走的物品与数量」；
     真正的入库推迟到玩家在结算面板点确认，避免搜完直接静默进包 */
  var sim = JSON.parse(JSON.stringify({ slots: p.bag.slots }));
  var rows = [], leftOver = null, gained = 0;
  for (var i = 0; i < c.loot.length; i++) {
    var l = c.loot[i];
    var qty = Math.max(1, Math.round(l.qty * surv));
    var itK = ITEMS[l.id] || { n: l.id, t: '' };
    if (itK.t === 'key') { rows.push({ id: l.id, n: itK.n, qty: 1, c: itK.c, kind: 'key' }); gained++; continue; }
    if (itK.t === 'note') { rows.push({ id: l.id, n: itK.n, qty: 1, c: itK.c, kind: 'note' }); gained++; continue; }
    var added = bagAdd(sim, l.id, qty);
    if (added > 0) { rows.push({ id: l.id, n: itK.n, qty: added, c: itK.c, kind: 'item' }); gained += added; }
    if (added < qty) { if (!leftOver) leftOver = []; leftOver.push({ id: l.id, qty: qty - added }); }
  }
  G.pendingLoot = { c: c, rows: rows, left: leftOver || [] };
  showScreen('lootResult');
}

/* 结算面板确认：真正把预演结果写进背包，然后回到局内 */
function confirmLoot() {
  var pl = G.pendingLoot;
  G.pendingLoot = null;
  var raid = G.raid;
  if (!raid || !raid.p) { showScreen(raid ? 'raid' : 'hub'); return; }
  if (!pl || !pl.c) { showScreen('raid'); return; }
  var p = raid.p, c = pl.c, got = [];
  for (var i = 0; i < pl.rows.length; i++) {
    var r = pl.rows[i];
    if (r.kind === 'key') {
      G.base.keycard = true; G.base.militaryUnlocked = true;
      raid.lootValue += itemValue(r.id);
      got.push(r.n + ' x1');
      addLog('获得军事基地门卡，新路线解锁。');
    } else if (r.kind === 'note') {
      collectNote(r.id);
      raid.lootValue += itemValue(r.id);
      got.push(r.n + ' x1');
    } else {
      var added = bagAdd(p.bag, r.id, r.qty);
      if (added > 0) { raid.lootValue += itemValue(r.id) * added; got.push(r.n + ' x' + added); }
      if (added < r.qty) {
        var miss = r.qty - added, hit = false;
        for (var j = 0; j < pl.left.length; j++) { if (pl.left[j].id === r.id) { pl.left[j].qty += miss; hit = true; } }
        if (!hit) pl.left.push({ id: r.id, qty: miss });
      }
    }
  }
  if (got.length === 0) addLog(containerName(c.type) + ' 塞不进背包了。');
  else {
    addLog('搜到：' + got.join('，'));
    raid.objective = '搜索物资并寻找撤离点';
  }
  if (pl.left && pl.left.length) addLog('背包负重/格位不够，还有 ' + pl.left.length + ' 种物资留在容器里。');
  c.loot = pl.left || [];
  showScreen('raid');
}

function collectNote(id) {
  var b = G.base;
  if (b.notes.indexOf(id) < 0) {
    b.notes.push(id);
    addLog('发现档案：' + NOTES[id].title);
  }
}

function endRaid(success) {
  var raid = G.raid; if (!raid) return;
  if (raid.phase === 'done' || raid.phase === 'dead') return;
  var p = raid.p, b = G.base;

  var gain = [];
  if (success) {
    for (var i = 0; i < p.bag.slots.length; i++) {
      var s = p.bag.slots[i];
      if (!s) continue;
      var sIt = ITEMS[s.id];
      if (sIt && sIt.t === 'note') {
        /* 剧情档案：归档进营地档案库，不占物资仓 */
        if (!Array.isArray(b.notes)) b.notes = [];
        if (b.notes.indexOf(s.id) < 0) b.notes.push(s.id);
        gain.push('档案·' + sIt.n);
        continue;
      }
      b.stash[s.id] = (b.stash[s.id] || 0) + s.qty;
      gain.push((sIt ? sIt.n : s.id) + ' x' + s.qty);
    }
    /* 装备归还（成功撤离不损失） */
    b.extracts++;
    /* 主线结局：集齐六份档案并在军事基地成功撤离 */
    if (raid.mapId === 'military' && Array.isArray(b.notes) && b.notes.length >= 6 && !b.ending) {
      b.ending = true; b.endingDay = b.day;
      addLog('主线结局达成：你带着全部档案离开了这座城。');
    }
    var xpGain = 30 + raid.kills * 6 + raid.searched * 4;
    var spBefore = b.sp;
    b.xp += xpGain;
    checkLevelUp();
    var tRatio = raid.timeLimit ? raid.time / raid.timeLimit : 0.5;
    var score = raid.kills * 2 + raid.searched * 1.5 + (tRatio < 0.6 ? 8 : tRatio < 0.85 ? 4 : 0);
    var grade = score >= 45 ? 'S' : score >= 30 ? 'A' : score >= 18 ? 'B' : 'C';
    if (score > (b.best || 0)) b.best = Math.round(score);
    raid.result = { success: true, gain: gain, xp: xpGain, kills: raid.kills, searched: raid.searched, spGain: b.sp - spBefore, grade: grade, lootValue: Math.round(raid.lootValue || 0), time: Math.round(raid.time), limit: raid.timeLimit };
    b.lastReport = '第 ' + b.day + ' 天 · ' + raid.cfg.n + '：撤离成功，击杀 ' + raid.kills + '，搜刮 ' + raid.searched + ' 个容器，带回 ' + gain.length + ' 项（估值 ' + Math.round(raid.lootValue) + '），评级 ' + grade + '。';
    raid.phase = 'done';
    addLog('撤离成功。');
  } else {
    b.deaths++;
    /* 死亡：背包全失，装备有概率损坏 */
    if (!b.damaged || typeof b.damaged !== 'object') b.damaged = {};
    if (p.gun && Math.random() < 0.5) {
      b.stash[p.gun] = Math.max(0, (b.stash[p.gun] || 0) - 1);
      b.damaged[p.gun] = (b.damaged[p.gun] || 0) + 1;
      raid.lostGun = (ITEMS[p.gun] ? ITEMS[p.gun].n : '武器'); raid.damaged = true;
    }
    if (p.armor && Math.random() < 0.35) {
      b.stash[p.armor] = Math.max(0, (b.stash[p.armor] || 0) - 1);
      b.damaged[p.armor] = (b.damaged[p.armor] || 0) + 1;
      raid.damaged = true;
    }
    var xpGain2 = Math.floor(raid.kills * 3 + raid.searched * 1);
    var spBefore2 = b.sp;
    b.xp += xpGain2;
    checkLevelUp();
    raid.result = { success: false, gain: [], xp: xpGain2, kills: raid.kills, searched: raid.searched, spGain: b.sp - spBefore2, grade: 'C', damaged: !!raid.damaged, reason: raid.timeout ? 'timeout' : 'dead', lootValue: Math.round(raid.lootValue || 0), time: Math.round(raid.time), limit: raid.timeLimit };
    b.lastReport = '第 ' + b.day + ' 天 · ' + raid.cfg.n + '：' + (raid.timeout ? '撤离窗口关闭，被困感染区' : '阵亡') + '，击杀 ' + raid.kills + '，搜刮 ' + raid.searched + ' 个容器，物资全部丢失。';
    raid.phase = 'dead';
  }
  b.raids++;
  b.totalKills += raid.kills;
  b.day++;
  G.screen = 'result';
  renderScreen();
  if (hudEl) hudEl.classList.add('hide');
  if (typeof onRaidEnd === 'function') onRaidEnd(success);
}

/* ---------- 丧尸更新 ---------- */
function updateZombies(dt) {
  var raid = G.raid, p = raid.p, m = raid.map;
  for (var i = raid.zombies.length - 1; i >= 0; i--) {
    var z = raid.zombies[i];
    if (z.dead) { raid.zombies.splice(i, 1); continue; }
    z.hurt = Math.max(0, z.hurt - dt);
    z.atkCd = Math.max(0, z.atkCd - dt);
    z.wanderT -= dt;

    /* 击退 */
    if (Math.abs(z.kbx) > 1 || Math.abs(z.kby) > 1) {
      moveEnt(m, z, z.kbx * dt, z.kby * dt);
      z.kbx *= 0.82; z.kby *= 0.82;
    }

    var d = dist(z.x, z.y, p.x, p.y);
    var canSee = d < z.t.vision && losClear(m, z.x, z.y, p.x, p.y);
    if (canSee && raid.phase !== 'dead') {
      z.alert = Math.max(z.alert, 9);
      z.lastSeen = { x: p.x, y: p.y };
    }
    /* 听觉：贴近之后即使丢视线也会持续追击，不轻易脱战 */
    if (raid.phase !== 'dead' && d < z.t.hear * 0.6) z.alert = Math.max(z.alert, 3.2);
    z.alert = Math.max(0, z.alert - dt * 0.55);

    var moved = false;
    if (z.alert > 0 && raid.phase !== 'dead') {
      var dir = flowDir(m, z.x, z.y);
      var spd = z.t.spd * z.speedJit * (z.alert > 2 ? 1 : 0.86);
      if (dir) {
        var tx = z.x + dir[0] * spd * dt, ty = z.y + dir[1] * spd * dt;
        /* 贴近目标时直接朝玩家走，避免抖动 */
        if (d < 90 && losClear(m, z.x, z.y, p.x, p.y)) {
          var a0 = Math.atan2(p.y - z.y, p.x - z.x);
          tx = z.x + Math.cos(a0) * spd * dt; ty = z.y + Math.sin(a0) * spd * dt;
        }
        moveEnt(m, z, tx - z.x, ty - z.y);
        z.ang = Math.atan2(p.y - z.y, p.x - z.x);
        z.walk += dt * 6;
        moved = true;
      } else {
        var a1 = Math.atan2(p.y - z.y, p.x - z.x);
        moveEnt(m, z, Math.cos(a1) * spd * dt, Math.sin(a1) * spd * dt);
        z.ang = a1; z.walk += dt * 6; moved = true;
      }
      if (d < z.r + p.r + 10 && z.atkCd <= 0) {
        z.atkCd = z.t.atk;
        hurtPlayer(z.t.dmg, Math.atan2(z.y - p.y, z.x - p.x));
        burst(p.x, p.y, 6, '#b02b2b', 140);
        raid.shake = Math.min(12, raid.shake + 5);
      }
    } else {
      /* 游荡 */
      if (z.wanderT <= 0) { z.wander = rnd(0, Math.PI * 2); z.wanderT = rnd(1.5, 4); }
      var ws = z.t.spd * 0.28;
      var nx = z.x + Math.cos(z.wander) * ws * dt, ny = z.y + Math.sin(z.wander) * ws * dt;
      var beforeX = z.x, beforeY = z.y;
      moveEnt(m, z, nx - z.x, ny - z.y);
      if (Math.abs(z.x - beforeX) < 0.01 && Math.abs(z.y - beforeY) < 0.01) z.wanderT = 0;
      z.ang = z.wander;
    }
    if (moved) { /* 分离，避免堆叠 */
      for (var k = i - 1; k >= 0; k--) {
        var o = raid.zombies[k];
        if (o.dead) continue;
        var dd = dist(z.x, z.y, o.x, o.y), minD = z.r + o.r - 3;
        if (dd > 0.01 && dd < minD) {
          var push = (minD - dd) * 0.5;
          var pa = Math.atan2(z.y - o.y, z.x - o.x);
          moveEnt(m, z, Math.cos(pa) * push, Math.sin(pa) * push);
          moveEnt(m, o, -Math.cos(pa) * push, -Math.sin(pa) * push);
        }
      }
    }
  }
}

function updateBullets(dt) {
  var raid = G.raid, m = raid.map;
  for (var i = raid.bullets.length - 1; i >= 0; i--) {
    var b = raid.bullets[i];
    var stepx = b.vx * dt, stepy = b.vy * dt;
    var steps = Math.max(1, Math.ceil(Math.hypot(stepx, stepy) / 12));
    var hit = false;
    for (var s = 0; s < steps && !hit; s++) {
      b.x += stepx / steps; b.y += stepy / steps;
      if (isWallAt(m, b.x, b.y)) { burst(b.x, b.y, 4, '#b9b9a0', 80); hit = true; break; }
      for (var zi = 0; zi < raid.zombies.length; zi++) {
        var z = raid.zombies[zi];
        if (dist2(b.x, b.y, z.x, z.y) < (z.r + 3) * (z.r + 3)) {
          hurtZombie(z, b.dmg, Math.atan2(b.vy, b.vx), 34);
          hit = true; break;
        }
      }
    }
    b.life -= dt;
    if (hit || b.life <= 0) raid.bullets.splice(i, 1);
  }
}

function updateFx(dt) {
  var raid = G.raid;
  for (var i = raid.parts.length - 1; i >= 0; i--) {
    var p = raid.parts[i];
    p.t += dt; p.x += p.vx * dt; p.y += p.vy * dt;
    p.vx *= 0.92; p.vy *= 0.92;
    if (p.t >= p.life) raid.parts.splice(i, 1);
  }
  for (var j = raid.floaters.length - 1; j >= 0; j--) {
    var f = raid.floaters[j];
    f.t += dt; f.y -= dt * 26;
    if (f.t > 0.85) raid.floaters.splice(j, 1);
  }
  raid.shake = Math.max(0, raid.shake - dt * 26);
}

function updateRaid(dt) {
  updateSeen(dt);
  if (typeof SFX !== 'undefined' && G.raid && G.raid.p) {
    var rp = G.raid.p;
    if (typeof rp._px === 'number') {
      var md = Math.abs(rp.x - rp._px) + Math.abs(rp.y - rp._py);
      G.raid._stepT = (G.raid._stepT || 0) + dt;
      if (md > 0.6 && G.raid._stepT > 0.42) { G.raid._stepT = 0; SFX.step(); }
    }
    rp._px = rp.x; rp._py = rp.y;
  }
  var raid = G.raid; if (!raid) return;
  if (raid.phase === 'done' || raid.phase === 'dead') return;
  raid.time += dt;

  /* 撤离窗口：超时即被困在感染区 */
  if (raid.timeLimit && raid.time >= raid.timeLimit && raid.phase === 'explore') {
    addLog('撤离窗口已关闭，你被留在了感染区。');
    raid.timeout = true;
    endRaid(false);
    return;
  }

  updatePlayer(dt);
  updateZombies(dt);
  updateBullets(dt);
  updateFx(dt);

  /* 流场刷新 */
  raid.flowTimer -= dt;
  if (raid.flowTimer <= 0) {
    raid.flowTimer = 0.35;
    buildFlow(raid.map, clamp(Math.floor(raid.p.x / TILE), 0, MAPW - 1), clamp(Math.floor(raid.p.y / TILE), 0, MAPH - 1));
  }

  /* 撤离倒计时 */
  if (raid.phase === 'extracting' && raid.extracting) {
    var e = raid.extracting;
    e.timer -= dt;
    raid.objective = e.timer > 0.05 ? '坚守撤离点 ' + Math.ceil(e.timer) + ' 秒' : '撤离通道开启…';
    /* 三波定向尸潮：一波比一波凶，逼玩家开枪/换弹/走位 */
    raid.spawnTimer -= dt;
    if (raid.wave < 3 && raid.spawnTimer <= 0) {
      raid.wave++;
      raid.spawnTimer = 3.6;
      var cnt = 2 + raid.wave;
      var nc = 0;
      for (var wi = 0; wi < cnt; wi++) {
        var wa = rnd(0, Math.PI * 2), wr = rnd(320, 520);
        var zx = clamp(raid.p.x + Math.cos(wa) * wr, TILE * 2, MAPW * TILE - TILE * 2);
        var zy = clamp(raid.p.y + Math.sin(wa) * wr, TILE * 2, MAPH * TILE - TILE * 2);
        if (isWallAt(raid.map, zx, zy)) continue;
        var wt = 'walker';
        var rr2 = Math.random();
        if (raid.wave >= 3 && rr2 < 0.3) wt = 'brute';
        else if (rr2 < (raid.wave >= 2 ? 0.6 : 0.42)) wt = 'runner';
        spawnZombie(raid, zx, zy, wt); nc++;
      }
      if (nc > 0) { addLog('第 ' + raid.wave + ' 波尸潮逼近（' + nc + ' 只）！'); noiseEvent(raid.p.x, raid.p.y, 900); }
    }
    if (e.timer <= 0) {
      addLog('运输机降落，撤离完成。');
      endRaid(true);
      return;
    }
    if (dist(raid.p.x, raid.p.y, e.x, e.y) > 520) {
      e.state = 'idle'; e.prog = 0; raid.phase = 'explore'; raid.extracting = null;
      addLog('离开撤离区域，信号中断。');
    }
  }

  /* 环境压力：偶发尸群靠近 */
  if (raid.phase === 'explore') {
    raid.spawnTimer -= dt;
    if (raid.spawnTimer <= 0) {
      raid.spawnTimer = 26;
      if (raid.zombies.length < raid.cfg.zmax + 6) {
        var a = rnd(0, Math.PI * 2), r = rnd(700, 900);
        var sx = clamp(raid.p.x + Math.cos(a) * r, TILE * 2, MAPW * TILE - TILE * 2);
        var sy = clamp(raid.p.y + Math.sin(a) * r, TILE * 2, MAPH * TILE - TILE * 2);
        if (!isWallAt(raid.map, sx, sy)) spawnZombie(raid, sx, sy);
      }
    }
  }

  /* 相机 */
  var vw = G.viewW || 1280, vh = G.viewH || 720;
  raid.p.x = clamp(raid.p.x, 20, MAPW * TILE - 20);
  cam.x = lerp(cam.x, raid.p.x, 1 - Math.pow(0.0015, dt));
  cam.y = lerp(cam.y, raid.p.y, 1 - Math.pow(0.0015, dt));
  cam.x = clamp(cam.x, vw / 2, MAPW * TILE - vw / 2);
  cam.y = clamp(cam.y, vh / 2, MAPH * TILE - vh / 2);
  if (MAPW * TILE < vw) cam.x = MAPW * TILE / 2;
  if (MAPH * TILE < vh) cam.y = MAPH * TILE / 2;
}

/* =========================================================
   PART 4 —— 渲染层
   ========================================================= */

var cv = null, ctx = null, lightCv = null, lightCtx = null;
var W = 1280, H = 720, DPR = 1;

function initCanvas() {
  cv = document.getElementById('cv');
  ctx = cv.getContext('2d');
  lightCv = document.createElement('canvas');
  lightCtx = lightCv.getContext('2d');
  resizeCanvas();
  if (typeof window !== 'undefined' && window.addEventListener) window.addEventListener('resize', resizeCanvas);
}
function resizeCanvas() {
  DPR = Math.min(2, (typeof window !== 'undefined' && window.devicePixelRatio) || 1);
  W = (cv && cv.clientWidth) || (typeof window !== 'undefined' && window.innerWidth) || 1280;
  H = (cv && cv.clientHeight) || (typeof window !== 'undefined' && window.innerHeight) || 720;
  if (cv) { cv.width = Math.floor(W * DPR); cv.height = Math.floor(H * DPR); }
  if (lightCv) { lightCv.width = Math.floor(W * DPR); lightCv.height = Math.floor(H * DPR); }
  G.viewW = W; G.viewH = H;
}

var TILE_COLOR = {
  0: ['#141a12', '#171d14'], 1: ['#232527', '#26282a'], 2: ['#3c4148', '#2b3036'],
  3: ['#4a4034', '#3a322a'], 4: ['#2a2620', '#2f2a24']
};

/* ================= 小地图 · 建筑探索 ================= */
var miniCv = null, miniCtx = null, miniTick = 0;

function ensureMini() {
  if (miniCv) return;
  if (typeof document === 'undefined' || !document.getElementById) return;
  miniCv = document.getElementById('minimap');
  if (miniCv) miniCtx = miniCv.getContext('2d');
}

/* 返回包含该格的建筑（含外墙一圈） */
function buildingAt(tx, ty) {
  var raid = G.raid;
  if (!raid || !raid.map || !raid.map.buildings) return null;
  var bs = raid.map.buildings, i;
  for (i = 0; i < bs.length; i++) {
    var b = bs[i];
    if (tx >= b.x && tx <= b.x + b.w - 1 && ty >= b.y && ty <= b.y + b.h - 1) return b;
  }
  return null;
}

/* 探索：室外只记视野内地表；未进入的建筑只记轮廓，不揭示内部；进入后揭示全貌 */
function updateSeen(dt) {
  var raid = G.raid;
  if (!raid || !raid.map || !raid.p) return;
  var m = raid.map, p = raid.p, i, j;
  if (!m.seen) m.seen = new Uint8Array(MAPW * MAPH);
  var ptx = Math.floor(p.x / TILE), pty = Math.floor(p.y / TILE), R = 7;
  for (j = pty - R; j <= pty + R; j++) {
    if (j < 0 || j >= MAPH) continue;
    for (i = ptx - R; i <= ptx + R; i++) {
      if (i < 0 || i >= MAPW) continue;
      if ((i - ptx) * (i - ptx) + (j - pty) * (j - pty) > R * R) continue;
      var b = buildingAt(i, j);
      if (b && !b.visited && i > b.x && i < b.x + b.w - 1 && j > b.y && j < b.y + b.h - 1) continue;
      m.seen[j * MAPW + i] = 1;
    }
  }
  var cur = buildingAt(ptx, pty);
  if (cur && !cur.visited) {
    cur.visited = true;
    for (j = cur.y; j < cur.y + cur.h; j++) {
      for (i = cur.x; i < cur.x + cur.w; i++) m.seen[j * MAPW + i] = 1;
    }
    if (typeof SFX !== 'undefined') SFX.door();
    if (typeof showTipMsg === 'function') showTipMsg('推开 ' + cur.name + ' 的门 —— 内部格局已在地图点亮');
  }
  raid.inBuilding = cur || null;
}

function revealAll() {
  var raid = G.raid;
  if (!raid || !raid.map) return;
  var m = raid.map, i;
  if (!m.seen) m.seen = new Uint8Array(MAPW * MAPH);
  for (i = 0; i < m.seen.length; i++) m.seen[i] = 1;
  if (m.buildings) for (i = 0; i < m.buildings.length; i++) m.buildings[i].visited = true;
}

/* 建筑标志：医院十字 / 警局盾牌 / 消防火焰 / 居民楼窗格 / 学校书本 / 仓储木箱 */
function drawBldIcon(c2, cx, cy, s, ic, color) {
  if (!(s > 0)) return;
  c2.save();
  c2.translate(cx, cy);
  c2.strokeStyle = color; c2.fillStyle = color;
  c2.lineWidth = Math.max(1.6, s * 0.22);
  c2.lineCap = 'round'; c2.lineJoin = 'round';
  var h = s * 0.5;
  if (ic === 'cross') {
    c2.beginPath();
    c2.moveTo(-h, 0); c2.lineTo(h, 0);
    c2.moveTo(0, -h); c2.lineTo(0, h);
    c2.stroke();
  } else if (ic === 'shield') {
    c2.beginPath();
    c2.moveTo(0, -h); c2.lineTo(h * 0.86, -h * 0.55);
    c2.lineTo(h * 0.86, h * 0.2);
    c2.quadraticCurveTo(h * 0.7, h * 0.85, 0, h);
    c2.quadraticCurveTo(-h * 0.7, h * 0.85, -h * 0.86, h * 0.2);
    c2.lineTo(-h * 0.86, -h * 0.55);
    c2.closePath(); c2.stroke();
  } else if (ic === 'flame') {
    c2.beginPath();
    c2.moveTo(0, -h);
    c2.quadraticCurveTo(h * 0.9, -h * 0.1, 0, h);
    c2.quadraticCurveTo(-h * 0.9, -h * 0.1, 0, -h);
    c2.closePath(); c2.stroke();
    c2.beginPath();
    c2.moveTo(0, -h * 0.1); c2.quadraticCurveTo(h * 0.4, h * 0.35, 0, h * 0.85);
    c2.stroke();
  } else if (ic === 'window') {
    c2.strokeRect(-h * 0.9, -h * 0.9, h * 1.8, h * 1.8);
    c2.beginPath();
    c2.moveTo(0, -h * 0.9); c2.lineTo(0, h * 0.9);
    c2.moveTo(-h * 0.9, 0); c2.lineTo(h * 0.9, 0);
    c2.stroke();
  } else if (ic === 'book') {
    c2.beginPath();
    c2.moveTo(-h, -h * 0.7); c2.lineTo(0, -h * 0.35); c2.lineTo(h, -h * 0.7);
    c2.lineTo(h, h * 0.7); c2.lineTo(0, h * 0.35); c2.lineTo(-h, h * 0.7);
    c2.closePath(); c2.stroke();
    c2.beginPath(); c2.moveTo(0, -h * 0.35); c2.lineTo(0, h * 0.35); c2.stroke();
  } else {
    c2.strokeRect(-h * 0.85, -h * 0.85, h * 1.7, h * 1.7);
    c2.beginPath();
    c2.moveTo(-h * 0.85, -h * 0.85); c2.lineTo(h * 0.85, h * 0.85);
    c2.moveTo(h * 0.85, -h * 0.85); c2.lineTo(-h * 0.85, h * 0.85);
    c2.stroke();
  }
  c2.restore();
}

/* 小地图：以玩家为中心的 60x60 格窗口，显示玩家 / 建筑轮廓 / 已探明内部 / 撤离点 */
function drawMinimap() {
  ensureMini();
  if (!miniCtx) return;
  var raid = G.raid;
  if (!raid || !raid.map || !raid.p) return;
  var m = raid.map, p = raid.p;
  if (!m.seen) m.seen = new Uint8Array(MAPW * MAPH);
  var Wp = miniCv.width, Hp = miniCv.height, view = 60, sc = Wp / view;
  var ptx = p.x / TILE, pty = p.y / TILE;
  var ox = ptx - view / 2, oy = pty - view / 2;
  miniCtx.clearRect(0, 0, Wp, Hp);
  miniCtx.fillStyle = '#080b07';
  miniCtx.fillRect(0, 0, Wp, Hp);
  miniCtx.textAlign = 'center';
  miniCtx.textBaseline = 'middle';

  var x0 = Math.floor(ox), y0 = Math.floor(oy), tx, ty;
  for (ty = y0; ty < y0 + view + 1; ty++) {
    if (ty < 0 || ty >= MAPH) continue;
    for (tx = x0; tx < x0 + view + 1; tx++) {
      if (tx < 0 || tx >= MAPW) continue;
      var idx = ty * MAPW + tx, seen = m.seen[idx];
      if (!seen) continue;
      var px = (tx - ox) * sc, py = (ty - oy) * sc;
      var b = buildingAt(tx, ty);
      if (b && !b.visited) {
        /* 未进入：只有屋顶外形 + 类型色，看不到内部细节 */
        var isEdge = (tx === b.x || tx === b.x + b.w - 1 || ty === b.y || ty === b.y + b.h - 1);
        miniCtx.globalAlpha = isEdge ? 0.95 : 0.5;
        miniCtx.fillStyle = (BLD[b.type] ? BLD[b.type].c : '#6a7480');
        miniCtx.fillRect(px, py, sc + 0.6, sc + 0.6);
        miniCtx.globalAlpha = 1;
        if (tx === Math.floor(b.x + b.w / 2) && ty === Math.floor(b.y + b.h / 2)) {
          miniCtx.fillStyle = '#f2f7ea';
          miniCtx.font = 'bold 9px "Microsoft YaHei",sans-serif';
          miniCtx.fillText(BLD[b.type] ? BLD[b.type].tag : '?', px + sc / 2, py + sc / 2 + 0.5);
        }
        continue;
      }
      var t = m.tiles[idx];
      if (b && b.visited) {
        if (t === 2) miniCtx.fillStyle = '#4c5862';
        else if (t === 3) miniCtx.fillStyle = '#d8b04e';
        else miniCtx.fillStyle = '#39472f';
      } else {
        if (t === 2) miniCtx.fillStyle = '#3d454c';
        else if (t === 3) miniCtx.fillStyle = '#c8a24a';
        else if (t === 4) miniCtx.fillStyle = '#2b3627';
        else if (t === 1) miniCtx.fillStyle = '#1e2418';
        else if (t === 5) miniCtx.fillStyle = '#25301c';
        else miniCtx.fillStyle = '#161c12';
      }
      miniCtx.fillRect(px, py, sc + 0.6, sc + 0.6);
    }
  }

  /* 撤离点 */
  var ei, ex, ey, epx, epy;
  for (ei = 0; ei < (m.exits || []).length; ei++) {
    ex = m.exits[ei];
    var etx = ex.x < MAPW ? ex.x : ex.x / TILE, ety = ex.y < MAPH ? ex.y : ex.y / TILE;
    if (!m.seen[Math.floor(ety) * MAPW + Math.floor(etx)]) continue;
    epx = (etx - ox) * sc; epy = (ety - oy) * sc;
    miniCtx.strokeStyle = '#7fd94a'; miniCtx.lineWidth = 2;
    miniCtx.beginPath(); miniCtx.arc(epx, epy, Math.max(3, sc * 0.9), 0, 6.29); miniCtx.stroke();
  }

  /* 玩家 */
  var ppx = (ptx - ox) * sc, ppy = (pty - oy) * sc;
  miniCtx.fillStyle = 'rgba(183,240,106,0.22)';
  miniCtx.beginPath(); miniCtx.arc(ppx, ppy, Math.max(6, sc * 2.4), 0, 6.29); miniCtx.fill();
  miniCtx.fillStyle = '#c8ff6a';
  miniCtx.beginPath(); miniCtx.arc(ppx, ppy, Math.max(2.4, sc * 0.55), 0, 6.29); miniCtx.fill();
  miniCtx.strokeStyle = '#0b0f08'; miniCtx.lineWidth = 1; miniCtx.stroke();

  /* 进入建筑高亮边框 */
  if (miniCv.classList) {
    if (raid.inBuilding) miniCv.classList.add('enter'); else miniCv.classList.remove('enter');
  }
}

/* 丧尸外观：不同种类不同体态，血量/伤害差异一眼可辨 */
function drawZombieBody(c2, z, swing) {
  var col = z.hurt > 0 ? '#ffe0d0' : z.t.c;
  var type = z.type || 'walker';
  c2.save();
  /* 共同阴影 */
  c2.fillStyle = 'rgba(0,0,0,0.35)';
  c2.beginPath();
  c2.ellipse(z.x, z.y + z.r * 0.8, z.r * 0.95, z.r * 0.42, 0, 0, Math.PI * 2);
  c2.fill();

  if (type === 'dog') {
    /* 僵尸犬：四足细长身体 + 头 + 尾 */
    c2.translate(z.x, z.y);
    c2.rotate(z.ang);
    c2.fillStyle = col;
    c2.beginPath(); c2.ellipse(0, 0, z.r * 1.4, z.r * 0.68, 0, 0, Math.PI * 2); c2.fill();
    c2.strokeStyle = 'rgba(0,0,0,0.45)'; c2.lineWidth = 1.6; c2.stroke();
    c2.beginPath(); c2.arc(z.r * 1.28, 0, z.r * 0.6, 0, Math.PI * 2); c2.fill(); c2.stroke();
    c2.strokeStyle = col; c2.lineWidth = 2.4;
    c2.beginPath();
    for (var li = 0; li < 4; li++) {
      var lx = (li < 2 ? 1 : -0.9) * z.r * 0.72;
      var ly = (li % 2 ? 1 : -1) * z.r * 0.55;
      c2.moveTo(lx, ly);
      c2.lineTo(lx + Math.sin(swing + li * 1.6) * 4, ly + z.r * 0.5);
    }
    c2.stroke();
    c2.beginPath();
    c2.moveTo(-z.r * 1.3, 0);
    c2.lineTo(-z.r * 1.85, Math.sin(swing) * 4);
    c2.lineWidth = 2.6; c2.stroke();
    c2.fillStyle = '#ff5252';
    c2.beginPath(); c2.arc(z.r * 1.45, -2.2, 1.4, 0, 6.29); c2.fill();
    c2.beginPath(); c2.arc(z.r * 1.45, 2.2, 1.4, 0, 6.29); c2.fill();
  } else if (type === 'crawler') {
    /* 爬行：扁平身体拖着双腿 */
    c2.fillStyle = col;
    c2.beginPath(); c2.ellipse(z.x, z.y, z.r * 1.2, z.r * 0.62, z.ang, 0, Math.PI * 2); c2.fill();
    c2.strokeStyle = 'rgba(0,0,0,0.45)'; c2.lineWidth = 1.6; c2.stroke();
    c2.strokeStyle = col; c2.lineWidth = 2.6;
    c2.beginPath();
    c2.moveTo(z.x - Math.cos(z.ang) * z.r * 1.1, z.y - Math.sin(z.ang) * z.r * 1.1);
    c2.lineTo(z.x - Math.cos(z.ang) * (z.r * 1.1 + 8) + Math.sin(swing) * 3,
      z.y - Math.sin(z.ang) * (z.r * 1.1 + 8) + Math.cos(swing) * 3);
    c2.moveTo(z.x - Math.cos(z.ang) * z.r * 1.1, z.y - Math.sin(z.ang) * z.r * 1.1);
    c2.lineTo(z.x - Math.cos(z.ang) * (z.r * 1.1 + 6) - Math.sin(swing) * 3,
      z.y - Math.sin(z.ang) * (z.r * 1.1 + 6) - Math.cos(swing) * 3);
    c2.stroke();
    c2.strokeStyle = col; c2.lineWidth = 3;
    c2.beginPath();
    c2.moveTo(z.x, z.y);
    c2.lineTo(z.x + Math.cos(z.ang) * (z.r + 8), z.y + Math.sin(z.ang) * (z.r + 8));
    c2.stroke();
    c2.fillStyle = '#ff5252';
    c2.beginPath();
    c2.arc(z.x + Math.cos(z.ang - 0.25) * z.r * 0.55, z.y + Math.sin(z.ang - 0.25) * z.r * 0.55, 1.7, 0, 6.29);
    c2.arc(z.x + Math.cos(z.ang + 0.25) * z.r * 0.55, z.y + Math.sin(z.ang + 0.25) * z.r * 0.55, 1.7, 0, 6.29);
    c2.fill();
  } else if (type === 'slow') {
    /* 缓慢：臃肿迟缓，双臂下垂 */
    c2.fillStyle = col;
    c2.beginPath(); c2.arc(z.x, z.y, z.r * 1.06, 0, Math.PI * 2); c2.fill();
    c2.strokeStyle = 'rgba(0,0,0,0.5)'; c2.lineWidth = 2; c2.stroke();
    c2.strokeStyle = 'rgba(0,0,0,0.22)'; c2.lineWidth = 3;
    c2.beginPath(); c2.arc(z.x, z.y, z.r * 0.62, 0, Math.PI * 2); c2.stroke();
    c2.strokeStyle = col; c2.lineWidth = z.r * 0.42;
    c2.beginPath();
    c2.moveTo(z.x, z.y);
    c2.lineTo(z.x + Math.cos(z.ang + 1.15) * (z.r + 6), z.y + Math.sin(z.ang + 1.15) * (z.r + 6));
    c2.moveTo(z.x, z.y);
    c2.lineTo(z.x + Math.cos(z.ang - 1.15) * (z.r + 6), z.y + Math.sin(z.ang - 1.15) * (z.r + 6));
    c2.stroke();
    c2.fillStyle = '#ff6a4a';
    c2.beginPath();
    c2.arc(z.x + Math.cos(z.ang - 0.3) * z.r * 0.5, z.y + Math.sin(z.ang - 0.3) * z.r * 0.5, 2, 0, 6.29);
    c2.arc(z.x + Math.cos(z.ang + 0.3) * z.r * 0.5, z.y + Math.sin(z.ang + 0.3) * z.r * 0.5, 2, 0, 6.29);
    c2.fill();
  } else {
    /* 行尸 / 跑步丧尸 / 暴君：原体态，跑步者加前倾冲刺线 */
    c2.fillStyle = col;
    c2.beginPath(); c2.arc(z.x, z.y, z.r, 0, Math.PI * 2); c2.fill();
    c2.strokeStyle = 'rgba(0,0,0,0.45)';
    c2.lineWidth = 2; c2.stroke();
    c2.strokeStyle = col;
    c2.lineWidth = z.r * 0.4;
    c2.beginPath();
    c2.moveTo(z.x, z.y);
    c2.lineTo(z.x + Math.cos(z.ang) * (z.r + 7) + swing * 0.4, z.y + Math.sin(z.ang) * (z.r + 7));
    c2.stroke();
    if (type === 'runner') {
      c2.strokeStyle = 'rgba(255,170,120,0.45)';
      c2.lineWidth = 1.6;
      c2.beginPath();
      c2.moveTo(z.x - Math.cos(z.ang) * z.r, z.y - Math.sin(z.ang) * z.r);
      c2.lineTo(z.x - Math.cos(z.ang) * (z.r + 9), z.y - Math.sin(z.ang) * (z.r + 9));
      c2.stroke();
    }
    if (type === 'brute') {
      c2.strokeStyle = 'rgba(0,0,0,0.3)';
      c2.lineWidth = 3;
      c2.beginPath(); c2.arc(z.x, z.y, z.r * 0.6, 0, Math.PI * 2); c2.stroke();
    }
    c2.fillStyle = '#ff5252';
    c2.beginPath();
    c2.arc(z.x + Math.cos(z.ang - 0.3) * z.r * 0.5, z.y + Math.sin(z.ang - 0.3) * z.r * 0.5, 1.8, 0, 6.29);
    c2.arc(z.x + Math.cos(z.ang + 0.3) * z.r * 0.5, z.y + Math.sin(z.ang + 0.3) * z.r * 0.5, 1.8, 0, 6.29);
    c2.fill();
  }
  c2.restore();
}

/* ---------- 手持武器绘制：不同武器 = 不同外形，近战含挥击动画 ---------- */
function drawHeldWeapon(g, p, wid, w) {
  var sw = p.swing;
  var prog = sw ? Math.min(1, sw.t / sw.dur) : 0;
  var extra = 0;
  if (sw) {
    /* 抬手蓄力 -> 横扫 -> 收势 */
    if (prog < 0.32) extra = -0.95 * (prog / 0.32);
    else extra = -0.95 + 2.0 * ((prog - 0.32) / 0.68);
  }
  var baseAng = sw ? sw.ang : p.ang;
  var flash = p.flash > 0;

  g.save();
  g.translate(p.x, p.y);
  g.rotate(baseAng + extra);
  g.lineCap = 'round';

  if (wid === 'crowbar') {
    g.strokeStyle = '#b7bec4'; g.lineWidth = 4.2;
    g.beginPath(); g.moveTo(5, 0); g.lineTo(31, 0); g.stroke();
    g.lineWidth = 3.2;
    g.beginPath(); g.moveTo(31, 0); g.lineTo(37, -6); g.lineTo(42, -3); g.stroke();
    g.fillStyle = '#7d858c'; g.fillRect(2, -4, 6, 8);
  } else if (wid === 'axe') {
    g.strokeStyle = '#8a6a44'; g.lineWidth = 4.2;
    g.beginPath(); g.moveTo(4, 0); g.lineTo(33, 0); g.stroke();
    g.fillStyle = '#8f2f22';
    g.beginPath(); g.moveTo(30, 0); g.lineTo(39, -12); g.lineTo(45, -2); g.lineTo(39, 9); g.closePath(); g.fill();
    g.fillStyle = '#e8eef2';
    g.beginPath(); g.moveTo(39, -12); g.lineTo(45, -2); g.lineTo(39, 9); g.closePath(); g.fill();
    g.fillStyle = '#5f4a30'; g.fillRect(2, -4, 6, 8);
  } else if (wid === 'pistol') {
    g.fillStyle = '#2b3036'; g.fillRect(6, -3.5, 20, 7);
    g.fillStyle = '#1d2226'; g.fillRect(6, 2, 7, 9);
    g.fillStyle = '#4c565e'; g.fillRect(24, -2.5, 7, 5);
    if (flash) { g.fillStyle = 'rgba(255,214,120,0.9)'; g.beginPath(); g.arc(33, 0, 8, 0, 6.29); g.fill(); }
  } else if (wid === 'shotgun') {
    g.fillStyle = '#6a4a30'; g.fillRect(1, -4.5, 17, 9);
    g.fillStyle = '#33393f'; g.fillRect(17, -5, 30, 5);
    g.fillStyle = '#272c31'; g.fillRect(17, 0, 26, 4.5);
    g.fillStyle = '#4c565e'; g.fillRect(45, -4, 5, 8);
    if (flash) {
      g.fillStyle = 'rgba(255,214,120,0.9)';
      g.beginPath(); g.arc(52, -2.5, 10, 0, 6.29); g.arc(52, 2.5, 10, 0, 6.29); g.fill();
    }
  } else {
    g.fillStyle = '#5a4128'; g.fillRect(0, -4.5, 15, 9);
    g.fillStyle = '#2f353b'; g.fillRect(15, -4, 33, 8);
    g.fillStyle = '#22272b'; g.fillRect(24, 4, 9, 12);
    g.fillStyle = '#4c565e'; g.fillRect(45, -2.5, 12, 5);
    if (flash) { g.fillStyle = 'rgba(255,214,120,0.9)'; g.beginPath(); g.arc(57, 0, 9, 0, 6.29); g.fill(); }
  }

  /* 手：近战单手，长枪双手 */
  g.fillStyle = '#dbe4e8';
  g.beginPath(); g.arc(10, w.melee ? 4 : 5, 3.8, 0, 6.29); g.fill();
  if (!w.melee) { g.beginPath(); g.arc(24, 5, 3.2, 0, 6.29); g.fill(); }
  g.restore();

  /* 挥击轨迹扇形 */
  if (sw) {
    var a0 = sw.ang - sw.arc, a1 = sw.ang + sw.arc;
    var cur = a0 + (a1 - a0) * Math.min(1, prog / 0.58);
    g.save();
    g.translate(p.x, p.y);
    g.globalAlpha = 0.20 * (1 - prog * 0.5);
    g.fillStyle = '#e4edf2';
    g.beginPath(); g.moveTo(0, 0); g.arc(0, 0, sw.range * 0.92, a0, cur, false); g.closePath(); g.fill();
    g.globalAlpha = 0.75 * (1 - prog * 0.4);
    g.strokeStyle = '#ffffff'; g.lineWidth = 2.6;
    g.beginPath(); g.arc(0, 0, sw.range * 0.92, Math.max(a0, cur - 0.4), cur, false); g.stroke();
    g.restore();
  }
}

function render() {
  if (!ctx) return;
  var raid = G.raid;
  ctx.setTransform(DPR, 0, 0, DPR, 0, 0);
  ctx.fillStyle = '#07090a';
  ctx.fillRect(0, 0, W, H);
  if (!raid) return;

  var p = raid.p, m = raid.map;
  var shakeX = 0, shakeY = 0;
  if (raid.shake > 0.2) { shakeX = rnd(-raid.shake, raid.shake); shakeY = rnd(-raid.shake, raid.shake); }
  var ox = Math.round(W / 2 - cam.x + shakeX), oy = Math.round(H / 2 - cam.y + shakeY);
  ctx.save();
  ctx.translate(ox, oy);

  var tx0 = Math.floor((cam.x - W / 2) / TILE) - 1, tx1 = Math.ceil((cam.x + W / 2) / TILE) + 1;
  var ty0 = Math.floor((cam.y - H / 2) / TILE) - 1, ty1 = Math.ceil((cam.y + H / 2) / TILE) + 1;
  tx0 = clamp(tx0, 0, MAPW - 1); tx1 = clamp(tx1, 0, MAPW - 1);
  ty0 = clamp(ty0, 0, MAPH - 1); ty1 = clamp(ty1, 0, MAPH - 1);

  if (G.raid && G.screen === 'raid') drawMinimap();
  /* 地面 */
  for (var ty = ty0; ty <= ty1; ty++) {
    for (var tx = tx0; tx <= tx1; tx++) {
      var t = m.tiles[ty * MAPW + tx];
      var col = TILE_COLOR[t] || TILE_COLOR[0];
      ctx.fillStyle = ((tx + ty) % 2 === 0) ? col[0] : col[1];
      ctx.fillRect(tx * TILE, ty * TILE, TILE, TILE);
      if (t === 4) {
        ctx.strokeStyle = 'rgba(0,0,0,0.16)';
        ctx.lineWidth = 1;
        ctx.strokeRect(tx * TILE + 0.5, ty * TILE + 0.5, TILE - 1, TILE - 1);
      }
    }
  }
  /* 墙体 */
  for (var ty2 = ty0; ty2 <= ty1; ty2++) {
    for (var tx2 = tx0; tx2 <= tx1; tx2++) {
      var t2 = m.tiles[ty2 * MAPW + tx2];
      if (t2 !== 2 && t2 !== 3) continue;
      var x0 = tx2 * TILE, y0 = ty2 * TILE;
      if (t2 === 2) {
        ctx.fillStyle = '#3b4147';
        ctx.fillRect(x0, y0, TILE, TILE);
        ctx.fillStyle = 'rgba(255,255,255,0.06)';
        ctx.fillRect(x0, y0, TILE, 4);
        ctx.strokeStyle = '#22262b';
        ctx.lineWidth = 1;
        ctx.strokeRect(x0 + 0.5, y0 + 0.5, TILE - 1, TILE - 1);
      } else {
        /* 破门 / 门洞：可通行 */
        ctx.fillStyle = '#241d15';
        ctx.fillRect(x0 + 1, y0 + 1, TILE - 2, TILE - 2);
        ctx.strokeStyle = '#7a6244';
        ctx.lineWidth = 3;
        ctx.beginPath();
        ctx.moveTo(x0 + 4, y0 + 3); ctx.lineTo(x0 + 4, y0 + TILE - 3);
        ctx.moveTo(x0 + TILE - 4, y0 + 3); ctx.lineTo(x0 + TILE - 4, y0 + TILE - 3);
        ctx.stroke();
      }
    }
  }

  /* 容器 */
  for (var ci = 0; ci < m.containers.length; ci++) {
    var c = m.containers[ci];
    if (c.x < cam.x - W / 2 - 60 || c.x > cam.x + W / 2 + 60) continue;
    if (c.y < cam.y - H / 2 - 60 || c.y > cam.y + H / 2 + 60) continue;
    var cc = { cabinet: '#6b5233', fridge: '#4d6270', toolbox: '#7a4a35', medbox: '#7a3d3d', crate: '#6d5a38' }[c.type] || '#6b5233';
    ctx.fillStyle = c.searched ? '#332c22' : cc;
    ctx.fillRect(c.x - 11, c.y - 10, 22, 20);
    ctx.strokeStyle = c.searched ? '#413730' : '#a98a58';
    ctx.lineWidth = 1.5;
    ctx.strokeRect(c.x - 11.5, c.y - 10.5, 23, 21);
    if (!c.searched) {
      ctx.fillStyle = '#e8d9a8';
      ctx.fillRect(c.x - 2, c.y - 3, 4, 6);
    }
    if (c.prog > 0 && c.prog < 1.4) {
      ctx.fillStyle = 'rgba(0,0,0,0.6)';
      ctx.fillRect(c.x - 16, c.y - 24, 32, 4);
      ctx.fillStyle = '#c9e07a';
      ctx.fillRect(c.x - 16, c.y - 24, 32 * clamp(c.prog / 1.4, 0, 1), 4);
    }
  }

  /* 撤离点 */
  for (var ei = 0; ei < m.exits.length; ei++) {
    var e = m.exits[ei];
    if (e.x < cam.x - W / 2 - 200 || e.x > cam.x + W / 2 + 200) continue;
    if (e.y < cam.y - H / 2 - 200 || e.y > cam.y + H / 2 + 200) continue;
    var pulse = 0.5 + 0.5 * Math.sin(raid.time * 3);
    var active = e.state === 'active';
    ctx.save();
    ctx.globalAlpha = 0.14 + pulse * 0.12;
    ctx.fillStyle = active ? '#ff8a3d' : '#5ad06a';
    ctx.beginPath(); ctx.arc(e.x, e.y, 62 + pulse * 8, 0, Math.PI * 2); ctx.fill();
    ctx.restore();
    ctx.strokeStyle = active ? '#ff9a4d' : '#8dff9c';
    ctx.lineWidth = 2;
    ctx.beginPath(); ctx.arc(e.x, e.y, 34, 0, Math.PI * 2); ctx.stroke();
    ctx.fillStyle = active ? '#ffb072' : '#9df0a8';
    ctx.beginPath(); ctx.arc(e.x, e.y, 8 + pulse * 2, 0, Math.PI * 2); ctx.fill();
    ctx.font = '12px "Microsoft YaHei"';
    ctx.textAlign = 'center';
    ctx.fillStyle = active ? '#ffd0a0' : '#a8f0b0';
    ctx.fillText(active ? '撤离 ' + Math.ceil(e.timer) + 's' : '撤离点', e.x, e.y - 46);
    if (e.prog > 0 && e.state === 'idle') {
      ctx.fillStyle = 'rgba(0,0,0,0.6)';
      ctx.fillRect(e.x - 30, e.y - 66, 60, 6);
      ctx.fillStyle = '#ffd27a';
      ctx.fillRect(e.x - 30, e.y - 66, 60 * clamp(e.prog / 6, 0, 1), 6);
    }
  }

  /* 未进入的建筑：屋顶遮挡，进入前看不到内部 */
  if (m.buildings) {
    for (var roof_i = 0; roof_i < m.buildings.length; roof_i++) {
      var roof_b = m.buildings[roof_i];
      if (roof_b.visited) continue;
      var roof_x = roof_b.x * TILE, roof_y = roof_b.y * TILE;
      var roof_w = roof_b.w * TILE, roof_h = roof_b.h * TILE;
      if (roof_x > cam.x + W / 2 || roof_x + roof_w < cam.x - W / 2) continue;
      if (roof_y > cam.y + H / 2 || roof_y + roof_h < cam.y - H / 2) continue;
      var roof_c = BLD[roof_b.type] ? BLD[roof_b.type].c : '#6a7480';
      ctx.save();
      ctx.globalAlpha = 0.86;
      /* 屋面路径减去门洞：门在屋顶上呈缺口，不再被屋顶盖住 */
      var roof_doors = roof_b.doors || [];
      ctx.beginPath();
      roundPath(ctx, roof_x + 2, roof_y + 2, roof_w - 4, roof_h - 4, 7);
      for (var rd_i = 0; rd_i < roof_doors.length; rd_i++) {
        var rd = roof_doors[rd_i];
        var rdsp = rd.span || { x1: rd.x, x2: rd.x, y1: rd.y, y2: rd.y };
        ctx.rect(rdsp.x1 * TILE, rdsp.y1 * TILE, (rdsp.x2 - rdsp.x1 + 1) * TILE, (rdsp.y2 - rdsp.y1 + 1) * TILE);
      }
      ctx.fillStyle = roof_c;
      ctx.fill('evenodd');
      /* 斜向瓦纹替代原方格网，减少“一堆方块”的观感 */
      ctx.save();
      ctx.clip('evenodd');
      ctx.strokeStyle = 'rgba(0,0,0,0.15)';
      ctx.lineWidth = 1;
      ctx.beginPath();
      for (var rt = -roof_h; rt < roof_w; rt += 9) {
        ctx.moveTo(roof_x + rt, roof_y + roof_h);
        ctx.lineTo(roof_x + rt + roof_h, roof_y);
      }
      ctx.stroke();
      ctx.restore();
      ctx.globalAlpha = 1;
      /* 屋檐：深色外沿 + 门洞内沿高亮，代替原先的白描边方框 */
      ctx.strokeStyle = 'rgba(0,0,0,0.45)';
      ctx.lineWidth = 3;
      ctx.beginPath();
      roundPath(ctx, roof_x + 2, roof_y + 2, roof_w - 4, roof_h - 4, 7);
      for (var rd2_i = 0; rd2_i < roof_doors.length; rd2_i++) {
        var rd2 = roof_doors[rd2_i];
        var rd2sp = rd2.span || { x1: rd2.x, x2: rd2.x, y1: rd2.y, y2: rd2.y };
        ctx.rect(rd2sp.x1 * TILE, rd2sp.y1 * TILE, (rd2sp.x2 - rd2sp.x1 + 1) * TILE, (rd2sp.y2 - rd2sp.y1 + 1) * TILE);
      }
      ctx.stroke();
      drawBldIcon(ctx, roof_x + roof_w / 2, roof_y + roof_h / 2 - TILE * 0.35,
        Math.min(roof_w, roof_h) * 0.2, BLD[roof_b.type] ? BLD[roof_b.type].ic : 'crate', 'rgba(255,255,255,0.85)');
      ctx.font = 'bold 13px "Microsoft YaHei",sans-serif';
      ctx.textAlign = 'center';
      var nm_w = ctx.measureText(roof_b.name).width + 14;
      var nm_x = roof_x + roof_w / 2 - nm_w / 2, nm_y = roof_y + roof_h / 2 + TILE * 0.55 - 12;
      ctx.fillStyle = 'rgba(10,14,8,0.62)';
      ctx.beginPath();
      roundPath(ctx, nm_x, nm_y, nm_w, 17, 8.5);
      ctx.fill();
      ctx.fillStyle = 'rgba(240,244,236,0.92)';
      ctx.fillText(roof_b.name, roof_x + roof_w / 2, roof_y + roof_h / 2 + TILE * 0.55);
      ctx.restore();
    }
  }

  /* 丧尸 */
  for (var zi = 0; zi < raid.zombies.length; zi++) {
    var z = raid.zombies[zi];
    if (z.x < cam.x - W / 2 - 80 || z.x > cam.x + W / 2 + 80) continue;
    if (z.y < cam.y - H / 2 - 80 || z.y > cam.y + H / 2 + 80) continue;
    drawZombieBody(ctx, z, Math.sin(z.walk) * 4);
    if (z.hp < z.maxHp) {
      ctx.fillStyle = 'rgba(0,0,0,0.55)';
      ctx.fillRect(z.x - z.r, z.y - z.r - 10, z.r * 2, 3.5);
      ctx.fillStyle = '#d94a4a';
      ctx.fillRect(z.x - z.r, z.y - z.r - 10, z.r * 2 * (z.hp / z.maxHp), 3.5);
    }
  }

  /* 玩家 */
  var psw = Math.sin(p.walkPhase) * 3;
  ctx.fillStyle = 'rgba(0,0,0,0.4)';
  ctx.beginPath(); ctx.ellipse(p.x, p.y + 11, 13, 6, 0, 0, Math.PI * 2); ctx.fill();
  if (p.armor) {
    ctx.strokeStyle = '#6f8f6f';
    ctx.lineWidth = 3;
    ctx.beginPath(); ctx.arc(p.x, p.y, p.r + 4, 0, Math.PI * 2); ctx.stroke();
  }
  ctx.fillStyle = p.hurtCd > 0.1 ? '#ffd9d9' : '#dbe4e8';
  ctx.beginPath(); ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2); ctx.fill();
  ctx.strokeStyle = '#8fa2ad'; ctx.lineWidth = 2; ctx.stroke();
  /* 腿 */
  ctx.fillStyle = '#9aa8b0';
  ctx.beginPath(); ctx.arc(p.x - 4 + psw * 0.3, p.y + 9, 3.4, 0, 6.29); ctx.fill();
  ctx.beginPath(); ctx.arc(p.x + 4 - psw * 0.3, p.y + 9, 3.4, 0, 6.29); ctx.fill();
  /* 武器：按当前手持武器绘制不同外形（切换武器后人物手持立刻变化） */
  var w = curWeapon();
  var wid = (p.cur && ITEMS[p.cur] && ITEMS[p.cur].wk) ? ITEMS[p.cur].wk : 'crowbar';
  drawHeldWeapon(ctx, p, wid, w);
  /* 换弹进度 */
  if (p.reloading > 0) {
    ctx.fillStyle = 'rgba(0,0,0,0.6)';
    ctx.fillRect(p.x - 20, p.y - 30, 40, 4);
    ctx.fillStyle = '#ffd27a';
    ctx.fillRect(p.x - 20, p.y - 30, 40 * (1 - p.reloading / p.reloadTotal), 4);
  }

  /* 子弹 */
  ctx.strokeStyle = '#ffe9a8';
  ctx.lineWidth = 1.6;
  for (var bi = 0; bi < raid.bullets.length; bi++) {
    var b = raid.bullets[bi];
    ctx.beginPath();
    ctx.moveTo(b.x, b.y);
    ctx.lineTo(b.x - b.vx * 0.012, b.y - b.vy * 0.012);
    ctx.stroke();
  }

  /* 粒子 */
  for (var pi = 0; pi < raid.parts.length; pi++) {
    var pt = raid.parts[pi];
    ctx.globalAlpha = clamp(1 - pt.t / pt.life, 0, 1);
    ctx.fillStyle = pt.c;
    ctx.fillRect(pt.x - 1.5, pt.y - 1.5, 3, 3);
  }
  ctx.globalAlpha = 1;

  /* 飘字 */
  ctx.font = 'bold 13px "Microsoft YaHei"';
  ctx.textAlign = 'center';
  for (var fi = 0; fi < raid.floaters.length; fi++) {
    var f = raid.floaters[fi];
    ctx.globalAlpha = clamp(1 - f.t / 0.85, 0, 1);
    ctx.fillStyle = f.c;
    ctx.fillText(f.txt, f.x, f.y);
  }
  ctx.globalAlpha = 1;

  ctx.restore();

  /* 光照遮罩 */
  if (lightCtx) {
    lightCtx.setTransform(DPR, 0, 0, DPR, 0, 0);
    lightCtx.globalCompositeOperation = 'source-over';
    lightCtx.fillStyle = 'rgba(11,16,15,0.55)';
    lightCtx.fillRect(0, 0, W, H);
    lightCtx.globalCompositeOperation = 'destination-out';

    var psx = p.x + ox, psy = p.y + oy;
    var g1 = lightCtx.createRadialGradient(psx, psy, 8, psx, psy, 310);
    g1.addColorStop(0, 'rgba(0,0,0,1)');
    g1.addColorStop(0.55, 'rgba(0,0,0,0.72)');
    g1.addColorStop(1, 'rgba(0,0,0,0)');
    lightCtx.fillStyle = g1;
    lightCtx.beginPath(); lightCtx.arc(psx, psy, 310, 0, Math.PI * 2); lightCtx.fill();

    var fx = psx + Math.cos(p.ang) * 90, fy = psy + Math.sin(p.ang) * 90;
    var g2 = lightCtx.createRadialGradient(fx, fy, 10, fx, fy, 350);
    g2.addColorStop(0, 'rgba(0,0,0,0.95)');
    g2.addColorStop(0.4, 'rgba(0,0,0,0.6)');
    g2.addColorStop(1, 'rgba(0,0,0,0)');
    lightCtx.fillStyle = g2;
    lightCtx.beginPath(); lightCtx.arc(fx, fy, 350, 0, Math.PI * 2); lightCtx.fill();

    for (var ei2 = 0; ei2 < m.exits.length; ei2++) {
      var e2 = m.exits[ei2];
      var ex = e2.x + ox, ey = e2.y + oy;
      if (ex < -100 || ey < -100 || ex > W + 100 || ey > H + 100) continue;
      var g3 = lightCtx.createRadialGradient(ex, ey, 4, ex, ey, 130);
      g3.addColorStop(0, 'rgba(0,0,0,0.85)');
      g3.addColorStop(1, 'rgba(0,0,0,0)');
      lightCtx.fillStyle = g3;
      lightCtx.beginPath(); lightCtx.arc(ex, ey, 130, 0, Math.PI * 2); lightCtx.fill();
    }
    if (p.flash > 0) {
      var g4 = lightCtx.createRadialGradient(fx, fy, 4, fx, fy, 440);
      g4.addColorStop(0, 'rgba(0,0,0,1)');
      g4.addColorStop(1, 'rgba(0,0,0,0)');
      lightCtx.fillStyle = g4;
      lightCtx.beginPath(); lightCtx.arc(fx, fy, 440, 0, Math.PI * 2); lightCtx.fill();
    }
    lightCtx.globalCompositeOperation = 'source-over';

    ctx.setTransform(1, 0, 0, 1, 0, 0);
    ctx.drawImage(lightCv, 0, 0);
    ctx.setTransform(DPR, 0, 0, DPR, 0, 0);
  }

  /* 门：屋顶上的缺口本身就是门，不额外绘制方块/描边/箭头/光斑；仅贴近时给一行淡字 */
  if (m.buildings) {
    for (var dg_i = 0; dg_i < m.buildings.length; dg_i++) {
      var dg_b = m.buildings[dg_i];
      if (!dg_b.doors) continue;
      for (var dg_j = 0; dg_j < dg_b.doors.length; dg_j++) {
        var dg_d = dg_b.doors[dg_j];
        if (tget(m, dg_d.x, dg_d.y) !== 3) continue;
        var dgsp = dg_d.span || { x1: dg_d.x, x2: dg_d.x, y1: dg_d.y, y2: dg_d.y };
        var dgcx = (dgsp.x1 + (dgsp.x2 - dgsp.x1 + 1) / 2) * TILE;
        var dgcy = (dgsp.y1 + (dgsp.y2 - dgsp.y1 + 1) / 2) * TILE;
        if (Math.hypot(dgcx - p.x, dgcy - p.y) > 120) continue;
        var dgdd = dg_d.dir || { x: 0, y: 1 };
        ctx.save();
        ctx.textAlign = 'center';
        ctx.font = '11px "Microsoft YaHei"';
        var dgtx = dgcx - dgdd.x * TILE * 0.9, dgty = dgcy - dgdd.y * TILE * 0.9;
        ctx.fillStyle = 'rgba(0,0,0,0.5)';
        ctx.fillText('门口', dgtx + 1, dgty + 1);
        ctx.fillStyle = 'rgba(255,226,180,0.8)';
        ctx.fillText('门口', dgtx, dgty);
        ctx.restore();
      }
    }
  }

  /* 撤离点方向指示 */
  ctx.save();
  for (var ei3 = 0; ei3 < m.exits.length; ei3++) {
    var e3 = m.exits[ei3];
    var dx = e3.x - p.x, dy = e3.y - p.y;
    var d3 = Math.hypot(dx, dy);
    if (d3 < 70) continue;
    var ang3 = Math.atan2(dy, dx);
    var rr = Math.min(W, H) * 0.36;
    var ix = W / 2 + Math.cos(ang3) * rr, iy = H / 2 + Math.sin(ang3) * rr;
    ctx.translate(ix, iy);
    ctx.rotate(ang3);
    ctx.globalAlpha = 0.85;
    ctx.fillStyle = e3.state === 'active' ? '#ff9a4d' : '#69e07a';
    ctx.beginPath(); ctx.moveTo(10, 0); ctx.lineTo(-6, 6); ctx.lineTo(-6, -6); ctx.closePath(); ctx.fill();
    ctx.setTransform(DPR, 0, 0, DPR, 0, 0);
    ctx.globalAlpha = 1;
    ctx.fillStyle = 'rgba(160,230,170,0.75)';
    ctx.font = '11px "Microsoft YaHei"';
    ctx.textAlign = 'center';
    ctx.font = 'bold 13px "Microsoft YaHei"';
    ctx.fillText('撤离点 ' + Math.round(d3 / 40) + 'm', ix, iy + 24);
  }
  ctx.restore();

  /* 受伤红边 */
  if (p.hp / p.maxHp < 0.45) {
    var a = (1 - p.hp / p.maxHp) * 0.5 + 0.12;
    var grd = ctx.createRadialGradient(W / 2, H / 2, Math.min(W, H) * 0.3, W / 2, H / 2, Math.max(W, H) * 0.62);
    grd.addColorStop(0, 'rgba(120,0,0,0)');
    grd.addColorStop(1, 'rgba(140,10,10,' + a.toFixed(2) + ')');
    ctx.fillStyle = grd;
    ctx.fillRect(0, 0, W, H);
  }
}

/* =========================================================
   PART 5 —— 界面 / 存档 / 输入 / 主循环
   ========================================================= */

var screenEl = null, hudEl = null;
var SAVE_KEY = 'deadextract_save_v1';          /* 旧版单槽档，仅用于迁移 */
var SAVE_PREFIX = 'deadextract_slot_';
var SLOT_COUNT = 3;
var CUR_SLOT_KEY = 'deadextract_cur_slot';
var curSlot = 0;

function slotKey(i) { return SAVE_PREFIX + i; }
function getCurSlot() {
  try {
    if (typeof localStorage === 'undefined') return 0;
    var v = localStorage.getItem(CUR_SLOT_KEY);
    if (v === null || v === undefined) return 0;
    v = parseInt(v, 10);
    if (v >= 0 && v < SLOT_COUNT) return v;
  } catch (e) {}
  return 0;
}
function setCurSlot(i) {
  curSlot = i;
  try { if (typeof localStorage !== 'undefined') localStorage.setItem(CUR_SLOT_KEY, String(i)); } catch (e) {}
}

function save() {
  try {
    if (typeof localStorage === 'undefined' || !G.base) return;
    G.base.slot = curSlot;
    G.base.savedAt = Date.now();
    G.base.ver = 3;
    localStorage.setItem(slotKey(curSlot), JSON.stringify(G.base));
  } catch (e) {}
}

function load(slot) {
  try {
    if (typeof localStorage === 'undefined') return false;
    if (slot === undefined || slot === null) slot = curSlot;
    var s = localStorage.getItem(slotKey(slot));
    if (!s && slot === 0) s = localStorage.getItem(SAVE_KEY);
    if (!s) return false;
    var b = JSON.parse(s), d = newBase();
    for (var k in d) if (b[k] === undefined) b[k] = d[k];
    if (!b.safehouse || typeof b.safehouse !== 'object') b.safehouse = {};
    if (!b.damaged || typeof b.damaged !== 'object') b.damaged = {};
    if (!b.tutorial || typeof b.tutorial !== 'object') b.tutorial = {};
    b.ver = 3; b.slot = slot;
    G.base = b;
    setCurSlot(slot);
    return true;
  } catch (e) { return false; }
}

function slotInfo(i) {
  try {
    if (typeof localStorage === 'undefined') return null;
    var s = localStorage.getItem(slotKey(i));
    if (!s && i === 0) s = localStorage.getItem(SAVE_KEY);
    if (!s) return null;
    var b = JSON.parse(s);
    return {
      day: b.day || 1, raids: b.raids || 0, extracts: b.extracts || 0,
      notes: (b.notes || []).length, savedAt: b.savedAt || 0, cur: i === getCurSlot()
    };
  } catch (e) { return null; }
}

function fmtTime(ts) {
  if (!ts) return '—';
  var d = new Date(ts);
  function p2(n) { return ('0' + n).slice(-2); }
  return d.getFullYear() + '-' + p2(d.getMonth() + 1) + '-' + p2(d.getDate()) + ' ' + p2(d.getHours()) + ':' + p2(d.getMinutes());
}

/* ---------- 设置 ---------- */
var SETTINGS_DEF = {
  master: { n: '主音量', min: 0, max: 1, step: 0.1, fmt: function (v) { return Math.round(v * 100) + '%'; } },
  sfx: { n: '音效', min: 0, max: 1, step: 0.1, fmt: function (v) { return Math.round(v * 100) + '%'; } },
  bgm: { n: '环境音', min: 0, max: 1, step: 0.1, fmt: function (v) { return Math.round(v * 100) + '%'; } },
  sens: { n: '鼠标灵敏度', min: 0.4, max: 2, step: 0.1, fmt: function (v) { return v.toFixed(1) + 'x'; } },
  crosshair: { n: '准星大小', min: 0, max: 2, step: 1, fmt: function (v) { return ['小', '中', '大'][v] || '中'; } },
  quality: { n: '画质', min: 0, max: 2, step: 1, fmt: function (v) { return ['低', '中', '高'][v] || '中'; } }
};

function getSettings() {
  var b = G.base; if (!b) return { master: 0.8, sfx: 0.8, bgm: 0.5, mute: false, sens: 1, crosshair: 1, quality: 2 };
  if (!b.settings || typeof b.settings !== 'object') b.settings = {};
  var s = b.settings;
  var dft = { master: 0.8, sfx: 0.8, bgm: 0.5, mute: false, sens: 1, crosshair: 1, quality: 2 };
  for (var k in dft) if (s[k] === undefined) s[k] = dft[k];
  return s;
}

function applySettings() {
  var s = getSettings();
  if (typeof SFX !== 'undefined' && SFX && SFX.sync) SFX.sync(s);
  return s;
}

function stepSetting(key, dir) {
  var s = getSettings();
  if (key === 'mute') { s.mute = !s.mute; applySettings(); save(); return true; }
  var def = SETTINGS_DEF[key];
  if (!def) return false;
  {
    var v = s[key] + dir * def.step;
    v = Math.max(def.min, Math.min(def.max, Math.round(v / def.step) * def.step));
    s[key] = Math.round(v * 1000) / 1000;
  }
  applySettings(); save();
  return true;
}

function initUI() {
  screenEl = document.getElementById('screen');
  hudEl = document.getElementById('hud');
  if (screenEl && screenEl.addEventListener) screenEl.addEventListener('click', onScreenClick);
  if (hudEl && hudEl.addEventListener) hudEl.addEventListener('click', onScreenClick);
}

function onScreenClick(ev) {
  if (typeof SFX !== 'undefined') { SFX.ensure(); SFX.click(); }
  var el = ev.target;
  while (el) {
    if (el.getAttribute && el.getAttribute('data-act')) {
      handleAction(el.getAttribute('data-act'), el.getAttribute('data-val'));
      return;
    }
    el = el.parentNode;
  }
}

function handleAction(act, val) {
  var b = G.base;
  switch (act) {
    case 'new':
      showScreen('slots'); break;
    case 'continue':
      if (load(getCurSlot())) showScreen('hub'); else showScreen('menu'); break;
    case 'slots': showScreen('slots'); break;
    case 'save': {
      var canSave = true;
      try { canSave = typeof localStorage !== 'undefined'; } catch (e) { canSave = false; }
      if (!canSave) { showTipMsg('当前环境禁止写入存档。'); break; }
      save();
      if (typeof SFX !== 'undefined') SFX.save();
      var st = G.base.savedAt ? new Date(G.base.savedAt) : new Date();
      var hh = ('0' + st.getHours()).slice(-2), mm = ('0' + st.getMinutes()).slice(-2);
      showTipMsg('已手动存档 · 槽 ' + (getCurSlot() + 1) + ' · 第 ' + b.day + ' 天 · ' + hh + ':' + mm);
      showScreen('hub');
      break;
    }
    case 'bag': openBag(); break;
    case 'bag_close': closeBag(); break;
    case 'loot_ok': confirmLoot(); break;
    case 'settings': showScreen('settings'); break;
    case 'setopt': {
      var pv = (val || '').split(':');
      stepSetting(pv[0], parseFloat(pv[1]) || 0);
      showScreen('settings'); break;
    }
    case 'back_from_settings': showScreen(G.base && G.base.raids > 0 ? 'hub' : 'menu'); break;
    case 'slot_new': {
      var sl = parseInt(val, 10) || 0;
      setCurSlot(sl);
      G.base = newBase(); G.base.slot = sl; save();
      showScreen('hub'); break;
    }
    case 'slot_load': {
      var sl2 = parseInt(val, 10) || 0;
      if (load(sl2)) showScreen('hub'); else showTipMsg('该槽位没有存档。');
      break;
    }
    case 'slot_del': {
      var sl3 = parseInt(val, 10) || 0;
      try { if (typeof localStorage !== 'undefined') localStorage.removeItem(slotKey(sl3)); } catch (e) {}
      if (sl3 === getCurSlot() && G.base) G.base = newBase();
      showScreen('slots'); break;
    }
    case 'help': showScreen('help'); break;
    case 'menu': G.raid = null; showScreen('menu'); break;
    case 'hub': G.raid = null; showScreen('hub'); break;
    case 'map': showScreen('map'); break;
    case 'again': {
      var lastMap = (G.raid && G.raid.mapId) || 'suburb';
      G.raid = null;
      handleAction('go', lastMap);
      break;
    }
    case 'craft': showScreen('craft'); break;
    case 'build': showScreen('build'); break;
    case 'skills': showScreen('skills'); break;
    case 'stash': showScreen('stash'); break;
    case 'notes': showScreen('notes'); break;
    case 'loadout': showScreen('loadout'); break;
    case 'switch': showScreen(val); break;
    case 'go':
      if (val === 'military' && !b.militaryUnlocked) { showTipMsg('尚未获得军事基地门卡。'); return; }
      if (!b.loadout.gun && !b.loadout.melee) { showTipMsg('至少装备一件近战武器。'); return; }
      startRaid(val); save(); break;
    case 'craftitem': craftItem(parseInt(val, 10)); break;
    case 'builditem': buildItem(val); break;
    case 'repair': repairGear(val); showScreen('build'); break;
    case 'repairall': repairAll(); showScreen('build'); break;
    case 'skillup': levelSkill(val); break;
    case 'equip': {
      var parts = val.split(':');
      var slot = parts[0], item = parts[1];
      if (slot === 'gun' || slot === 'melee') {
        b.loadout[slot] = (b.loadout[slot] === item) ? null : item;
      } else if (slot === 'armor') {
        b.loadout.armor = (b.loadout.armor === item) ? null : item;
      }
      save(); showScreen('loadout');
      break;
    }
    case 'resume':
      showScreen('raid'); break;
    case 'pause':
      showScreen('pause'); break;
    case 'abandon':
      if (screenEl) screenEl.classList.remove('hide');
      showScreen('confirmAbandon'); break;
    case 'abandon_yes':
      if (G.raid) { G.raid.phase = 'explore'; endRaid(false); }
      break;
    case 'abandon_no':
      showScreen('pause'); break;
    case 'reset':
      G.base = newBase(); save(); showScreen('hub'); break;
    case 'bloodmoon':
      startBloodMoon(); break;
    case 'bm_act':
      bloodMoonAction(val); break;
  }
}

function showTipMsg(t) {
  var raid = G.raid;
  if (raid) { addLog(t); return; }
  var el = document.getElementById('screen');
  if (el) el.insertAdjacentHTML('afterbegin', '<div style="position:fixed;top:18px;left:50%;transform:translateX(-50%);background:#241a1a;border:1px solid #6a3a3a;color:#f0c8c8;padding:8px 16px;border-radius:3px;z-index:99;font-size:13px">' + t + '</div>');
  setTimeout(function () {
    var f = el && el.querySelector('div[style*="position:fixed"]');
    if (f && f.parentNode) f.parentNode.removeChild(f);
  }, 1600);
}

/* ---------- 修理：损坏装备可在营地用废料修复 ---------- */
/* ---------- 制作过程动画：进度条 + 火星 + 完成提示 ---------- */
function craftFx(idx) {
  if (typeof document === 'undefined') return;
  var rc = (typeof RECIPES !== 'undefined' && RECIPES && RECIPES[idx]) ? RECIPES[idx] : null;
  var nm = (rc && ITEMS[rc.out]) ? ITEMS[rc.out].n : '物品';
  var oldEl = document.getElementById('craftfx');
  if (oldEl && oldEl.parentNode) oldEl.parentNode.removeChild(oldEl);
  var host = document.body || (screenEl ? screenEl.parentNode : null);
  if (!host) return;
  var box = document.createElement('div');
  box.id = 'craftfx';
  box.style.cssText = 'position:fixed;left:50%;top:50%;transform:translate(-50%,-50%);z-index:80;' +
    'min-width:300px;padding:22px 26px;border-radius:14px;background:rgba(12,16,18,0.95);' +
    'border:1px solid #3d4a52;box-shadow:0 16px 48px rgba(0,0,0,0.7);text-align:center;' +
    'font-family:"Microsoft YaHei",sans-serif;color:#e6eef2;pointer-events:none';
  box.innerHTML =
    '<div style="font-size:12px;letter-spacing:3px;color:#7fa6ba">工 作 台 制 作 中</div>' +
    '<div style="font-size:18px;font-weight:700;margin:9px 0 14px">' + nm + '</div>' +
    '<div style="height:9px;border-radius:6px;background:#1b2327;overflow:hidden;border:1px solid #2b353b">' +
    '<div id="craftbar" style="height:100%;width:0%;background:linear-gradient(90deg,#b4722c,#ffd27a);transition:width .06s linear"></div></div>' +
    '<div id="craftspark" style="height:18px;margin-top:10px;font-size:15px;letter-spacing:5px;color:#ffc46b;opacity:.9">·</div>' +
    '<div id="craftdone" style="height:16px;margin-top:6px;font-size:12px;color:#8fd18a;opacity:0;transition:opacity .18s">制作完成</div>';
  host.appendChild(box);
  var bar = box.querySelector('#craftbar');
  var spark = box.querySelector('#craftspark');
  var done = box.querySelector('#craftdone');
  var frames = ['· ✦ ·', '✦ · ✧', '✧ · ✦', '· ✧ ✦ '];
  var t0 = (typeof performance !== 'undefined' && performance.now) ? performance.now() : Date.now();
  var dur = 1000;
  var step = function () {
    var nowT = (typeof performance !== 'undefined' && performance.now) ? performance.now() : Date.now();
    var k = Math.min(1, (nowT - t0) / dur);
    if (bar) bar.style.width = (k * 100).toFixed(1) + '%';
    if (spark && k < 1) {
      spark.textContent = frames[Math.floor(k * 12) % frames.length];
      spark.style.transform = 'translateX(' + (((k * 12) % 3) - 1) * 4 + 'px)';
    }
    if (k < 1) requestAnimationFrame(step);
    else {
      if (spark) spark.textContent = '';
      if (done) done.style.opacity = '1';
      setTimeout(function () { if (box.parentNode) box.parentNode.removeChild(box); }, 460);
    }
  };
  requestAnimationFrame(step);
  if (typeof SFX !== 'undefined') SFX.craft();
}

function repairCost(id) {
  var it = ITEMS[id] || {};
  if (it.t === 'armor') return { scrap: 4, cloth: 3 };
  return { scrap: 6, elec: 2 };
}

function repairGear(id) {
  var b = G.base;
  if (!b.damaged || typeof b.damaged !== 'object') b.damaged = {};
  if (!(b.damaged[id] > 0)) { showTipMsg('没有损坏的 ' + (ITEMS[id] ? ITEMS[id].n : id) + '。'); return false; }
  if ((b.bench || 0) < 1) { showTipMsg('需要至少 1 级工作台。'); return false; }
  var cost = repairCost(id), k;
  for (k in cost) if ((b.stash[k] || 0) < cost[k]) { showTipMsg('材料不足：' + ITEMS[k].n + ' x' + cost[k]); return false; }
  for (k in cost) b.stash[k] -= cost[k];
  b.damaged[id]--;
  if (b.damaged[id] <= 0) delete b.damaged[id];
  b.stash[id] = (b.stash[id] || 0) + 1;
  addLog('修理完成：' + ITEMS[id].n);
  save();
  return true;
}

function repairAll() {
  var b = G.base, done = 0, keys2 = Object.keys(b.damaged || {});
  for (var i = 0; i < keys2.length; i++) { if (repairGear(keys2[i])) done++; }
  if (done === 0) showTipMsg('没有可修复的装备，或材料不足。');
  return done;
}

function craftItem(i) {
  var r = RECIPES[i], b = G.base;
  if (!r) return false;
  if (b.bench < r.bench) { showTipMsg('工作台等级不足。'); return false; }
  for (var k in r.cost) if ((b.stash[k] || 0) < r.cost[k]) { showTipMsg('材料不足：' + ITEMS[k].n); return false; }
  for (var k2 in r.cost) b.stash[k2] -= r.cost[k2];
  b.stash[r.out] = (b.stash[r.out] || 0) + r.qty;
  if (typeof craftFx === 'function') craftFx(i);
  save(); showScreen('craft');
  return true;
}
function buildItem(id) {
  var b = G.base, def = null;
  for (var i = 0; i < BUILDS.length; i++) if (BUILDS[i].id === id) def = BUILDS[i];
  if (!def) return;
  if (!def.ok(b)) { showTipMsg('条件不满足。'); return; }
  for (var k in def.cost) if ((b.stash[k] || 0) < def.cost[k]) { showTipMsg('材料不足：' + ITEMS[k].n); return; }
  for (var k2 in def.cost) b.stash[k2] -= def.cost[k2];
  def.run(b);
  save(); showScreen('build');
}
function levelSkill(k) {
  var b = G.base;
  if (b.sp <= 0) { showTipMsg('没有可用技能点。'); return; }
  if ((b.skills[k] || 0) >= SKILLS[k].max) { showTipMsg('已满级。'); return; }
  b.skills[k]++; b.sp--;
  save(); showScreen('skills');
}

function runBloodMoonIfDue() {
  var b = G.base;
  if (!b) return;
  if (b.day % 4 !== 0) return;
  if (b.bloodDay === b.day) return;
  /* 血月改为可玩小局：只标记待战，由玩家在营地点击「迎战血月」进入 */
  b.bloodPending = 1;
}

/* ---------- 界面渲染 ---------- */
function showScreen(name) {
  G.screen = name;
  if (name === 'hub' || name === 'menu') runBloodMoonIfDue();
  renderScreen();
  if (hudEl) { if (name === 'raid') hudEl.classList.remove('hide'); else hudEl.classList.add('hide'); }
  if (typeof SFX !== 'undefined') SFX.bgm(name === 'menu' || name === 'raid' || name === 'bag' || name === 'pause' || name === 'hub' || name === 'craft' || name === 'build' || name === 'map' || name === 'loadout' || name === 'stash' || name === 'skills' || name === 'lootResult');
}

function itemLine(id, qty) {
  var it = ITEMS[id];
  if (!it) return '';
  return '<span class="tag" style="border-color:' + it.c + '44;color:' + it.c + '">' + it.n + (qty ? ' x' + qty : '') + '</span>';
}

function stashSummary(b) {
  var ids = Object.keys(b.stash).filter(function (k) { return b.stash[k] > 0 && ITEMS[k]; });
  if (!ids.length) return '<div class="muted">仓库空空如也。</div>';
  return ids.map(function (k) { return itemLine(k, b.stash[k]); }).join('');
}

function renderScreen() {
  if (!screenEl) return;
  var b = G.base;
  if (!b) { screenEl.innerHTML = '<div class="panel"><h1 class="title">尸潮撤离</h1></div>'; return; }
  if (G.screen === 'raid') {
    screenEl.innerHTML = '';
    screenEl.classList.add('hide');
    if (hudEl) hudEl.classList.remove('hide');
    return;
  }
  screenEl.classList.remove('hide');
  if (G.screen === 'confirmAbandon') {
    renderConfirmAbandon();
    return;
  }
  if (G.screen === 'pause') {
    renderPaused();
    return;
  }
  var fn = UI[G.screen];
  screenEl.innerHTML = fn ? fn(b) : '';
}

/* ---------- 界面注册表：新增界面只需在此追加一个 UI.xxx ---------- */
var UI = {};
UI.menu = function (b) {
  var html = '';
  var hasSave = !!slotInfo(0) || !!slotInfo(1) || !!slotInfo(2);
  var curI = getCurSlot();
  var curInfo = slotInfo(curI);
  html = '<div class="panel center">' +
    '<h1 class="title">尸 潮 撤 离</h1>' +
    '<div class="sub">DEAD EXTRACTION · 搜 · 打 · 撤</div>' +
    '<div style="margin:26px auto 6px;max-width:640px" class="muted">' +
    '感染爆发第 40 天。你是 7 号隔离区少数还活着的搜刮者。<br>' +
    '每次出发都要在有限时间里搜到物资、击退它们、然后活着从撤离点离开。<br>带不回来的东西，等于没拿到。</div>' +
    '<div class="row center" style="justify-content:center;margin-top:26px">' +
    (curInfo ? '<button class="btn primary" data-act="continue">继续（槽 ' + (curI + 1) + ' · 第 ' + curInfo.day + ' 天）</button>' : '') +
    '<button class="btn' + (curInfo ? '' : ' primary') + '" data-act="slots">' + (hasSave ? '存档管理 / 新进度' : '开始新进度') + '</button>' +
    '<button class="btn" data-act="help">玩法说明</button>' +
    '<button class="btn" data-act="settings">设置</button></div>' +
    '<div class="muted" style="margin-top:20px;font-size:11px">WASD 移动 · Shift 冲刺 · 鼠标瞄准 · 左键攻击 · E 搜刮/撤离 · F 安全屋 · R 换弹 · Q 换武器 · 1-4 消耗品 · Esc 暂停</div>' +
    '<div class="muted" style="margin-top:8px;font-size:11px;opacity:.6">v' + API_VERSION + ' · 3 存档槽 · 本地保存</div>' +
    '</div>';
  return html;
};

/* ---------- 搜刮结算面板：搜完先看清单，确认后才进背包 ---------- */
UI.lootResult = function () {
  var pl = G.pendingLoot;
  var nm = (pl && pl.c) ? containerName(pl.c.type) : '容器';
  var html = '<div class="panel center" style="max-width:560px">' +
    '<h1 class="title" style="font-size:22px">搜 刮 结 算</h1>' +
    '<div class="sub">' + nm + ' · 本次所得</div>';
  if (!pl || !pl.rows.length) {
    html += '<div class="muted" style="margin-top:18px">背包负重/格位已满，什么都没能带走。</div>';
  } else {
    html += '<div style="margin:16px 0 0;text-align:left">';
    for (var i = 0; i < pl.rows.length; i++) {
      var r = pl.rows[i];
      var mark = r.kind === 'key' ? '<span class="muted" style="font-size:11px"> · 关键</span>'
        : (r.kind === 'note' ? '<span class="muted" style="font-size:11px"> · 档案</span>' : '');
      html += '<div style="display:flex;justify-content:space-between;align-items:center;padding:8px 10px;border-bottom:1px solid rgba(255,255,255,.07)">' +
        '<span style="color:' + (r.c || '#e8e2d6') + '">' + r.n + mark + '</span>' +
        '<span style="font-family:Consolas,monospace;color:#ffd9a0">x' + r.qty + '</span></div>';
    }
    html += '</div>';
  }
  if (pl && pl.left && pl.left.length) {
    var ln = [];
    for (var j = 0; j < pl.left.length; j++) {
      var it2 = ITEMS[pl.left[j].id];
      if (it2) ln.push(it2.n + ' x' + pl.left[j].qty);
    }
    if (ln.length) html += '<div class="muted" style="margin-top:10px;font-size:12px">负重/格位不足，留在容器里：' + ln.join('，') + '</div>';
  }
  html += '<div class="row" style="justify-content:center;margin-top:20px">' +
    '<button class="btn primary" data-act="loot_ok">确认 · 收进背包</button></div>' +
    '<div class="muted" style="margin-top:10px;font-size:11px;opacity:.7">按 E / 空格 也可确认</div></div>';
  return html;
};

/* ---------- 局内背包面板 ---------- */
function openBag() {
  if (!G.raid || G.screen === 'bag') return;
  if (G.raid.phase === 'done' || G.raid.phase === 'dead') return;
  showScreen('bag');
}

function closeBag() {
  if (G.screen !== 'bag') return;
  showScreen(G.raid ? 'raid' : 'hub');
}

UI.bag = function (b) {
  var p = G.raid && G.raid.p;
  if (!p || !p.bag) {
    return '<div class="panel"><h1 class="title">\u80cc \u5305</h1><div class="sub">BACKPACK</div>' +
      '<div class="muted" style="margin-top:14px">\u53ea\u6709\u5728\u7a81\u88ad\u4e2d\u624d\u80fd\u67e5\u770b\u80cc\u5305\u3002</div>' +
      '<div class="row" style="justify-content:center;margin-top:18px"><button class="btn" data-act="bag_close">\u8fd4\u56de</button></div></div>';
  }
  var bag = p.bag;
  var cap = bag.slots.length, free = bagFree(bag);
  var used = bagWeight(bag), max = BAG_MAXW;
  var pct = max > 0 ? Math.min(100, used / max * 100) : 0;
  var barColor = used >= max ? '#b5563c' : (pct >= 80 ? '#c08a42' : '#6f9a48');

  var rows = '', kinds = 0, qtyAll = 0, unitW = 0.6;
  for (var i = 0; i < cap; i++) {
    var sl = bag.slots[i];
    if (!sl) continue;
    var it = ITEMS[sl.id];
    if (!it) continue;
    kinds++; qtyAll += sl.qty;
    var lw = it.w * sl.qty;
    if (it.w > unitW) unitW = it.w;   /* \u6309\u80cc\u5305\u5185\u6700\u91cd\u5355\u4ef6\u4fdd\u5b88\u4f30\u7b97 */
    rows += '<tr>' +
      '<td style="text-align:left;padding:6px 8px;border-top:1px solid #232b1e">' +
        '<span style="display:inline-block;width:8px;height:8px;border-radius:2px;background:' + it.c + ';margin-right:7px"></span>' + it.n +
      '</td>' +
      '<td style="text-align:right;padding:6px 8px;border-top:1px solid #232b1e;color:#f0e2b8">x' + sl.qty + '</td>' +
      '<td style="text-align:right;padding:6px 8px;border-top:1px solid #232b1e;color:#93a18a">' + it.w.toFixed(2) + '</td>' +
      '<td style="text-align:right;padding:6px 8px;border-top:1px solid #232b1e;color:#c8d4bb">' + lw.toFixed(1) + '</td>' +
      '</tr>';
  }
  if (!rows) rows = '<tr><td colspan="4" style="padding:14px 8px;color:#6d7a64">\u80cc\u5305\u662f\u7a7a\u7684\uff0c\u53bb\u5bb9\u5668\u91cc\u641c\u70b9\u4e1c\u897f\u5427\u3002</td></tr>';

  var leftW = Math.max(0, max - used);
  var canAddQ = unitW > 0 ? Math.floor(leftW / unitW + 1e-9) : 0;
  var canAdd = Math.min(canAddQ, free * 8);

  return '<div class="panel" style="max-width:780px">' +
    '<h1 class="title" style="font-size:22px">\u80cc \u5305</h1>' +
    '<div class="sub">BACKPACK \u00b7 \u8d1f\u91cd ' + used.toFixed(1) + ' / ' + max + '</div>' +
    '<div style="margin:16px 0 7px;height:10px;background:#11160f;border:1px solid #2b3326;border-radius:5px;overflow:hidden">' +
      '<div style="height:100%;width:' + pct.toFixed(1) + '%;background:' + barColor + '"></div>' +
    '</div>' +
    '<div class="muted" style="margin-bottom:14px;font-size:12px">' +
      (used >= max ? '<span style="color:#e89a8a">\u80cc\u5305\u8d1f\u91cd\u5df2\u6ee1\uff0c\u65e0\u6cd5\u518d\u62fe\u53d6</span>\u00a0\u00a0' : '') +
      '\u5df2\u5360 <b style="color:#e2d9b4">' + kinds + '</b> / ' + cap + ' \u683c\u00a0\u00a0' +
      '\u7a7a\u4f59 <b style="color:#e2d9b4">' + free + '</b> \u683c\u00a0\u00a0' +
      '\u5269\u4f59\u8d1f\u91cd <b style="color:#e2d9b4">' + leftW.toFixed(1) + '</b>\u00a0\u00a0' +
      '\u8fd8\u80fd\u88c5 \u7ea6 <b style="color:#e2d9b4">' + canAdd + '</b> \u4ef6' +
    '</div>' +
    '<table style="width:100%;border-collapse:collapse;font-size:13px">' +
      '<thead><tr style="font-size:11px;color:#7d8b72;letter-spacing:1px">' +
        '<th style="text-align:left;padding:4px 8px">\u7269 \u54c1</th>' +
        '<th style="text-align:right;padding:4px 8px">\u6570\u91cf</th>' +
        '<th style="text-align:right;padding:4px 8px">\u5355\u91cd</th>' +
        '<th style="text-align:right;padding:4px 8px">\u5408\u8ba1</th>' +
      '</tr></thead><tbody>' + rows + '</tbody></table>' +
    '<div class="row" style="justify-content:center;margin-top:22px">' +
      '<button class="btn primary" data-act="bag_close">\u8fd4\u56de\u6218\u6597\u00a0\u00b7\u00a0B / Esc</button>' +
    '</div>' +
    '<div class="muted" style="margin-top:12px;text-align:center;font-size:11px">' +
      '\u8d1f\u91cd\u8fbe\u4e0a\u9650\u540e\u65e0\u6cd5\u518d\u62fe\u53d6\uff1b\u6210\u529f\u64a4\u79bb\u624d\u80fd\u5e26\u56de\u8425\u5730\u3002' +
    '</div>' +
  '</div>';
};

UI.slots = function (b) {
  var html = '';
  html = '<div class="panel"><h1 class="title">存 档 槽</h1><div class="sub">SAVE SLOTS · 3 槽</div><div class="grid g2" style="margin-top:16px">';
  for (var si = 0; si < SLOT_COUNT; si++) {
    var inf = slotInfo(si);
    html += '<div class="card"' + (inf && inf.cur ? ' style="border-color:#6a8a5a"' : '') + '><h3>槽 ' + (si + 1) +
      (inf && inf.cur ? ' <span class="tag">当前</span>' : '') + '</h3>';
    if (!inf) {
      html += '<div class="muted">空槽位</div><div class="row" style="margin-top:10px"><button class="btn primary" data-act="slot_new" data-val="' + si + '">新建进度</button></div>';
    } else {
      html += '<div class="muted">第 ' + inf.day + ' 天 · 出击 ' + inf.raids + ' 次 · 撤离成功 ' + inf.extracts + ' 次<br>档案 ' + inf.notes + '/6 · ' + fmtTime(inf.savedAt) + '</div>' +
        '<div class="row" style="margin-top:10px">' +
        '<button class="btn primary" data-act="slot_load" data-val="' + si + '">读取</button>' +
        '<button class="btn" data-act="slot_new" data-val="' + si + '">覆盖新建</button>' +
        '<button class="btn danger" data-act="slot_del" data-val="' + si + '">删除</button></div>';
    }
    html += '</div>';
  }
  html += '</div><hr class="sep"><div class="row"><button class="btn" data-act="menu">返回</button></div></div>';
  return html;
};

UI.settings = function (b) {
  var html = '';
  var st = getSettings();
  html = '<div class="panel"><h1 class="title">设 置</h1><div class="sub">SETTINGS</div><div class="grid g2" style="margin-top:16px">';
  var order = ['master', 'sfx', 'bgm', 'sens', 'crosshair', 'quality'];
  for (var oi = 0; oi < order.length; oi++) {
    var sk2 = order[oi], sd = SETTINGS_DEF[sk2];
    html += '<div class="card"><h3>' + sd.n + '</h3>' +
      '<div class="row" style="margin-top:8px;justify-content:space-between">' +
      '<button class="btn" data-act="setopt" data-val="' + sk2 + ':-1">－</button>' +
      '<b style="min-width:70px;text-align:center">' + sd.fmt(st[sk2]) + '</b>' +
      '<button class="btn" data-act="setopt" data-val="' + sk2 + ':1">＋</button></div></div>';
  }
  html += '<div class="card"><h3>静音</h3><div class="row" style="margin-top:8px"><button class="btn" data-act="setopt" data-val="mute:0">' +
    (st.mute ? '已静音（点击开启）' : '声音开启（点击静音）') + '</button></div></div>';
  html += '</div><div class="card" style="margin-top:12px"><h3>按键</h3><div class="muted">WASD 移动 · Shift 冲刺 · 左键射击/挥砍 · R 换弹 · Q 切换武器<br>E 搜刮 / 呼叫撤离 · F 建立或存取安全屋 · 1 绷带 2 急救包 3 食物 4 净水 · Esc 暂停</div></div>' +
    '<hr class="sep"><div class="row"><button class="btn" data-act="back_from_settings">返回</button></div></div>';
  return html;
};

UI.help = function (b) {
  var html = '';
  html = '<div class="panel"><h1 class="title">玩 法 说 明</h1><div class="sub">SURVIVAL MANUAL</div>' +
    '<div class="grid g2" style="margin-top:18px">' +
    '<div class="card"><h3>核心循环</h3><div class="muted">营地准备 → 进入区域搜刮 → 击退丧尸 → 呼叫撤离并坚守 → 带出战利品升级营地。死亡会丢掉背包内全部物资。</div></div>' +
    '<div class="card"><h3>操作</h3><div class="muted">WASD 移动，Shift 冲刺（耗体力）<br>鼠标瞄准，左键射击/挥砍，R 换弹，Q 切换枪/近战<br>E 搜刮容器、E 长按呼叫撤离<br>1 绷带 2 急救包 3 食物 4 净水<br>Esc 暂停</div></div>' +
    '<div class="card"><h3>生存压力</h3><div class="muted">饥饿与口渴会缓慢下降，归零后持续掉血。被丧尸咬伤有概率感染，感染超过 60 会持续掉血且降速，用抗生素或血清压制。</div></div>' +
    '<div class="card"><h3>声音即风险</h3><div class="muted">枪声会引来大范围尸群，近战安静但体力消耗高。霰弹枪威力大、噪音也最大。撤离倒计时期间会不断有丧尸从四周赶来。</div></div>' +
    '<div class="card"><h3>撤离与坚守</h3><div class="muted">走到撤离点后长按 E 呼叫撤离（约 3.5 秒），随后必须原地坚守 14 秒。坚守期间会有三波丧尸定向扑来，硬拼不如先清干净周围再呼叫。</div></div>' +
    '<div class="card"><h3>安全屋</h3><div class="muted">在地图里按 F 可把脚下房间设为安全屋（消耗木材 3 + 废料 5，每图限一处）。安全屋自带 12 格储物箱，可跨局存物资；建好后下一局直接从安全屋出发，并可在安全屋直接呼叫撤离。</div></div>' +
    '<div class="card"><h3>局内时限</h3><div class="muted">每个区域都有撤离时限（郊区 5 分、城区 6 分、医院 6 分半、军事基地 7 分）。时限一到撤离窗口关闭，本局判定失败。</div></div>' +
    '<div class="card"><h3>血月防守</h3><div class="muted">每 4 天一次血月。每波可依次使用火力压制、电网放电、加固围墙（各有次数上限），再点「迎接本波冲击」结算。围墙耐久归零则营地物资受损。</div></div>' +
    '<div class="card"><h3>营地建设</h3><div class="muted">升级工作台解锁更高级配方与装备修理；加固围墙与电网提高防御。防御值会同时削弱血月威胁与提升火力输出。</div></div>' +
    '<div class="card"><h3>剧情线索</h3><div class="muted">六份档案散落在各区域容器中。集齐后可解锁军事基地路线，那里有唯一的跑道撤离与结局。</div></div>' +
    '</div><hr class="sep"><div class="row"><button class="btn" data-act="menu">返回</button></div></div>';
  return html;
};

UI.hub = function (b) {
  var html = '';
  var need = 25 + b.day * 3;
  var gap = Math.max(0, need - b.defense);
  var gapTxt = gap > 0 ? '<span style="color:#e0a86a">还差 ' + gap + ' 点防御（约 ' + Math.ceil(gap / 8) + ' 段围墙 / ' + Math.ceil(gap / 6) + ' 圈电网）</span>' : '<span style="color:#9fc48a">防御足够</span>';
  var matGap = [];
  ['wood', 'scrap', 'cloth', 'elec'].forEach(function (mk2) {
    if (!ITEMS[mk2]) return;
    var have = b.stash[mk2] || 0;
    if (have < 10) matGap.push(ITEMS[mk2].n + ' ' + have);
  });
  var shCnt = 0;
  if (b.safehouse) for (var shk in b.safehouse) if (b.safehouse[shk]) shCnt++;
  html = '<div class="panel"><h1 class="title">营 地</h1><div class="sub">第 ' + b.day + ' 天 · ' +
    (b.day % 4 === 0 ? '血月之夜' : '距下次血月 ' + (4 - b.day % 4) + ' 天') + '</div>' +
    '<div class="row" style="margin-top:16px">' +
    '<div class="card" style="flex:1;min-width:180px"><h3>营地状态</h3><div class="muted">工作台：Lv' + b.bench + '（可修理装备）<br>防御：' + b.defense + ' / 血月需求 ' + need + '<br>' + gapTxt + '<br>技能点：' + b.sp + '<br>档案：' + b.notes.length + '/6<br>安全屋：' + shCnt + ' 处</div></div>' +
    '<div class="card" style="flex:1;min-width:180px"><h3>战绩</h3><div class="muted">出击 ' + b.raids + ' 次<br>成功撤离 ' + b.extracts + ' 次<br>阵亡 ' + b.deaths + ' 次<br>累计击杀 ' + b.totalKills + '</div></div>' +
    '<div class="card" style="flex:1.4;min-width:220px"><h3>仓库物资</h3><div>' + stashSummary(b) + '</div></div>' +
    '</div>' +
    (b.lastBlood ? '<div class="card" style="margin-top:12px;border-color:#5a3a2a"><h3 style="color:#e0a86a">血月结算</h3><div class="muted">' + b.lastBlood + '</div></div>' : '') +
    (b.lastReport ? '<div class="card" style="margin-top:12px"><h3>上一局战报</h3><div class="muted">' + b.lastReport + '</div></div>' : '') +
    (matGap.length ? '<div class="muted" style="margin-top:10px;font-size:11px">材料偏少：' + matGap.join(' · ') + '（去搜刮或制作补充）</div>' : '') +
    (Object.keys(b.damaged || {}).length ? '<div class="muted" style="margin-top:6px;font-size:11px;color:#e08a8a">有 ' + Object.keys(b.damaged).length + ' 件装备损坏，可在「营地建设」里修理。</div>' : '') +
    '<hr class="sep"><div class="row">' +
    '<button class="btn primary" data-act="map">出发搜刮</button>' +
    (b.bloodPending && b.bloodDay !== b.day ? '<button class="btn danger" data-act="bloodmoon">迎战血月（5 波防守）</button>' : '') +
    '<button class="btn" data-act="loadout">装备</button>' +
    '<button class="btn" data-act="craft">制作台</button>' +
    '<button class="btn" data-act="build">营地建设</button>' +
    '<button class="btn" data-act="skills">技能</button>' +
    '<button class="btn" data-act="stash">仓库</button>' +
    '<button class="btn" data-act="notes">档案</button>' +
    '<button class="btn" data-act="save">手动存档</button>' +
    '<button class="btn" data-act="menu">主菜单</button>' +
    '</div></div>';
  return html;
};

UI.map = function (b) {
  var html = '';
  html = '<div class="panel"><h1 class="title">选 择 区 域</h1><div class="sub">SELECT ZONE</div><div class="grid g2" style="margin-top:16px">';
  var keysM = Object.keys(MAPS);
  for (var i = 0; i < keysM.length; i++) {
    var mk = keysM[i], cfg = MAPS[mk];
    var locked = (mk === 'military' && !b.militaryUnlocked);
    html += '<div class="card"><h3>' + cfg.n + ' <span class="tag">风险 ' + cfg.risk + '</span>' +
      (locked ? '<span class="tag" style="color:#e08a5a">未解锁</span>' : '') + '</h3>' +
      '<div class="muted">' + cfg.d + '</div>' +
      '<div class="muted" style="margin-top:6px">丧尸 ' + cfg.zmin + '-' + cfg.zmax + ' · 撤离点 ' + cfg.exits + ' · 物资系数 ' + cfg.loot + '</div>' +
      '<div class="row" style="margin-top:10px">' + (locked ?
        '<button class="btn" disabled>需要门卡</button>' :
        '<button class="btn primary" data-act="go" data-val="' + mk + '">进入</button>') + '</div></div>';
  }
  html += '</div><hr class="sep"><div class="row"><button class="btn" data-act="hub">返回营地</button></div></div>';
  return html;
};

UI.loadout = function (b) {
  var html = '';
  var guns = [], meles = [], armors = [];
  Object.keys(b.stash).forEach(function (k) {
    if (!ITEMS[k] || b.stash[k] <= 0) return;
    if (ITEMS[k].t === 'weapon') {
      var wk = ITEMS[k].wk;
      if (wk === 'crowbar' || wk === 'axe') meles.push(k); else guns.push(k);
    }
    if (ITEMS[k].t === 'armor') armors.push(k);
  });
  function eqRow(slot, list, cur) {
    if (!list.length) return '<div class="muted">无可用装备</div>';
    return list.map(function (id) {
      var on = cur === id;
      return '<button class="btn' + (on ? ' primary' : '') + '" data-act="equip" data-val="' + slot + ':' + id + '">' +
        ITEMS[id].n + (on ? ' · 已装备' : '') + '</button>';
    }).join(' ');
  }
  html = '<div class="panel"><h1 class="title">装 备</h1><div class="sub">LOADOUT</div>' +
    '<div class="grid" style="margin-top:16px">' +
    '<div class="card"><h3>枪械</h3><div class="row">' + eqRow('gun', guns, b.loadout.gun) + '</div></div>' +
    '<div class="card"><h3>近战</h3><div class="row">' + eqRow('melee', meles, b.loadout.melee) + '</div></div>' +
    '<div class="card"><h3>护甲</h3><div class="row">' + eqRow('armor', armors, b.loadout.armor) + '</div></div>' +
    '<div class="card"><h3>出发补给</h3><div class="muted">自动携带：绷带 x3、急救包 x1、食物 x1、净水 x1' + (b.purifier ? '、净水 x2（净水系统）' : '') + '，以及所配枪械弹药最多 60 发。<br>背包 12 格，负重过高会降低移动速度。</div></div>' +
    '</div><hr class="sep"><div class="row"><button class="btn" data-act="hub">返回营地</button><button class="btn primary" data-act="map">选择区域</button></div></div>';
  return html;
};

UI.craft = function (b) {
  var html = '';
  html = '<div class="panel"><h1 class="title">制 作 台</h1><div class="sub">工作台 Lv' + b.bench + '</div><table style="margin-top:16px"><tr><th>产物</th><th>材料</th><th>需求</th><th></th></tr>';
  for (var ri = 0; ri < RECIPES.length; ri++) {
    var r = RECIPES[ri];
    var can = b.bench >= r.bench;
    var costTxt = Object.keys(r.cost).map(function (k) {
      var enough = (b.stash[k] || 0) >= r.cost[k];
      return '<span style="color:' + (enough ? '#9fc48a' : '#c96a6a') + '">' + ITEMS[k].n + ' x' + r.cost[k] + '</span>';
    }).join(' + ');
    html += '<tr><td>' + ITEMS[r.out].n + ' x' + r.qty + '</td><td>' + costTxt + '</td><td class="muted">Lv' + r.bench + '</td><td>' +
      '<button class="btn" ' + (can ? '' : 'disabled') + ' data-act="craftitem" data-val="' + ri + '">制作</button></td></tr>';
  }
  html += '</table><hr class="sep"><div class="row"><button class="btn" data-act="hub">返回营地</button></div></div>';
  return html;
};

UI.build = function (b) {
  var html = '';
  html = '<div class="panel"><h1 class="title">营 地 建 设</h1><div class="sub">防御 ' + b.defense + '</div><div class="grid g2" style="margin-top:16px">';
  for (var bi2 = 0; bi2 < BUILDS.length; bi2++) {
    var bd = BUILDS[bi2];
    var okB = bd.ok(b);
    var costStr = Object.keys(bd.cost).map(function (k) {
      var enough = (b.stash[k] || 0) >= bd.cost[k];
      return '<span style="color:' + (enough ? '#9fc48a' : '#c96a6a') + '">' + ITEMS[k].n + ' x' + bd.cost[k] + '</span>';
    }).join(' + ');
    html += '<div class="card"><h3>' + bd.n + '</h3><div class="muted">' + bd.d + '</div>' +
      '<div class="muted" style="margin-top:6px">' + costStr + '</div>' +
      '<div class="row" style="margin-top:10px">' +
      (okB ? '<button class="btn" data-act="builditem" data-val="' + bd.id + '">建造</button>' : '<button class="btn" disabled>已完成</button>') +
      '</div></div>';
  }
  html += '</div>';
  /* 损坏装备修理 */
  var dmgIds = Object.keys(b.damaged || {}).filter(function (k2) { return b.damaged[k2] > 0; });
  html += '<hr class="sep"><h3 style="margin-bottom:8px">装备修理</h3>';
  if (dmgIds.length === 0) {
    html += '<div class="muted">没有损坏的装备。</div>';
  } else {
    html += '<div class="grid g2">';
    dmgIds.forEach(function (id) {
      var cost = repairCost(id), cs = [];
      Object.keys(cost).forEach(function (k3) {
        var enough = (b.stash[k3] || 0) >= cost[k3];
        cs.push('<span style="color:' + (enough ? '#9fc48a' : '#c96a6a') + '">' + ITEMS[k3].n + ' x' + cost[k3] + '</span>');
      });
      html += '<div class="card"><h3>' + ITEMS[id].n + ' <span class="tag">损坏 x' + b.damaged[id] + '</span></h3>' +
        '<div class="muted">' + cs.join(' + ') + '</div>' +
        '<div class="row" style="margin-top:10px"><button class="btn" data-act="repair" data-val="' + id + '">修理</button></div></div>';
    });
    html += '</div><div class="row" style="margin-top:10px"><button class="btn" data-act="repairall">全部修理</button></div>';
  }
  html += '<hr class="sep"><div class="row"><button class="btn" data-act="hub">返回营地</button></div></div>';
  return html;
};

UI.bloodmoon = function (b) {
  var html = '';
  var bm2 = G.bm || { round: 0, total: 5, wall: 100, log: [], phase: 'ready', result: null };
  html = '<div class="panel"><h1 class="title" style="color:#e0a86a">血 月 防 守</h1><div class="sub">BLOOD MOON DEFENSE</div>' +
    '<div class="grid g2" style="margin-top:16px">' +
    '<div class="card"><h3>围墙耐久</h3><div class="muted" style="font-size:20px;color:' + (bm2.wall > 50 ? '#9fc48a' : '#e08a8a') + '">' + bm2.wall + ' / 100</div>' +
    '<div class="muted">第 ' + bm2.round + ' / ' + bm2.total + ' 波已结束<br>弹药 ' + (b.stash.ammo9 || 0) + ' · 木材 ' + (b.stash.wood || 0) + ' · 电子 ' + (b.stash.elec || 0) + '<br>防御值 ' + b.defense + '</div></div>' +
    '<div class="card"><h3>战况</h3><div class="muted" style="white-space:pre-line;max-height:150px;overflow:auto">' + (bm2.log.length ? bm2.log.join('\n') : '尸潮正在聚集……') + '</div></div></div>';
  if (bm2.phase === 'ready' && bm2.round < bm2.total) {
    var nextThreat = 14 + (bm2.round + 1) * 6 + b.day * 2;
    var lf = 2 - ((bm2.acts && bm2.acts.fire) || 0), lt = 2 - ((bm2.acts && bm2.acts.trap) || 0), lr = 2 - ((bm2.acts && bm2.acts.repair) || 0);
    html += '<div class="card" style="margin-top:12px"><h3>第 ' + (bm2.round + 1) + ' 波 · 威胁 ' + nextThreat + '　<span class="tag" style="color:#9fc48a">当前压制 ' + (bm2.out || 0) + '</span></h3>' +
      '<div class="muted">本波可自由组合行动，压制越高围墙越安全；准备就绪后点击「迎接本波冲击」结算。</div>' +
      '<div class="row" style="margin-top:10px">' +
      '<button class="btn primary" ' + (lf <= 0 ? 'disabled' : '') + ' data-act="bm_act" data-val="fire">火力压制（弹药 x6，剩 ' + lf + '）</button>' +
      '<button class="btn" ' + (lt <= 0 ? 'disabled' : '') + ' data-act="bm_act" data-val="trap">电网放电（电子 x2，剩 ' + lt + '）</button>' +
      '<button class="btn" ' + (lr <= 0 ? 'disabled' : '') + ' data-act="bm_act" data-val="repair">加固围墙（木材 x2，剩 ' + lr + '）</button>' +
      '<button class="btn danger" data-act="bm_act" data-val="next">迎接本波冲击</button></div></div>';
  } else {
    html += '<div class="card" style="margin-top:12px;border-color:' + (bm2.result ? '#6a8a5a' : '#6a3a3a') + '">' +
      '<h3 style="color:' + (bm2.result ? '#9fc48a' : '#e08a8a') + '">' + (bm2.result ? '守 住 了' : '围 墙 被 突 破') + '</h3>' +
      '<div class="muted">' + b.lastBlood + '</div></div>';
  }
  html += '<hr class="sep"><div class="row"><button class="btn" data-act="hub">返回营地</button></div></div>';
  return html;
};

UI.skills = function (b) {
  var html = '';
  html = '<div class="panel"><h1 class="title">技 能</h1><div class="sub">可用技能点 ' + b.sp + '</div><div class="grid g2" style="margin-top:16px">';
  Object.keys(SKILLS).forEach(function (k) {
    var sk = SKILLS[k], lv = b.skills[k] || 0;
    html += '<div class="card"><h3>' + sk.n + ' <span class="tag">Lv' + lv + '/' + sk.max + '</span></h3>' +
      '<div class="muted">' + sk.d + '</div>' +
      '<div class="row" style="margin-top:10px"><button class="btn" ' + (lv >= sk.max ? 'disabled' : '') +
      ' data-act="skillup" data-val="' + k + '">' + (lv >= sk.max ? '已满级' : '升级（1 点）') + '</button></div></div>';
  });
  html += '</div><hr class="sep"><div class="row"><button class="btn" data-act="hub">返回营地</button></div></div>';
  return html;
};

UI.stash = function (b) {
  var html = '';
  html = '<div class="panel"><h1 class="title">仓 库</h1><div class="sub">负重 ' + fmt(stashWeight(b)) + '</div>' +
    '<div style="margin-top:16px">' + stashSummary(b) + '</div><hr class="sep">' +
    '<div class="row"><button class="btn" data-act="hub">返回营地</button></div></div>';
  return html;
};

UI.notes = function (b) {
  var html = '';
  html = '<div class="panel"><h1 class="title">档 案</h1><div class="sub">已收集 ' + b.notes.length + '/6</div><div class="grid" style="margin-top:16px">';
  if (!b.notes.length) html += '<div class="card muted">还没有找到任何档案。它们散落在各区域的容器里。</div>';
  b.notes.forEach(function (id) {
    var nt = NOTES[id];
    html += '<div class="card"><h3>' + nt.title + '</h3><div class="muted" style="white-space:pre-line">' + nt.body + '</div></div>';
  });
  if (b.notes.length >= 6) {
    html += '<div class="card" style="border-color:#6a5a2a"><h3 style="color:#e8c46a">全部档案已复原</h3><div class="muted">军事基地的跑道仍在运作。携带门卡前往军事基地，从唯一撤离点离开这座城市。</div></div>';
  }
  html += '</div><hr class="sep"><div class="row"><button class="btn" data-act="hub">返回营地</button></div></div>';
  return html;
};

UI.result = function (b) {
  var html = '';
  var res = G.raid && G.raid.result ? G.raid.result : { success: false, gain: [], xp: 0, kills: 0, searched: 0 };
  var grade = res.grade || (res.success ? 'A' : 'C');
  var timeStr = res.time !== undefined ? (Math.floor(res.time / 60) + ':' + ('0' + Math.floor(res.time % 60)).slice(-2)) : '—';
  html = '<div class="panel"><h1 class="title" style="color:' + (res.success ? '#b9e08a' : '#e08a8a') + '">' +
    (res.success ? '撤 离 成 功' : (res.reason === 'timeout' ? '撤 离 窗 口 关 闭' : '任 务 失 败')) + '</h1><div class="sub">' +
    (res.success ? 'EXTRACTION COMPLETE' : 'KILLED IN ACTION') + '</div>' +
    '<div class="grid g2" style="margin-top:18px">' +
    '<div class="card"><h3>统计 <span class="tag">评级 ' + grade + '</span></h3><div class="muted">击杀 ' + res.kills + ' · 搜刮容器 ' + res.searched +
    '<br>用时 ' + timeStr + (res.limit ? ' / 限时 ' + Math.floor(res.limit / 60) + ':' + ('0' + Math.floor(res.limit % 60)).slice(-2) : '') +
    '<br>经验 +' + res.xp + (res.spGain ? ' · <span style="color:#e8c46a">技能点 +' + res.spGain + '</span>' : '') +
    '<br>战利品估值 ' + Math.round(res.lootValue || 0) + (res.success ? '（已入库）' : '（已损失）') +
    '<br>累计出击 ' + b.raids + ' 次，成功 ' + b.extracts + ' 次</div></div>' +
    '<div class="card"><h3>带回物资 <span class="tag">' + res.gain.length + ' 项</span></h3><div>' + (res.gain.length ? res.gain.map(function (s) { return '<span class="tag">' + s + '</span>'; }).join('') : '<span class="muted">无。这次什么都没带回来。</span>') + '</div></div>' +
    (res.damaged ? '<div class="card" style="margin-top:12px;border-color:#6a3a3a"><h3 style="color:#e08a8a">装备损坏</h3><div class="muted">有装备在阵亡中损坏，已进入待修列表，可在「营地建设」用废料修复。</div></div>' : '') +
    '</div>' +
    (b.lastBlood && b.day % 4 === 0 ? '<div class="card" style="margin-top:12px"><h3 style="color:#e0a86a">血月结算</h3><div class="muted">' + b.lastBlood + '</div></div>' : '') +
    (b.ending ? '<div class="card" style="margin-top:12px;border-color:#e8c46a"><h3 style="color:#e8c46a">结 局 · 起 飞</h3><div class="muted" style="white-space:pre-line">跑道尽头，运输机的引擎声压过了尸群的嘶吼。六份档案交到接应者手里——这座城市的真相，终于有人带了出去。</div></div>' : '') +
    '<hr class="sep"><div class="row"><button class="btn primary" data-act="hub">返回营地</button><button class="btn" data-act="again">再来一次</button></div></div>';
  return html;
};


function renderPaused() {
  if (!screenEl) return;
  screenEl.classList.remove('hide');
  screenEl.innerHTML = '<div class="panel center" style="max-width:460px"><h1 class="title" style="font-size:22px">已 暂 停</h1>' +
    '<div class="sub">PAUSED</div><div class="row" style="justify-content:center;margin-top:24px">' +
    '<button class="btn primary" data-act="resume">继续</button>' +
    '<button class="btn danger" data-act="abandon">放弃任务</button></div>' +
    '<div class="muted" style="margin-top:14px">放弃任务等同阵亡：背包内物资全部丢失。</div></div>';
}

function renderConfirmAbandon() {
  if (!screenEl) return;
  screenEl.classList.remove('hide');
  var r = G.raid;
  screenEl.innerHTML = '<div class="panel center" style="max-width:520px"><h1 class="title" style="font-size:22px;color:#e08a8a">放 弃 任 务 ？</h1>' +
    '<div class="sub">ABANDON RAID</div>' +
    '<div class="muted" style="margin-top:16px">放弃等同阵亡：背包内全部物资丢失，装备有概率损坏，并计入阵亡次数。<br>本局击杀 ' +
    (r ? r.kills : 0) + ' · 搜刮容器 ' + (r ? r.searched : 0) + '。</div>' +
    '<div class="row" style="justify-content:center;margin-top:22px">' +
    '<button class="btn" data-act="abandon_no">继续坚守</button>' +
    '<button class="btn danger" data-act="abandon_yes">确认放弃</button></div></div>';
}

/* ---------- HUD ---------- */
var hudTick = 0;
var SLOTS = [['1', 'bandage'], ['2', 'medkit'], ['3', 'food'], ['4', 'water']];
function setBar(id, tid, v, max, suffix) {
  var el = document.getElementById(id), te = document.getElementById(tid);
  if (el) el.style.width = clamp(v / max * 100, 0, 100).toFixed(1) + '%';
  if (te) te.textContent = Math.round(v) + (suffix || '');
}
function updateHud(dt) {
  if (!hudEl || G.screen !== 'raid' || !G.raid) return;
  var raid = G.raid, p = raid.p;
  setBar('vHp', 'tHp', p.hp, p.maxHp);
  setBar('vStam', 'tStam', p.stam, p.maxStam);
  setBar('vHun', 'tHun', p.hunger, 100);
  setBar('vThi', 'tThi', p.thirst, 100);
  setBar('vInf', 'tInf', p.infection, 100);

  hudTick -= (dt || 0.016);
  if (hudTick > 0) return;
  hudTick = 0.15;

  /* 背包负重显示 */
  var bagMet = document.getElementById('hudBagMet');
  var bagBox = document.getElementById('hudBag');
  if (bagMet && p.bag) {
    var used = bagWeight(p.bag), max = BAG_MAXW, free = bagFree(p.bag);
    bagMet.innerHTML = '\u8d1f\u91cd ' + used.toFixed(1) + '/' + max + ' \u00b7 \u7a7a\u4f59 ' + free + ' \u683c';
    if (bagBox) {
      bagBox.className = used >= max ? 'full' : (used / max >= 0.8 ? 'warn' : '');
    }
  }

  /* 新手引导推进 */
  if (!G.base.tutorial || typeof G.base.tutorial !== 'object') G.base.tutorial = {};
  if (!G.base.tutorial.done) {
    if (raid.searched >= 1) { raid.guide = '新手引导②：搜到东西了。看着上方的撤离点提示，靠近绿点长按 E 呼叫撤离。'; }
    if (raid.phase === 'extracting') { raid.guide = '新手引导③：坚守撤离点，撑过倒计时！'; G.base.tutorial.done = 1; save(); }
  } else raid.guide = '';

  var objEl = document.getElementById('hudObjective');
  if (objEl) objEl.innerHTML = (raid.guide ? '<span style="color:#e8c46a">' + raid.guide + '</span><br>' : '') + raid.objective + '<br><span style="color:#8d9a84;font-size:11px">撤离点 ' + raid.map.exits.length + ' · 容器 ' + raid.searched + '/' + raid.map.containers.length + ' · 击杀 ' + raid.kills + ' · 负重 ' + Math.round(bagWeight(raid.p.bag) * 10) / 10 + '/' + BAG_MAXW + '</span>';
  var tEl = document.getElementById('hudTime');
  if (tEl) {
    var left = raid.timeLimit ? Math.max(0, raid.timeLimit - raid.time) : -1;
    var warn = left >= 0 && left <= 60 ? 'color:#e08a8a' : '';
    tEl.innerHTML = raid.cfg.n + ' · ' + Math.floor(raid.time / 60) + ':' + ('0' + Math.floor(raid.time % 60)).slice(-2) +
      (left >= 0 ? ' ｜ <span style="' + warn + '">剩余 ' + Math.floor(left / 60) + ':' + ('0' + Math.floor(left % 60)).slice(-2) + '</span>' : '');
  }

  var w = curWeapon();
  var wEl = document.getElementById('hudWeapon');
  if (wEl) wEl.textContent = (p.reloading > 0 ? '换弹中…' : ((ITEMS[p.cur] ? ITEMS[p.cur].n : '空') + (w.melee ? '（近战）' : '')));
  var aEl = document.getElementById('hudAmmo');
  if (aEl) {
    if (w.melee) aEl.innerHTML = '<small>体力 ' + Math.round(p.stam) + '</small>';
    else aEl.innerHTML = p.mag + '<small> / ' + (w.mag) + ' ｜ 备弹 ' + bagCount(p.bag, w.ammo) + '</small>';
  }
  var sEl = document.getElementById('hudSlots');
  if (sEl) {
    sEl.innerHTML = SLOTS.map(function (s) {
      var n = bagCount(p.bag, s[1]);
      var inm = ITEMS[s[1]] ? ITEMS[s[1]].n : '—';
      return '<div class="slot"><span class="k">' + s[0] + '</span><b>' + n + '</b><span>' + (inm.length > 4 ? inm.slice(0, 4) : inm) + '</span></div>';
    }).join('');
  }
  var lEl = document.getElementById('hudLog');
  if (lEl) lEl.innerHTML = raid.log.slice(0, 4).map(function (t) { return '<div>· ' + t + '</div>'; }).join('');
  var tEl2 = document.getElementById('hudTip');
  if (tEl2) {
    if (raid.tip) { tEl2.textContent = raid.tip; tEl2.classList.add('on'); }
    else tEl2.classList.remove('on');
  }
}

/* ---------- 输入 ---------- */
function initInput() {
  document.addEventListener('keydown', function (e) {
    var k = (e.key || '').toLowerCase();
    keys[k] = true;
    if (k === ' ' || k.indexOf('arrow') === 0) { if (e.preventDefault) e.preventDefault(); }
    if (e.repeat) return;
    if (G.screen === 'lootResult') {
      if (k === 'e' || k === ' ' || k === 'enter' || k === 'escape' || k === 'f') {
        if (e.preventDefault) e.preventDefault();
        confirmLoot();
      }
      return;
    }
    if (G.screen === 'raid' && G.raid) {
      if (k === 'r') startReload();
      if (k === 'q') switchWeapon();
      if (k === '1') useItem('bandage');
      if (k === '2') useItem('medkit');
      if (k === '3') useItem('food');
      if (k === '4') useItem('water');
      if (k === 'b' || k === 'tab') { if (e.preventDefault) e.preventDefault(); openBag(); return; }
      if (k === 'escape') { showScreen('pause'); }
    } else if (G.screen === 'pause' && k === 'escape') {
      showScreen('raid');
    } else if (G.screen === 'bag' && (k === 'b' || k === 'tab' || k === 'escape')) {
      if (e.preventDefault) e.preventDefault();
      closeBag();
    }
  });
  document.addEventListener('keyup', function (e) {
    keys[(e.key || '').toLowerCase()] = false;
  });
  if (cv) {
    cv.addEventListener('mousemove', function (e) {
      var r = cv.getBoundingClientRect ? cv.getBoundingClientRect() : { left: 0, top: 0 };
      mouse.x = e.clientX - r.left; mouse.y = e.clientY - r.top;
    });
    cv.addEventListener('mousedown', function (e) { if (e.button === 0) mouse.down = true; });
    cv.addEventListener('mouseup', function (e) { if (e.button === 0) mouse.down = false; });
    cv.addEventListener('contextmenu', function (e) { if (e.preventDefault) e.preventDefault(); });
  }
  if (typeof window !== 'undefined' && window.addEventListener) {
    window.addEventListener('mouseup', function () { mouse.down = false; });
    window.addEventListener('blur', function () { mouse.down = false; for (var k in keys) keys[k] = false; });
  }
}

/* ---------- 主循环 ---------- */
var lastTs = 0;
function step(dt) {
  G.tick++;
  if (G.screen === 'raid' && G.raid) {
    if (G.raid.phase === 'done' || G.raid.phase === 'dead') {
      render(); updateHud(dt);
      renderScreen();
      if (hudEl) hudEl.classList.add('hide');
      return;
    }
    updateRaid(dt);
    render();
    updateHud(dt);
  }
}
function loop(ts) {
  if (typeof requestAnimationFrame === 'function') requestAnimationFrame(loop);
  var dt = lastTs ? Math.min(0.05, (ts - lastTs) / 1000) : 0.016;
  lastTs = ts;
  step(dt);
}

function boot() {
  initCanvas();
  initUI();
  initInput();
  curSlot = getCurSlot();
  if (!G.base) { if (!load()) { G.base = newBase(); G.base.slot = curSlot; } }
  try { applySettings(); } catch (e) {}
  showScreen('menu');
  if (typeof requestAnimationFrame === 'function') requestAnimationFrame(loop);
}

/* ---------- 对外测试接口 ---------- */
var API_VERSION = '1.1.0';
var API = {
  G: G, MAPS: MAPS, ITEMS: ITEMS, WEAPONS: WEAPONS, ZT: ZT, NOTES: NOTES, RECIPES: RECIPES,
  BUILDS: BUILDS, SKILLS: SKILLS, TILE: TILE, MAPW: MAPW, MAPH: MAPH,
  newGame: function () { G.base = newBase(); return G.base; },
  startRaid: startRaid,
  step: step,
  updateRaid: updateRaid,
  render: render,
  showScreen: showScreen,
  newBase: newBase,
  save: save, load: load,
  setKey: function (k, v) { keys[k] = v; },
  setMouse: function (x, y, down) {
    mouse.x = x; mouse.y = y;
    if (down !== undefined) mouse.down = down;
  },
  aimAtWorld: function (wx, wy) {
    var vw = G.viewW || 1280, vh = G.viewH || 720;
    mouse.x = wx - cam.x + vw / 2;
    mouse.y = wy - cam.y + vh / 2;
  },
  tryFire: tryFire, startReload: startReload, switchWeapon: switchWeapon, useItem: useItem,
  craftItem: craftItem, buildItem: buildItem, levelSkill: levelSkill, runBloodMoonIfDue: runBloodMoonIfDue,
  updateInteract: updateInteract, stashWeight: stashWeight, skillBonus: skillBonus,
  curWeapon: curWeapon, hurtPlayer: hurtPlayer, hurtZombie: hurtZombie, noiseEvent: noiseEvent,
  updateZombies: updateZombies, updateBullets: updateBullets, updatePlayer: updatePlayer,
  keys: keys, mouse: mouse,
  bagAdd: bagAdd, bagCount: bagCount, bagRemove: bagRemove,
  bagWeight: bagWeight, bagMaxW: function () { return BAG_MAXW; }, openBag: openBag, closeBag: closeBag, bagFree: bagFree,
  genMap: genMap, buildFlow: buildFlow, isWallAt: isWallAt, dist: dist,
  nearestContainer: nearestContainer, nearestExit: nearestExit,
  lootContainer: lootContainer, endRaid: endRaid, handleAction: handleAction, reachMap: reachMap, getScreen: function () { return G.screen; },
  get raid() { return G.raid; },
  get pendingLoot() { return G.pendingLoot; },
  confirmLoot: confirmLoot,
  uiHtml: function (name) { return UI[name] ? UI[name](G.base) : ''; },
  get base() { return G.base; },
  get screen() { return G.screen; },
  get cam() { return cam; },
  version: '1.1.0',
  API_VERSION: '1.1.0',
  repairGear: repairGear, repairAll: repairAll, repairCost: repairCost,
  stashToHome: stashToHome, updateSafehouseInteract: updateSafehouseInteract,
  get slotInfo() { return slotInfo; }, setCurSlot: setCurSlot, getCurSlot: getCurSlot,
  getSettings: getSettings, stepSetting: stepSetting, showTipMsg: showTipMsg,
  startBloodMoon: startBloodMoon, bloodMoonAction: bloodMoonAction, get bm() { return G.bm; },
  get sfx() { return SFX; }, get bgmOn() { return SFX.bgmState(); },
  get swing() { return (G.raid && G.raid.p) ? G.raid.p.swing : null; },
  drawHeldWeapon: drawHeldWeapon, craftFx: craftFx
};
Object.assign(API, {
  BLD: BLD,
  buildingAt: buildingAt,
  updateSeen: updateSeen,
  drawMinimap: drawMinimap,
  revealAll: revealAll,
  layoutBuilding: layoutBuilding,
  pickZType: pickZType,
  pickBType: pickBType,
  drawZombieBody: drawZombieBody,
  spawnZombie: spawnZombie,
  hurtZombie: hurtZombie,
  updateZombies: updateZombies,
  hurtPlayer: hurtPlayer,
  ZT: ZT
});

if (typeof window !== 'undefined') { window.GAME = API; window.cam = cam; }

if (typeof document !== 'undefined' && document.getElementById) {
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', boot);
  } else {
    boot();
  }
}

})();
</script>
</body>
</html>
